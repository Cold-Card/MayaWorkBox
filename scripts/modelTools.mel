global proc refreshWin()
{
   string $currentPanel = `getPanel -withFocus`;
   string $panelType = `getPanel -to $currentPanel`;
   int $state = `isolateSelect -q -s $currentPanel`;
   checkBox -e -v $state toggle;
}


/////////////////得到选择物体的最顶层父物体/////////////////////////////////////////
global proc string topParent()
{
  //获得选择物体
  string $sel[] = `ls -sl`;
  //列出父物体全路径名
  string $parent[] = `listRelatives -f -p $sel[0]`;
  string $top;
  //如果选择的是所选物体的最顶层级，则直接归还选择的物体，否则执行下面操作
  if(size($parent)>0)
   {
    string $tops[];
    //提取所选物体全路径名中的最顶层。
    tokenize $parent[0] "|" $tops; // print $tops
    if(size($tops) < 1)
      $top = $sel[0];
    else
      $top = $tops[0];
    return $top;
    }
  else
   return $sel[0];
}

///////////////////////////////测量模型身高/////////////////////////////////////////////////////
global proc string measure_Heights()
{
   //获得所选物体的最顶层组
   string $topObj = topParent();
   //得到物体的轴心位置
   float $pivs[] = `xform -q -ws -piv $topObj`;
   float $piv[];
   //提取轴心位置到$piv中
   $piv[0] = ($pivs[0] + $pivs[3]) / 2.0;
   $piv[1] = ($pivs[1] + $pivs[4]) / 2.0;
   $piv[2] = ($pivs[2] + $pivs[5]) / 2.0;
   
   //创建一个cube，用来做参考
   string $cube[] = `polyCube`;
 
   //连接顶层物体的boundingBox到cube的scale，并移动cube到轴心位置。
   connectAttr ($topObj + ".boundingBox.boundingBoxSize") ($cube[0] + ".scale");
   move -ws $piv[0] $piv[1] $piv[2] $cube[0];

   //提取cube的scaleY值
   string $scaleY = `getAttr ($cube[0] + ".scaleY")`;
   //创建测量工具，设置长度为$scaleY
   string $measures = `distanceDimension -sp 0 0 0 -ep 0 $scaleY 0`;
   //获得测量工具中的locators，并将它们打组到measureTool中
   string $locs[] = `listConnections $measures`;
   string $goupName = `group -n "measureTool" $measures $locs`;
   //删除参考物cube
   delete $cube;
   //返回组名
   return $goupName;
}

////////////////////对齐网格//////////////////////////////////////////
global proc string boundingBox()
{
   string $topObj = topParent();
   select $topObj;
   CenterPivot;

   float $pivs[] = `xform -q -ws -piv $topObj`;
   float $piv[];
   $piv[0] = ($pivs[0] + $pivs[3]) / 2.0;
   $piv[1] = ($pivs[1] + $pivs[4]) / 2.0;
   $piv[2] = ($pivs[2] + $pivs[5]) / 2.0;
   move -ws  (-$piv[0]) (-$piv[1]) (-$piv[2]) $topObj;
   makeIdentity -apply true -t 1 -r 1 -s 1 -n 0;

   string $cube[] = `polyCube`;

   connectAttr ($topObj + ".boundingBox.boundingBoxSize") ($cube[0] + ".scale");
   move -ws 0 $piv[1] 0 $cube[0];

   float $sy = `getAttr ($cube[0] + ".scaleY")`;
   //移动cube到平面上
   xform -ws -piv 0 (-$sy/2) 0 -t 0 ($sy/2) 0 $cube[0];
   CenterPivot $cube;
   select $topObj;
   CenterPivot;
   select -cl;
   return $cube[0];
}
global proc setAxisOrigin()
{
  string $topObj = topParent();
  string $cube = boundingBox();
  pointConstraint $cube $topObj;
  delete $cube;
  xform -ws -piv 0 0 0 $topObj;
  makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 $topObj;
  select $topObj;
}

//////////////////////////////////检查模型对称//////////////////////////////////////////////
global proc string[] abCheckSyms (string $obj, int $axis, float $tol, int $usePiv) 
{
// string $all[] = abCheckSyms("pSphere1", 1, 0.001, 1)
// select $all
   global int $abSymTable[];
   global int $abSymTable[];
   string $aNegVerts[];
   string $aPosVerts[];
   string $aNonSymVerts[];
   string $aStr[];
   string $vtx;
   string $str;
   int $aPosVertsInt[];
   int $aNegVertsInt[];
   int $aInt[];
   int $totVtx;
   int $i;
   int $j;
   int $mAxisInd = $axis - 1; //mirror axis index (for xform)
   int $axis2Ind = ($mAxisInd + 1) % 3;
   int $axis3Ind = ($mAxisInd + 2) % 3;
   int $mod;
   int $prog;
   int $vertCounter = 0;
   float $aNegVertTrans[];
   float $aPosVertTrans[];
   float $aVtxTrans[];
   float $aVtx2Trans[];
   float $bBox[];
   float $mid;
   float $midOffset;
   float $posOffset;
   float $negOffset;
   float $flt;
   float $progNum;
   float $progDenom;
   float $test1;
   float $test2;

   float $midOffsetTol = -.0000001;

   $aVtxTrans = `xform -q -ws -t $obj`;
   $mid = $aVtxTrans[$mAxisInd];
  
   $aInt = `polyEvaluate -v $obj`; 
   $totVtx = $aInt[0];

   waitCursor -state on;
   progressWindow -title "Working" -progress 0 -status "Sorting";
   $progDenom = $totVtx;
   $flt = ceil($progDenom/50);
   $mod = $flt;
   for ($i=0;$i<$totVtx;$i++)
    {
     if (($i % $mod) == 0)
       {
         $progNum = $i;
         $prog = ($progNum/$progDenom)*100.0;
         progressWindow -e -progress $prog;
        } 
     $vtx = $obj+".vtx["+$i+"]";
     $aVtxTrans = `xform -q -ws -translation $vtx`;
     $midOffset = $aVtxTrans[$mAxisInd] - $mid;
     if ($midOffset >= $midOffsetTol)
        {
          $aPosVerts[size($aPosVerts)] = $vtx;
          $aPosVertTrans[size($aPosVertTrans)] = $aVtxTrans[$mAxisInd];
         }
     else
        {
          if ($midOffset < $midOffsetTol)
             {
               $aNegVerts[size($aNegVerts)] = $vtx;
               $aNegVertTrans[size($aNegVertTrans)] = $aVtxTrans[$mAxisInd];
                }
           }
      }

   progressWindow -e -progress 0 -status $str;
   $progDenom = size($aPosVerts);
   $flt = ceil($progDenom/50);
   $mod = $flt;

   for ($i=0;$i<size($aPosVerts);$i++)
     {
       if (($i % $mod) == 0)
        { 
          $progNum = $i;
          $prog = ($progNum/$progDenom)*100.0;
          progressWindow -e -progress $prog;
          }
      $vtx = $aPosVerts[$i];
      $posOffset = ($aPosVertTrans[$i] - $mid);
      if ($posOffset < $tol)
         {
           $aPosVerts[$i] = "m";
           $vertCounter ++;
           continue;
          }
      for ($j=0;$j<size($aNegVerts);$j++)
        {
           if ($aNegVerts[$j] == "m") 
               continue;
           $negOffset = $mid - $aNegVertTrans[$j];
           if ($negOffset < $tol)
            {
               $aNegVerts[$j] = "m";
               $vertCounter ++;
               continue;
              }
           if (abs($posOffset - $negOffset) <= $tol)
            {
              $aVtxTrans = `xform -q -ws -t $vtx`;
              $aVtx2Trans = `xform -q -ws -t $aNegVerts[$j]`;
              $test1 = $aVtxTrans[$axis2Ind] - $aVtx2Trans[$axis2Ind];
              $test2 = $aVtxTrans[$axis3Ind] - $aVtx2Trans[$axis3Ind];
              if (abs($test1) < $tol && abs($test2) < $tol)
               {
                 $aPosVerts[$i] = $aNegVerts[$j] = "m"; //m is for match
                 break;
                }
            }
       }
     }
//now strip out "m" from $aPosVerts and $aNegVerts, and we'll have asymmetry
   $aStr = {"m"};
   $aPosVerts = stringArrayRemove($aStr, $aPosVerts);
   $aNegVerts = stringArrayRemove($aStr, $aNegVerts);
   $aNonSymVerts = stringArrayCatenate($aPosVerts, $aNegVerts);

   progressWindow -endProgress;
   waitCursor -state off;
   return $aNonSymVerts;
}

global proc checkSym()
{
  string $sels[] = `ls -sl`;
  int $Axis = `radioButtonGrp -q -sl axis`;
  float $tol = `floatField -q -v tol`;
  string $asym[] = abCheckSyms($sels[0], $Axis, $tol, 1);
  if(size($asym) > 0)
  {
    selectMode -component;
    select $asym;
    warning "当前模型不是对称的";
    }
  else
   print "当前模型是对称的";
}
///////////////////////////////模型边界显示////////////////////////////////////////////////////
global proc toggleBorder()
{
 string $selection_list[] = `filterExpand -sm 12`;
 if(size($selection_list) > 0)
 {
  string $obj;
  for($obj in $selection_list)
    {
     select $obj;
     int $border[] = `polyOptions -q -db -ao`;
     if($border[0] > 0){
       polyOptions -db 0 -ao;}
     else{
       polyOptions -db 1 -sb 10.0 -ao;}
    }
  select $selection_list;
 }
 
 else{
	 error "no polygonal objects selected";}
}

global proc selectBorder()
{
 if(size(`filterExpand -sm 12`) > 0)
   {
    //convert selection to edges
    PolySelectConvert 2;

    //limit selection to border edges 
    polySelectConstraint -t 0x8000 -m 2 -w 1;

    //store a list of the selected edges
    string $selected_edges[] = `filterExpand -sm 32`;

    //reset selection constraints
    polySelectConstraint -dis; 

    if(size($selected_edges) > 0){
      select $selected_edges;}
   
    else{
      error "selection does not have border edges";}
   }
   
 else{
     error "no polygonal objects selected";}
}
//////////////////////////////////////////////////////////////////////////////////

/////////////////////选择三角面和多边面////////////////////////////////////////////
global proc string[] selectTriss()
{
 string $selection_list[] = `filterExpand -sm 12`;
 string $msg;
 if(size($selection_list) > 0)
   { 
    //apply constraint so that only tris can be selected
    polySelectConstraint -m 3 -t 8 -sz 1;

    //convert selection to faces
    PolySelectConvert 1;

    //store the list of selected faces
    string $selected_faces[] = `filterExpand -sm 34`;
    // select $selected_faces

    //turn off selection constraint
    polySelectConstraint -sz 0; 
 
    if(size($selected_faces) == 0){
      $msg = "no triangles present";
      select $selection_list;}
   
    else{
      select $selected_faces;
      $msg = size($selected_faces) + " triangles present"; 
   } 
}
  
 else{
   $msg = "ERROR: select poly object";}  
 string $allTris[] = `ls -sl`;
 return $allTris;
}
// ls -sl

global proc string[] selectNgonss()
{
 string $selection_list[] = `filterExpand -sm 12`;
 string $msg;
 if(size($selection_list) > 0)
   {
    //apply constraint so that only N-gons can be selected
    polySelectConstraint -m 3 -t 8 -sz 3;

    //convert selection to faces
    PolySelectConvert 1;

    //store the list of selected faces
    string $selected_faces[] = `filterExpand -sm 34`;

    //turn off selection constraint
    polySelectConstraint -sz 0; 

    if(size($selected_faces) == 0){
    $msg = "no n-gons present";
    select $selection_list;}
   
    else{
    select $selected_faces;
    $msg = size($selected_faces) + " n-gons present"; }
   }
   
 else{
   $msg = "ERROR: select poly object";} 
 string $allTris[] = `ls -sl`;
 return $allTris;
}

global proc toggleNormals()
{
 string $selection_list[] = `filterExpand -sm 12`;
 string $msg;
 if(size($selection_list) > 0)
   { 
    string $selection;
    for($selection in $selection_list)
    {
     select $selection;
     int $test[] = `polyOptions -q -ao -dn`;
     if($test[0] > 0){
       polyOptions -ao -dn 0;}
     else{
       string $type = `optionMenu -q -v options`;
       if($type == "face")
         polyOptions -ao -dn 1 -sn (`floatField -q -v length`) -f;
       else
         polyOptions -ao -dn 1 -sn (`floatField -q -v length`) -pt;}
    }
   } 
 else{
   $msg = "ERROR: select poly object";}   
}

global proc normalType()
{
 string $type = `optionMenu -q -v options`;
 if($type == "face"){
   polyOptions -ao -facet;} 
 else{
   polyOptions -ao -pt;} 
}

//////////////////////////////////////////////////////////////////////////////////
global string $selectFaces[];
global proc string[] faces(int $type)
// faces 2
{
  global string $selectFaces[];
  
  if($type == 1)
   {
    $selectFaces = selectTriss();
     if(!`gmatch $selectFaces[0] "*.f*"`)
        print "当前模型没有三角面";
   }
  else
   {
    $selectFaces = selectNgonss();
    if(!`gmatch $selectFaces[0] "*.f*"`)
       print "当前模型没有多边面";
    }
      
  return $selectFaces;
}
//print $selectFaces;

global string $materials[];
global proc deleteMaterial()
{
  global string $selectFaces[];
  global string $materials[];
  string $sels[] = `ls -sl -fl $selectFaces`;
  string $shapes[] = `listRelatives -p $selectFaces[0]`;
  string $des[] = `connectionInfo -destinationFromSource ($shapes[0] + ".instObjGroups[0]") `;
  if(size($shapes[0]) > 0)
 {
  int $checks = `checkBox -q -v maker`;
  
  if($checks == 1)
  {
  string $shade = `shadingNode -asShader lambert`;
  setAttr ($shade + ".color") -type double3 1 0 0;
  string $shadeSG = `sets -renderable true -noSurfaceShader true -empty -name ($shade + "SG")`;
  connectAttr -f ($shade + ".outColor") ($shadeSG + ".surfaceShader");
  sets -e -forceElement $shadeSG $selectFaces;
  $materials = {$shade, $shadeSG};
  }

  if($checks == 0)
   {
    delete $materials; 
    select $shapes[0];
    sets -e -forceElement initialShadingGroup;
   } 
 }   
}
global proc reverseNormal()
{
  string $sels[] = `ls -sl -fl`;
  polyNormal -normalMode 0 -userNormalMode 0 -ch 1 $sels;
}
////////////////////////////////////////////////////////////////////
global proc int[] checkFaces(string $obj)
// checkFaces sparkShape
{
  //string $obj = "sparkShape";
  int $vtxs[] = `polyEvaluate -v`;
  float $thred = `floatSliderGrp -q -v thred`;
  int $closePoint[];
  float $amounts = 0;
  progressWindow
         -title "处理进程"
         -progress $amounts
         -status "处理点的数目"
         -isInterruptable true;

  for($i=0; $i<$vtxs[0]; $i++)
   {

    $amounts += 100/float($vtxs[0]);
    string $point1 = $obj + ".vtx[" + $i + "]";
    float $pos1[] = `xform -q -ws -t $point1`;
    for($j=0; $j<$vtxs[0]; $j++)
      {
       if($i>$j)
         {
         string $point2 = $obj + ".vtx[" + $j + "]";
         float $pos2[] = `xform -q -ws -t $point2`;
         if(abs($pos1[0]-$pos2[0])<=$thred && abs($pos1[1]-$pos2[1])<=$thred && abs($pos1[2]-$pos2[2])<=$thred)
           {
              $closePoint[size($closePoint)] = $i;
              $closePoint[size($closePoint)] = $j;
             }
         }
     }
   if ( `progressWindow -query -isCancelled` ) break;
   progressWindow -edit
            -progress (int($amounts))
           -status ("处理点的数目: "+int($amounts)+"%");
   } 
  progressWindow -endProgress;
  return $closePoint;
}

global proc getVtxs()
{
  string $sels[] = `ls -sl`;
  int $vtxsNum[] = checkFaces($sels[0]);
  string $vtxs[];
  for($vtx in $vtxsNum)
    $vtxs[size($vtxs)] = $vtx;
  $vtxs = stringArrayRemoveDuplicates($vtxs);
  string $vtxObj[];
  for($i in $vtxs)
   $vtxObj[size($vtxObj)] = $sels[0] + ".vtx[" + $i + "]";
  selectMode -component;
  select $vtxObj;
}
global proc getExtrudeFace()
{
string $objs[] = `ls -sl`;
string $shapes[] = `listRelatives -s -type shape -ni $objs[0]`;
string $obj = $shapes[0];
string $finallFaces[];
int $morePts[],$oneSide[],$otherSide[];
string $mores[];
if(`nodeType $obj` == "mesh")
 {
  $morePts = checkFaces($obj);

  for($i=0; $i<size($morePts); $i++)
     if($i % 2 == 0)
       $mores[size($mores)] =$morePts[$i];
// print $mores;
// clear $mores;
  string $edg[] = stringArrayRemoveDuplicates($mores);
  string $parent[] = `listRelatives -p -f $obj`;
  string $edgeFaces[];
  for($i=0; $i<size($edg)-1; $i++)
   {
     if($i % 2 == 0)
      {
       string $index1 = $edg[$i];
       string $index2 = $edg[$i+1];
       string $edge = $parent[0] + ".vtx[" + $index1 + ":" + $index2 + "]";
       $edgeFaces[size($edgeFaces)] = $edge;
      }
   }// print $edgeFaces;
  string $allFaces[];
  for($i=0; $i<size($edgeFaces)-1; $i++)
   {
    if($i % 2 == 0)
     {
      string $edge1 = $edgeFaces[$i];
      string $edge2 = $edgeFaces[$i+1];
      string $faces[] = `polyListComponentConversion -fv -tf -in $edge1 $edge2`;
      $finallFaces[size($finallFaces)] = $faces[0];
     }
   }// print $allFaces;
}
// print $finallFaces;
if(size($finallFaces) > 0)
  select -add $finallFaces;
}

global proc checkVtx()
{
string $sels[] = `ls -sl`;
string $topObj = topParent();
float $thred = `floatSliderGrp -q -v thred`;
string $shapes[];
string $objs[] = `ls -tr -dagObjects $topObj`;
string $mergePts[];
for($obj in $objs)
{
  string $shape[] = `listRelatives -s -f -type shape -ni $obj`;
  if(size($shape) > 0)
  {
    if(`nodeType $shape[0]` == "mesh")
      {
        int $vtxs1[] = `polyEvaluate -v $obj`;
        string $merge[] = `polyMergeVertex -d $thred -am 1 $obj`;
        int $vtxs2[] = `polyEvaluate -v $obj`;
        if($vtxs1[0] != $vtxs2[0])
          $mergePts[size($mergePts)] = $obj;
        delete $merge;
        }
   }
}
if(size($mergePts) > 0)
  {
   select $mergePts;
   warning "当前模型有重合的点";
  }
else
  {
   select -cl;
   print "当前模型没有重合的点";
  }
}
///////////////////////////////////////////////////////////////////////////////////
global proc string[] eyeGroup()
{
 string $topObj = topParent();
 string $allChildren[] = `listRelatives -ad -f $topObj`;
 string $groups[];
 string $match = "eye";
 for($child in $allChildren)
  {
    if(`nodeType $child` == "transform")
      {
        string $lower = tolower($child);
        if(size(`match $match $lower`) > 0)
          {
            string $parent[] = `listRelatives -p -f $child`;
            string $anotherLower = tolower($parent[0]);
            if(size(`match $match $anotherLower`) == 0)
              $groups[size($groups)] = $child;
           }
       }
  }
  if(size($groups) == 1)
     $groups = `listRelatives -c -f $groups[0]`;
 return $groups;
}

global proc checkEye()
{
  string $eyeGroups[] = eyeGroup();
  int $numEyes = size($eyeGroups);
  if($numEyes > 2 || $numEyes == 0)
   warning "当前模型的眼球没有大组，或者是没有给眼睛正确命名为eye形式。";
  else
  {
     string $trueGroup;
     string $sels[] = `ls -l -sl`;
     if(size($sels) > 1)
       warning "请选择一个物体";
     else
      {
        string $alignEye = $sels[0];
        for($group in $eyeGroups)
         {  
           if(size(`match $group $alignEye`) > 0)
           $trueGroup = $group;
          }
        string $temp1[] = {$trueGroup};
        string $temp2[] = stringArrayRemove($temp1, $eyeGroups); 
        string $eyeSel = $temp1[0];
        string $eyeTwo = $temp2[0];

        float $pos1[] = pivTran($eyeSel);
        float $pos2[] = pivTran($eyeTwo);

        float $x = abs($pos1[0]) - abs($pos2[0]);
        float $y = abs($pos1[1]) - abs($pos2[1]);
        float $z = abs($pos1[2]) - abs($pos2[2]);
        if($x != 0 || $y != 0 || $z != 0)
          {
            move -r -ws (-$pos2[0]) (-$pos2[1]) (-$pos2[2]) $eyeTwo;
            makeIdentity -apply true -t 1 -r 1 -s 1 -n 0;
            move -r -ws (-$pos1[0]) ($pos1[1]) ($pos1[2]) $eyeTwo;
            makeIdentity -apply true -t 1 -r 1 -s 1 -n 0;
            print "左右眼已经被对齐";
          }
       }
     }
}

global proc float[] pivTran(string $obj)
{
select $obj;
CenterPivot;
makeIdentity -apply true -t 1 -r 1 -s 1 -n 0;
float $pivs[] = `xform -q -ws -piv $obj`;
float $piv[];
$piv[0] = ($pivs[0] + $pivs[3]) / 2.0;
$piv[1] = ($pivs[1] + $pivs[4]) / 2.0;
$piv[2] = ($pivs[2] + $pivs[5]) / 2.0;
return $piv;
}

/////////////////////////////////////////////////////////////////////
global proc toggleIsolate ()
{
int $isoView;
string $currentPanel = `getPanel -withFocus`;
string $panelType = `getPanel -to $currentPanel`;

if ($panelType ==  "modelPanel") 
  {
    $isoView = (1 - `isolateSelect -q -s $currentPanel`);
    enableIsolateSelect $currentPanel $isoView;
    isolateSelect -state $isoView $currentPanel;   
  }
};

////////////////////////////////////////////////////////////////////
global proc resetTran()
{
  string $objs[] = `ls -tr`;
  string $trans[];
  for($obj in $objs)
  {
    //string $transNode[] = `listRelatives -p -f $obj`;
    makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 $obj;
  }
  print "物体变换已经全部冻结到初始状态";
}

