global proc testPtInfo()
{
    setParent point;
    columnLayout -adj 1;
      separator -h 10 -style "none";
      radioButtonGrp -l "  Selection Type" 
                         -numberOfRadioButtons 2 -labelArray2 "Selected" "All" 
                         -sl 2
                         -cw3 90 70 70 selType;
       separator -h 20 -w 300 -style "in";
       button -l "Get Info" -bgc 0.6 1 0.8 -c "listObjs";
    setParent ..;
}
//////////////////////////////////////////////////////////////////////////

global proc string[] objects()
{
   string $result;
   int $type = `radioButtonGrp -q -sl selType`;

   string $sels[];
   if($type == 1)
     {
       string $selP[] = `ls -sl`;
       if(size($selP)>0)
         {
           for($sel in $selP)
             {
               string $shapes[] = `listRelatives -s -f $sel`;
               if(`nodeType $shapes[0]` == "mesh")
                  $sels[size($sels)] = $shapes[0];
              }
          }
      else
        $result = `confirmDialog -t "警告" -message "请在场景中至少选择一个物体" -button "OK"`;
    }
   float $amounts = 0;
   if($result != "OK")
     {
       progressWindow
            -title "处理进程"
            -progress $amounts
            -status "处理点的数目"
            -isInterruptable true;
     }
   if($type == 2)
       $sels = `ls -v -l -type "mesh"`; 
   string $quesObj[];
   for($sel in $sels)
    {
       $amounts += 100/float(size($sels));
        string $trueShape = getShape($sel);
        if(size($trueShape) > 0)
           {
              int $verts[] = `polyEvaluate -v $trueShape`;
              for($i=0; $i<$verts[0]; $i++)
                {
                  string $check[];
                  $j = ceil(rand($verts[0]));
                  //$j = $i;
                  float $pnx = `getAttr ($sel + ".pnts[" + $j + "].pntx")`;
                  float $pny = `getAttr ($sel + ".pnts[" + $j + "].pnty")`;
                  float $pnz = `getAttr ($sel + ".pnts[" + $j + "].pntz")`; 
                  float $pre = 0.00001;
                  if(($pnx < 0 - $pre||$pnx > 0 + $pre) || ($pny < 0 - $pre||$pny > 0 + $pre) || ($pnz < 0 - $pre||$pnz > 0 + $pre))
                    {
                      string $parent[] = `listRelatives -allParents -f $sel`;
                      $check[size($check)] = $parent[0];
                      $quesObj[size($quesObj)] = $parent[0];
                     }
                 if(size($check) > 0)
                   {
                     clear $check;
                     break;
                   }
                }
            if ( `progressWindow -query -isCancelled` ) break;
            progressWindow -edit
                 -progress (int($amounts))
                 -status ("处理点的数目: "+int($amounts)+"%");
         }
     }
   progressWindow -endProgress;
   $quesObj[size($quesObj)] = $result;
   return $quesObj;
}

///////////////////////////////////////////////////////////////////////////////////////////////////
global proc listObjs()
{
   string $objs[] = objects();
   int $num = size($objs)-1;
   if(size($objs)-1 > 0)
     {
       string $prompt = `confirmDialog 
                            -title "警告" 
                            -message ("检测到 "+ $num + " 个点信息没有清零的模型,\n单击\"确定\"打开没有清零模型列表") 
                            -button "确定"
                            -button "取消"
                            -dismissString "取消"`;
     if($prompt == "确定")
       {
           if(`window -ex listObjects`)  
              deleteUI listObjects;
              window -t "物体列表" -wh 320 160 listObjects;
               formLayout form;
                text -l "  下列物体点位置没有清零：" -align "left" text;
                separator -h 5 -style "none" sep;
                textScrollList -h 100 -ams 1 textObj;
		button -l "点信息归零" -bgc 1 0 0 -c "resetCommand"  button ;
 		formLayout -e
		-af text top 0
		-af text left 0
		-af text right 0

		-ac sep top 2 text
		-af sep right 0
		-af sep left 0

		-ac textObj top 2 sep
		-af textObj right 0
		-af textObj left 0
		-ac textObj bottom 2 button

		-af button right 0
		-af button left 0
		-af button bottom 2
		form;

                for($obj in $objs)
                   textScrollList -e -a $obj textObj;
              showWindow listObjects;
              textScrollList -e -sc "items 1" -dcc "textScrollList -e -da textObj" textObj;

         }
      }
   else
      if($objs[size($objs)-1] != "OK")
           confirmDialog -t "恭喜" -message "测试完毕，当前模型物体点信息已清零" -button "OK";
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc items(int $type)
{
   select -cl;
   string $selItems[] = `textScrollList -q -si textObj`;
   if($type == 1)
     for($sel in $selItems)
       select -add $sel;
   if($type == 2)
     textScrollList -e -ri $selItems[0] textObj;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc string getShape(string $shape)
{
	string $parents[] = `listRelatives -p -f $shape`;
	string $shapes[] = `listRelatives -s -f -type shape -ni $parents[0]`;
	if($shapes[0] == $shape)
 	   return $shape;
	else
  	   return "";
}
///////////////////////////////////////////////////////////////////////////////////////////////
global proc resetCommand()
{
  string $items[]; 
  $items = `textScrollList -q -si textObj`;
  if(size($items) == 0)
    $items = `textScrollList -q -ai textObj`;

   float $amounts = 0;
   progressWindow
          -title "点信息归零进程"
          -progress $amounts
          -status "物体点信息归零处理进程"
          -isInterruptable true;
  //float $start = `timerX`;
  for($item in $items) 
   {
    $amounts += 100/float(size($items));
    resetPosition $item;
    if ( `progressWindow -query -isCancelled` ) break;
    progressWindow -edit
              -progress (int($amounts))
              -status ("物体点信息归零处理进程: "+int($amounts)+"%");
    textScrollList -e -ri $item textObj;
    }
  progressWindow -endProgress;
  //float $end = `timerX -startTime $start`;
  $items = `textScrollList -q -ai textObj`;
  if(size($items) == 0)
    deleteUI listObjects;
  print "所选物体的点信息已经归零";
  //print $end;
}
global proc resetPosition(string $item)
{
     string $normal1[] = `polyNormal -normalMode 0 $item`;
     string $normal2[] = `polyNormal -normalMode 0 $item`;
     delete $normal1[0];
     delete $normal2[0];
     select $item;
    DeleteHistory;
}
///////////////////////////////////////////////////////////////////////////////////////////////
global proc deleteLayer()
{
 string $layers[] = `ls -type displayLayer`;
 string $renderLayer[] = `ls -type renderLayer`;
 string $default[] = {"defaultLayer"};
 string $defaultRender[] = {"defaultRenderLayer"};
 $layers = stringArrayRemove($default, $layers);
 $renderLayer = stringArrayRemove($defaultRender, $renderLayer);
 $layers = stringArrayCatenate($layers, $renderLayer);
 if(size($layers) > 0)
  {
    delete $layers;
    print "层已经清除完成";
   }
 else
   print "没有层要清除";
}

global proc deleteMat()
{
  string $texs[] = `ls -tex`;
  string $places[];
  string $allM[];
  for($tex in $texs)
   {
    string $cons[] = `listConnections -s 1 -d 0 $tex`; 
    for($con in $cons)
      $places[size($places)] = $con;
   }
  $places = stringArrayRemoveDuplicates($places);

  string $mats[] = `ls -mat`;
  string $existsMats[] = {"lambert1","particleCloud1"};
  $mats = stringArrayRemove($existsMats, $mats);

  $allM = stringArrayCatenate($places, $mats);

  string $shades[] = `listSets -type 1`;
  string $existShade[] = {"initialShadingGroup","initialParticleSE"};
  $shades = stringArrayRemove($existShade, $shades);

  $allM = stringArrayCatenate($allM, $shades);

  string $lights[] = `ls -lights`;
  for($light in $lights)
   {
     string $parent[] = `listRelatives -p $light`;
     $allM[size($allM)] = $parent[0];
   }
  $allM = stringArrayCatenate($texs, $allM);
  if(size($allM) > 0)
    {
     delete $allM;
     print "多余的材质节点已经被清除";
     }
  else
    print "场景中没有多余的材质节点被清除";
}

global proc deleteNullGroup()
{
 // string $intermediateObject[] = `ls -geometry -io`;
//  if(size($intermediateObject) > 0)
//    delete $intermediateObject;
  deleteEmptyGroups();
}
modelTools();
