// ============================================================
// 构建控制点位置、缩放值、左右半径数组
// ============================================================
int $numPoints = size($all_point_u_num_0);  // 11

float $ctrlPositions[] = $all_point_u_num_0;
float $ctrlScales[] = $all_curve_rote_num_0;

// 左半径和右半径分别存储
float $ctrlLeftRadii[];
float $ctrlRightRadii[];

for ($i = 0; $i < $numPoints; $i++) {
    float $leftR = 0.0;
    float $rightR = 0.0;
    if ($i == 0) {
        // 第一个控制点：只有右侧半径（使用区间0的第一个smooth，索引1）
        $rightR = $all_curve_smooth_num_0[1];
    } else if ($i == $numPoints - 1) {
        // 最后一个控制点：只有左侧半径（使用区间9的第二个smooth，索引29）
        $leftR = $all_curve_smooth_num_0[29];
    } else {
        // 内部控制点：左侧半径 = 左区间（i-1）的第二个smooth，右侧半径 = 右区间（i）的第一个smooth
        $leftR = $all_curve_smooth_num_0[($i-1)*3 + 2];
        $rightR = $all_curve_smooth_num_0[$i*3 + 1];
    }
    $ctrlLeftRadii[$i] = $leftR;
    $ctrlRightRadii[$i] = $rightR;
}

// ============================================================
// 计算叠加缩放值的函数（默认输出为1）
// ============================================================
global proc float computeScale(float $u, float $positions[], float $scales[], float $leftRadii[], float $rightRadii[]) {
    float $total = 1.0;
    int $count = size($positions);
    for ($i = 0; $i < $count; $i++) {
        float $dist = $u - $positions[$i];
        float $weight = 0.0;
        
        if ($dist == 0.0) {
            $weight = 1.0;
        } else if ($dist < 0) {
            // 左侧衰减（使用左半径）
            float $r = $leftRadii[$i];
            if ($r > 0 && -$dist < $r) {
                float $t = (-$dist) / $r;   // 归一化距离 (0~1)
                // 三次平滑步进（从1衰减到0）
                float $k = 1.0 - $t;
                $weight = $k * $k * (3.0 - 2.0 * $k);
            }
        } else {
            // 右侧衰减（使用右半径）
            float $r = $rightRadii[$i];
            if ($r > 0 && $dist < $r) {
                float $t = $dist / $r;      // 归一化距离 (0~1)
                // 三次平滑步进（从1衰减到0）
                float $k = 1.0 - $t;
                $weight = $k * $k * (3.0 - 2.0 * $k);
            }
        }
        // 贡献累加
        $total += ($scales[$i] - 1.0) * $weight;
    }
    return $total;
}

