//==============UI=================//

global proc RiggingHelper_UI (){

string $version="V2.5.0";
string $date="20210210";

global int $asInitialState,$asSetPreColors,$asMenuToolVis,$asColorIndex,$asViewport,$asOutliner;
global float $asPreDiameter;
global string $asScriptRoute;
int $conWorkspace;

$asScriptRoute="/home/wangruilong/maya/workBox/scripts/RiggingHelper/";
string $files=$asScriptRoute+"ControllerFiles";
string $ListShape[]=`getFileList -fld $files -fs "*.cs"`;

if(!$asPreDiameter)
	$asPreDiameter=1;
if(!$asColorIndex)
	$asColorIndex=1;
	
//asRunProgram "Program";
source "/home/wangruilong/maya/workBox/scripts/RiggingHelper/Tools/Program.mel";
if(!$asInitialState){
	$asInitialState=1;
	$asViewport=1;
	print "||  绑定师助手主程序已完成运行。\n";
}
/*
int $asControllerDocking=`optionVar -q asControllerDocking`;
if (`exists dockControl`)
	if (!`optionVar -ex asControllerDocking`)
		$asControllerDocking=0;

if (`exists workspaceControl`)
	if (`workspaceControl -q -ex RiggingHelperWorkspace`){
		if (`formLayout -q -ex asFrame`)
			deleteUI -control asFrame;
		setParent RiggingHelperWorkspace;
		$conWorkspace=1;
	}

if (`exists dockControl`)
	if (`dockControl -q -ex RiggingHelperDock`)
		deleteUI -control RiggingHelperDock;
		*/
		
string $help = "https://www.bilibili.com/video/BV1uv411v7MY?share_source=copy_web";

if(`window -ex RiggingHelperWin`)
	deleteUI  -window RiggingHelperWin;
	
string $iconsName = $asScriptRoute+"Icons/icos.png";
if (!$conWorkspace)
	window -title "绑定师助手" RiggingHelperWin;

//==========标头栏===========//

formLayout -p "RiggingHelperWin" -bgc 0.16 0.16 0.16 -nbg 0 asFrame;

columnLayout -bgc 0.725 0.725 0.725 -adj 1 asHeader;

string $asImage=$asScriptRoute+"Icons/asButton.png";

iconTextButton -w 346 -h 28 -i $asImage -c "asWindowHideToggle 1" -dcc "asHelp sg_Scroll_RiggingHelperHelp" asHelpImage;
	popupMenu ;
		radioMenuItemCollection;
		menuItem -l "显示全部" -rb on -c "asWindowHideToggle 3" asMenuItem_all;
		menuItem -l "仅显示功能栏" -rb off -c "asWindowHideToggle 1" asMenuItem_up;
		menuItem -l "仅显示控制器" -rb off -c "asWindowHideToggle 2" asMenuItem_dn;
		menuItem -divider true -dividerLabel "";
		menuItem -label "显示底部工具条" -checkBox off -c "gtLowToolBar" asLowToolBar;
		menuItem -divider true -dividerLabel "";
		menuItem -to 1 -i "iconSuper.png" -subMenu true -label "图标大小";
			radioMenuItemCollection;
			menuItem -l "小号图标-点击后刷新窗口" -rb off -c "gtIconSize 34" asMimIco_1;
			menuItem -l "中号图标-点击后刷新窗口" -rb on -c "gtIconSize 48" asMimIco_2;
			menuItem -l "大号图标-点击后刷新窗口" -rb off -c "gtIconSize 64" asMimIco_3;
		setParent -menu ..;

		if(`asMayaVersionAsFloat`>2016){
			menuItem -divider true -dividerLabel "";
			menuItem -i "enabled.png" -l "退出" -c "gtCloseWindow";
		}
setParent..;

//==========区域一===========//
paneLayout -cn "horizontal2" asPaneLayout;

formLayout -vis 0 asFrame_a;
formLayout asOption;

formLayout -bgc 0.16 0.16 0.16 asMenu;

iconTextButton -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu_1"` -c "asMenuUI 1" -ann "创建控制器" asMenu_1;
iconTextButton -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu_2"` -c "asMenuUI 2" -ann "调整曲线" asMenu_2;
iconTextButton -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu_3"` -c "asMenuUI 3" -ann "重命名" asMenu_3;
iconTextButton -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu_4"` -c "asMenuUI 4" -ann "属性管理" asMenu_4;
iconTextButton -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu_5"` -c "asMenuUI 5" -ann "多功能工具箱" asMenu_5;
iconTextButton -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu_6"` -c "asMenuUI 6" -ann "关于插件" asMenu_6;
iconTextButton -h 12 -w 34 -i `Icons "asButtonUP"` asMenu_7;
iconTextButton -h 12 -w 34 -i `Icons "asButtonDN"` asMenu_8;

setParent..;

formLayout -e

	-attachNone asMenu_1 "top" 
	-attachForm asMenu_1 "left" 0
	-attachPosition asMenu_1 "right" 0 15
	-attachNone asMenu_1 "bottom" 

	-attachNone asMenu_2 "top" 
	-attachPosition asMenu_2 "left" 0 15
	-attachPosition asMenu_2 "right" 0 30
	-attachNone asMenu_2 "bottom" 

	-attachNone asMenu_3 "top" 
	-attachPosition asMenu_3 "left" 0 30
	-attachPosition asMenu_3 "right" 0 45
	-attachNone asMenu_3 "bottom" 

	-attachNone asMenu_4 "top" 
	-attachPosition asMenu_4 "left" 0 45
	-attachPosition asMenu_4 "right" 0 60
	-attachNone asMenu_4 "bottom" 

	-attachNone asMenu_5 "top" 
	-attachPosition asMenu_5 "left" 0 60
	-attachPosition asMenu_5 "right" 0 75
	-attachNone asMenu_5 "bottom" 

	-attachNone asMenu_6 "top" 
	-attachPosition asMenu_6 "left" 0 75
	-attachPosition asMenu_6 "right" 0 90
	-attachNone asMenu_6 "bottom" 

	-attachForm asMenu_7 "top" 1
	-attachPosition asMenu_7 "left" 0 90
	-attachForm asMenu_7 "right" 0
	-attachNone asMenu_7 "bottom" 

	-attachControl asMenu_8 "top" 1 asMenu_7
	-attachPosition asMenu_8 "left" 0 90
	-attachForm asMenu_8 "right" 0
	-attachNone asMenu_8 "bottom" 

    asMenu;

scrollLayout -cr 1 asFunction;

///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222

	columnLayout -adj 1 -vis 0 asColumnLayout_1;

	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "创建控制器连接" asFly_11;

	columnLayout -adj 1 ;

	string $visTextNewName_0="textFieldGrp -e -vis 0 asTextNewName ;";
	string $visTextNewName_1="textFieldGrp -e -vis 1 asTextNewName ;";

	string $visCon_RT_0="checkBoxGrp -e -vis 0 asCon_PTRS ;";
	string $visCon_RT_1="checkBoxGrp -e -vis 1 asCon_PTRS ;";	

	string $visLin_RT_0="checkBoxGrp -e -vis 0 asLin_ATRS ;";
	string $visLin_RT_1="checkBoxGrp -e -vis 1 asLin_ATRS ;";	

	string $visAxi_RT_0="checkBoxGrp -e -vis 0 asAxi_ATRS ;";
	string $visAxi_RT_1="checkBoxGrp -e -vis 1 asAxi_ATRS ;";

	radioButtonGrp -cw3 65 70 70 -numberOfRadioButtons 2 -on1 $visTextNewName_0 -on2 $visTextNewName_1 -label "控制名称：" -la2 "默认" "重命名" -sl 1 asConNameA;	
	textFieldGrp -adj 1 -vis 0 -ed 1  asTextNewName ;
	separator -h 5;
	checkBoxGrp -cw3 65 70 70 -ncb 2 -l "创建模式：" -la2 "FK模式" "子级模式" -v1 1 -v2 0 asCreateMode;
	separator -h 5;
	radioButtonGrp -cw4 65 55 55 55 -numberOfRadioButtons 3  -label "控制类型：" -la3 "曲线" "曲面" "定位器" -sl 1 asConType;
	separator -h 5;
	radioButtonGrp -cw5 65 55 55 55 55 -numberOfRadioButtons 4  -label "绑定方式：" -la4 "父级" "约束" "连接" "Shapes" -sl 2 
				  -on1 ($visCon_RT_0 + $visLin_RT_0 + $visAxi_RT_0)
				  -on2 ($visCon_RT_1 + $visLin_RT_0 + $visAxi_RT_0)
				  -on3 ($visCon_RT_0 + $visLin_RT_1 + $visAxi_RT_1)
				  -on4 ($visCon_RT_0 + $visLin_RT_0 + $visAxi_RT_0)
				  asConnection;	

	separator -vis 0 -h 5 ;

	string $vCon_P="checkBoxGrp -e -v1 0 asCon_PTRS ;";

	string $vCon_TR="checkBoxGrp -e -v2 0 -v3 0 asCon_PTRS ;";

	checkBoxGrp -vis 1 -cw5 65 55 55 55 55 -ncb 4 -l "约束类型：" -la4 "父子" "位置" "旋转" "缩放" -v1 1 -v2 0 -v3 0 -v4 0 
				-on1 $vCon_TR 
				-on2 $vCon_P 
				-on3 $vCon_P 
				asCon_PTRS;

	string $vLin_A_0="checkBoxGrp -e -v1 0 asLin_ATRS ;";

	string $vLin_TRS_0="checkBoxGrp -e -v2 0 -v3 0 -v4 0 asLin_ATRS ;";
	string $vLin_TRS_1="checkBoxGrp -e -v2 1 -v3 1 -v4 1 asLin_ATRS ;";

	checkBoxGrp -vis 0 -cw5 65 55 55 55 55 -ncb 4 -l "连接属性：" -la4 "全部" "位置" "旋转" "缩放" -v1 1 -v2 1 -v3 1 -v4 1
				-on1 $vLin_TRS_1 -of1 $vLin_TRS_0
				-of2 $vLin_A_0
				-of3 $vLin_A_0
				-of4 $vLin_A_0
				asLin_ATRS;

	string $vAxi_A_0="checkBoxGrp -e -v1 0 asAxi_ATRS ;";

	string $vAxi_TRS_0="checkBoxGrp -e -v2 0 -v3 0 -v4 0 asAxi_ATRS ;";
	string $vAxi_TRS_1="checkBoxGrp -e -v2 1 -v3 1 -v4 1 asAxi_ATRS ;";

	checkBoxGrp -vis 0 -cw5 65 55 55 55 55 -ncb 4 -l "连接轴向：" -la4 "全部" "X" "Y" "Z" -v1 1 -v2 1 -v3 1 -v4 1
				-on1 $vAxi_TRS_1 -of1 $vAxi_TRS_0
				-of2 $vAxi_A_0
				-of3 $vAxi_A_0
				-of4 $vAxi_A_0
				asAxi_ATRS;

	separator -h 5;
	rowLayout -adj 1 -nc 2 -cw2 1 28;
		button -h 30 -l "创建控制器" -c sg_RunAddController ;
		iconTextButton  -i `Icons "asHelp"` -c "asHelp sg_Fixed_CreateController";
	setParent..;
	setParent..;
	setParent..;

/////
	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "创建次级控制器" asFly_12;

	formLayout asSecondary;

		textFieldButtonGrp -adj 2 -cw3 65 1 65 -l "目标模型：" -tx "" -bl "   载  入   " -bc sg_LoadTargetModel asTextTargetModel;

		textFieldButtonGrp -adj 2 -cw3 65 1 65 -l "总控制器：" -tx "" -bl "   载  入   " -bc sg_LoadRootController asTextRootController;

		textScrollList -h 125 -a "请载入控制对象！！！" -sc "sg_SearchAttr_In" asTextControlObject;
		button -h 125 -l "   载  入   " -c "sg_LoadControlObject" asSecondaryBut;

		separator -h 1 asSecondarySep;
	rowLayout -adj 1 -nc 2 -cw2 1 10 asSecondaryButB;
		button -h 30 -l "创建跟随毛囊次级" -c sg_CreateSecondaryControlBinding ;
		iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Scroll_SecondaryController";
	setParent..;
	setParent..;

	formLayout -e

	-attachForm asTextTargetModel "top" 0
	-attachForm asTextTargetModel "left" 0
	-attachForm asTextTargetModel "right" 1
	-attachNone asTextTargetModel "bottom" 	

	-attachControl asTextRootController "top" 0 asTextTargetModel
	-attachForm asTextRootController "left" 0
	-attachForm asTextRootController "right" 1
	-attachNone asTextRootController "bottom" 	

	-attachControl asTextControlObject "top" 1 asTextRootController
	-attachForm asTextControlObject "left" 5
	-attachControl asTextControlObject "right" 2 asSecondaryBut
	-attachNone asTextControlObject "bottom" 	

	-attachControl asSecondaryBut "top" 1 asTextRootController
	-attachNone asSecondaryBut "left" 
	-attachForm asSecondaryBut "right" 6
	-attachNone asSecondaryBut "bottom" 		

	-attachControl asSecondarySep "top" 2 asSecondaryBut
	-attachForm asSecondarySep "left" 0
	-attachForm asSecondarySep "right" 0
	-attachNone asSecondarySep "bottom"

	-attachControl asSecondaryButB "top" 1 asSecondarySep
	-attachForm asSecondaryButB "left" 0
	-attachForm asSecondaryButB "right" 0
	-attachForm asSecondaryButB "bottom" 3

	asSecondary;

	setParent..;
//////////////////66666666666666666666666666666666666
	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "创建颈椎控制器" asFly_13;
		columnLayout -adj 1 ;

			textFieldButtonGrp -adj 2 -cw3 65 1 65 -l "切换控制：" -tx "" -bl "   载  入   " -bc "sg_LoadCerController" asCerController;
			intFieldGrp -adj 2 -cw2 65 1 -l "关节数量：" -nf 1 -v1 10 asCerNumber ;
			textFieldGrp -adj 2 -cw2 65 1 -ed 1 -l "控制名称：" -tx "name" asCerName;
			separator -h 5;
			rowLayout -adj 1 -nc 2 -cw2 1 28;	
				button -h 30 -l "选择颈椎曲线创建" -c sg_CervicalVertebra ;
				iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Scroll_CervicalVertebra";
			setParent..;
		setParent..;
	setParent..;
//////////////////66666666666666666666666666666666666

	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "创建IKFK控制器" asFly_14;
		columnLayout -adj 1 ;

	string $asCreateBut_0="button -e -vis 0 asTwistBut;";
	string $asCreateBut_1="button -e -vis 1 asTwistBut;";

		textFieldButtonGrp -adj 2 -cw3 65 1 65 -l "起始关节：" -tx "" -bl "   载  入   " -bc sg_LoadStartJoint asStartJoint;
		textFieldButtonGrp -adj 2 -cw3 65 1 65 -l "尾部关节：" -tx "" -bl "   载  入   " -bc sg_LoadEndingJoint asEndingJoint;
		textFieldButtonGrp -adj 2 -cw3 65 1 65 -l "切换控制：" -tx "" -bl "   载  入   " -bc sg_LoadController asIKFKController;
		textFieldGrp -adj 2 -cw2 65 1 -ed 1 -l "控制名称：" -tx "name" asIKFKConName;
		checkBoxGrp -cw4 65 75 75 80 -l "功能选项："  -ncb 3 -la3 "IK拉伸" "软修改" "无缝切换" -v1 0 -v2 0 -v3 0 -ann "使用说明：\nIK拉伸勾选就可以创建。\n软修改需要添加属性值创建。\n无缝切换同时支持引入文件模式。"
					-of2 $asCreateBut_0 -on2 $asCreateBut_1	asFunctionOnoff;	

		button -vis 0 -l "关节添加或删除“Twist”属性" -c sg_InsertTwistAttrIKFK asTwistBut;

		separator -h 5;
		rowLayout -adj 1 -nc 2 -cw2 1 28;	
			button -h 30 -l "创建IKFK控制器" -c sg_CreateIKFK ;
			iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Fixed_CreateIKFK";
		setParent..;
		setParent..;
	setParent..;

//////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////

	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "绳子飘带绑定工具" asFly_15;
		columnLayout -adj 1 ;

		textFieldGrp -adj 2 -cw2 65 1 -l "创建名称："  -tx "name" asEstablishNames ;

		intFieldGrp -adj 2 -cw2 65 1 -l "关节数量：" -nf 1 -v1 26 asJointNumber ;

		intFieldGrp  -adj 2 -cw2 65 1 -l "旋转控制：" -nf 1 -v1 6 -vis 1 asControllerAmount ;

		separator -h 5;
	rowLayout -adj 1 -nc 2 -cw2 1 28;
		button -h 30 -l "选择一条曲线创建" -c sg_RopeRigTool ;
		iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Fixed_CurvesCreatingJoints";
	setParent..;
		setParent..;	
	setParent..;	
/////
	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "特殊控制器创建" asFly_16;
		columnLayout -adj 1 ;
			rowLayout -adj 1 -nc 2 -cw2 1 28;
				button -h 30 -l "曲线CV点创建控制器" -c sg_CurveControllerTool ;
				iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Fixed_CurveCreationController";
			setParent..;
		if(`asMayaVersionAsFloat`>2016){
			rowLayout -adj 1 -nc 2 -cw2 1 28;
				button -h 30 -l "创建世界空间次级" -c sg_CreateSecondaryControlBinding_world ;
				iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Fixed_WorldSpaceSecondary";
			setParent..;
		}
			rowLayout -adj 1 -nc 2 -cw2 1 28;
				button -h 30 -l "添加枢轴定位器" -c sg_AddMovePivot ;
				iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Fixed_AddMovePivot";
			setParent..;
			rowLayout -adj 1 -nc 2 -cw2 1 28;
				button -h 30 -l "创建毛囊控制器" -c sg_AddFollicleCon ;
				iconTextButton -i `Icons "asHelp"` -c "asHelp sg_Fixed_AddFollicleCon";
			setParent..;
		setParent..;
	setParent..;	
	text -h 100 -l "";
	setParent..;

///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222
///////////////////////////////////////////////////////222222222222222222222222222222222

	columnLayout -adj 1 -vis 0 asColumnLayout_2;

	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "复制控制器" asFly_21;
		columnLayout -adj 1;
			text -bgc 0.216 0.216 0.216 -h 25 -l "" asTextCopyNurbs;
			text -h 3 -l "" ;
			formLayout  asCopyNurbsFLT;
				button -l "复制形态" -c "sg_LoadCopyNurbs" asCopyNurbs;
				button -l "粘贴形态" -c "sg_PasteNurbs" asPasteNurbs;
			setParent..;
		setParent..;
	formLayout -e

	-attachNone asCopyNurbs "top"
	-attachForm asCopyNurbs "left" 0
	-attachPosition asCopyNurbs "right" 1 50
	-attachNone asCopyNurbs "bottom" 	

	-attachNone asPasteNurbs "top"
	-attachControl asPasteNurbs "left" 1 asCopyNurbs
	-attachForm asPasteNurbs "right" 0
	-attachNone asPasteNurbs "bottom" 	

	asCopyNurbsFLT;		

	setParent..;
	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "缩放控制器" asFly_22;
		columnLayout -adj 1;

	string $visSXYZ_0="checkBoxGrp -e -vis 0 asSXYZ ;" ;
	string $visSXYZ_1="checkBoxGrp -e -vis 1 asSXYZ ;" ; 

	string $visSXYZColor_0="rowLayout -e -vis 0 asSXYZColor ;" ;
	string $visSXYZColor_1="rowLayout -e -vis 1 asSXYZColor ;" ; 

		rowLayout -adj 1 -nc 2 ;
			floatSliderGrp -adj 3 -cw3 64 55 1 -l "缩放比例："  -min 0.001 -max 2 -f 1 -v 0.1 -fmn 0.001 -fmx 5 -pre 3 asProportion;
			checkBox -l "单轴缩放" -onc ($visSXYZ_1 + $visSXYZColor_1) -ofc ($visSXYZ_0 + $visSXYZColor_0) -v 0 asUniaxialScaling;
		setParent..;

	checkBoxGrp -h 18 -vis 0 -cw4 65 60 60 60 -ncb 3 -l "缩放轴向：" -la3 "SX" "SY" "SZ" -v1 0 -v2 0 -v3 0 asSXYZ;
		rowLayout -h 3 -vis 0 -nc 4 -cw4 65 60 60 60 asSXYZColor;
			text -l "";
			iconTextButton -w 13 -bgc 1 0 0;
			iconTextButton -w 13 -bgc 0 1 0;
			iconTextButton -w 13 -bgc 0 0 1;
		setParent..;	

	text -h 5 -l "";
	formLayout  asZoomFLT;
		button -l "放   大" -c "sg_ScaleController 1" asZoomButton_A;
		button -l "缩   小" -c "sg_ScaleController 0" asZoomButton_B;
	setParent..;

	formLayout -e

	-attachNone asZoomButton_A "top"
	-attachForm asZoomButton_A "left" 0
	-attachPosition asZoomButton_A "right" 1 50
	-attachNone asZoomButton_A "bottom" 	

	-attachNone asZoomButton_B "top"
	-attachControl asZoomButton_B "left" 1 asZoomButton_A
	-attachForm asZoomButton_B "right" 0
	-attachNone asZoomButton_B "bottom" 	

	asZoomFLT;

	setParent..;
	setParent..;

	frameLayout -bgc 0.365 0.365 0.365 -mh 5 -cll 1 -cl 1 -cc gtFLT -ec gtFLT -l "旋转控制器" asFly_23;
	columnLayout -adj 1;
		rowLayout -adj 2 -nc 2 -cw2 220 50 ;
		columnLayout -adj 1;
		checkBoxGrp -h 18 -vis 1 -cw4 63 50 50 50 -ncb 3 -l "旋转轴向：" -la3 "RX" "RY" "RZ" -v1 0 -v2 0 -v3 0 asRXYZ;

		rowLayout -h 3 -nc 4 -cw4 63 50 50 50 ;
			text -l "";
			iconTextButton -w 13 -bgc 1 0 0;
	  		iconTextButton -w 13 -bgc 0 1 0;
			iconTextButton -w 13 -bgc 0 0 1;
		setParent..;
		setParent..;	
		button -l "默认值" -c "checkBoxGrp -e -v1 0 -v2 0 -v3 0 asRXYZ;floatSliderGrp -e -v 90 asAngle";
		setParent..;

	text -h 2 -l "";
	floatSliderGrp -adj 3 -cw3 65 55 1 -l "旋转角度：" -f 1 -min 0 -max 360 -step 0.001 -v 90 asAngle ;
	popupMenu;
		menuItem -l "15" -c "floatSliderGrp -e -v 15 asAngle;";
		menuItem -l "45" -c "floatSliderGrp -e -v 45 asAngle;";
		menuItem -l "90" -c "floatSliderGrp -e -v 90 asAngle;";
		menuItem -l "-45" -c "floatSliderGrp -e -v -45 asAngle;";
		menuItem -l "-15" -c "floatSliderGrp -e -v -15 asAngle;";

	text -h 5 -l "";
	formLayout  asRotateFLT;
		button -l "正向旋转" -c "sg_RotateController 1" asRotateButton_A;
		button -l "反向旋转" -c "sg_RotateController 0" asRotateButton_B;
