//==========参考图标===========//

formLayout -vis 0 asFrame_b;

columnLayout -adj 1 asReferimege;

	string $PreIcon=`optionVar -q asPreIcon`;
		if (!`optionVar -ex asPreIcon`)
			$PreIcon="C00";

	string $PreImage = $files+"/"+$PreIcon+".bmp";
	iconTextButton -w 64 -h 64 -iol $PreIcon -i $PreImage -c ("sg_SelectObj "+$PreIcon) -dcc ("sg_CreateController_Position "+$PreIcon) -mw 0 -mh 0 asIcoImege_but;

setParent..;

//==========参考区域===========//

columnLayout -adj 1 asRefer;
	separator -h 1 ;
	string  $floatV="";
			$floatV+="float $Diameter=`floatSliderGrp -q -v asPreRadius`;";
			$floatV+="$asPreDiameter=$Diameter";

	floatSliderGrp -adj 3 -cw2 65 1 -f 1 -min 0.01 -max 100 -step 0.01 -v $asPreDiameter -cc $floatV asPreRadius ;
	popupMenu;
		menuItem -l "0.25" -c "floatSliderGrp -e -v 0.25 asPreRadius;";
		menuItem -l "0.5" -c "floatSliderGrp -e -v 0.5 asPreRadius;";
		menuItem -l "0.75" -c "floatSliderGrp -e -v 0.75 asPreRadius;";
		menuItem -l "1" -c "floatSliderGrp -e -v 1 asPreRadius;";
		menuItem -l "5" -c "floatSliderGrp -e -v 5 asPreRadius;";
		menuItem -l "10" -c "floatSliderGrp -e -v 10 asPreRadius;";
		menuItem -l "20" -c "floatSliderGrp -e -v 20 asPreRadius;";

	float $colorRGB[]=`gtGetColors`;
	colorSliderGrp -vis 0 -adj 2 -cw2 65 1 -rgb $colorRGB[0] $colorRGB[1] $colorRGB[2] -cc "sg_CustomColorChange 1" asColor_Slider;
	string $ColorIndex="";
		   $ColorIndex+="int $value=`colorIndexSliderGrp -q -value asColor_Index`;";
		   $ColorIndex+="$asColorIndex=$value;";
		   $ColorIndex+="sg_SetColorBut;";
	colorIndexSliderGrp -vis 0 -adj 2 -cw2 65 1 -min 1 -max 32 -value $asColorIndex -cc $ColorIndex asColor_Index ;
	separator -h 1 ;
	setParent..;

	string $ColorSetting="";
		   $ColorSetting+="int $vis_1=`checkBoxGrp -q -v1 asColorSetting`;";
		   $ColorSetting+="int $vis_2=`checkBoxGrp -q -v2 asColorSetting`;";
		   $ColorSetting+="$asViewport=$vis_1;$asOutliner=$vis_2;";

checkBoxGrp  -vis 1 -cw3 0 75 75  -ncb 2 -l "" -la2 "视图颜色" "大纲颜色" -v1 $asViewport -v2 $asOutliner -cc $ColorSetting asColorSetting;

iconTextButton -vis 1 -ebg 0 -bgc 0.2 0.2 0.2 -c "asColorSliderIndex 1" -ann "创建控制器" asColorSetting_A;
asColorSliderIndex $asSetPreColors;
iconTextButton -vis 1 -ebg 0 -bgc 0.2 0.2 0.2 -i `Icons "asMenu"` -c "asMenuToolVis 1" -ann "创建控制器" asColorSetting_B;

//==========颜色块区域===========//

palettePort -h 28 -dim 16 2 -rgbValue 0 0 0 0 -td 1 -cc "sg_CustomColorChange 2" -ce sg_SaveColor asColor_Port;
	popupMenu ;
		string $asPortPopupMenu="";
			   $asPortPopupMenu+="asColorSliderIndex 0;";
			   $asPortPopupMenu+="float $rgb[]=`palettePort -q -rgb asColor_Port`;";
			   $asPortPopupMenu+="colorSliderGrp -e -rgb $rgb[0] $rgb[1] $rgb[2] asColor_Slider;";
			   $asPortPopupMenu+="gtMemoryColor;";
		menuItem -i "addClip.png" -l "添加为预设" -c $asPortPopupMenu;

string $saveRGB;
for ($index = 1; $index <= 31; $index++) {
	$saveRGB="SeveColor"+$index;
	if(`optionVar -ex $saveRGB`){
		float $saveColor[] = `optionVar -q $saveRGB`;
		palettePort -edit -rgbValue $index $saveColor[0] $saveColor[1] $saveColor[2] asColor_Port;
	}
	else{
		float $saveColor[] = `asColor $index`;
		palettePort -edit -rgbValue $index $saveColor[0] $saveColor[1] $saveColor[2] asColor_Port;
	}
}

//==========功能图标===========//
	formLayout -bgc 0.16 0.16 0.16 -vis $asMenuToolVis asMenuTool;
	
		iconTextButton -i `Icons "asColorL"` -c "sg_GradientColor -1" -ann "渐变色左调整" asMenuTool_1;
		iconTextButton -i `Icons "asColorR"` -c "sg_GradientColor 1" -ann "渐变色右调整" asMenuTool_2;
		iconTextButton -i `Icons "asCopyColor"` -c "sg_CopyColor" -ann "拷贝颜色" asMenuTool_3;
		iconTextButton -i `Icons "asPasteColor"` -c "sg_PasteColor" -ann "粘贴颜色" asMenuTool_4;
		iconTextButton -i `Icons "asResetColor"` -c "sg_ResetColor" -ann "重置颜色" asMenuTool_5;
		iconTextButton -i `Icons "asRestoreColorBoard"` -c "sg_RestoreColorBoard" -ann "还原默认色板" asMenuTool_6;

	setParent..;

	formLayout -e 
	-attachNone asMenuTool_1 "top" 
	-attachForm asMenuTool_1 "left" 0
	-attachPosition asMenuTool_1 "right" 0 10
	-attachNone asMenuTool_1 "bottom" 

