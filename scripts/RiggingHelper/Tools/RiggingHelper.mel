global proc asMenuUI (int $but){

	for($e = 1 ; $e <= 6 ; $e++){
		columnLayout -e -vis 0 ("asColumnLayout_"+$e);
		iconTextButton -e -ebg 0 ("asMenu_"+$e);
	}

	columnLayout -e -vis 1 ("asColumnLayout_"+$but);
	iconTextButton -e -ebg 1 ("asMenu_"+$but);

	iconTextButton -e -c ("gtFLTALL asFly_"+$but+" 1;") asMenu_7;
	iconTextButton -e -c ("gtFLTALL asFly_"+$but+" 0;") asMenu_8;

	optionVar -iv asMenuVis $but;

}

global proc asColorSliderIndex (int $vis){

	global int $asSetPreColors;
	$asSetPreColors=$vis;

	if($vis==1){
		colorSliderGrp -e -vis 0 asColor_Slider ;
		colorIndexSliderGrp -e -vis 1 asColor_Index ;
		iconTextButton -e -i `Icons "asColorIND"` -c "asColorSliderIndex 0" -ann "创建控制器" asColorSetting_A;
	}
	if($vis==0){
		colorSliderGrp -e -vis 1 asColor_Slider ;
		colorIndexSliderGrp -e -vis 0 asColor_Index ;
		iconTextButton -e -i `Icons "asColorRGB"` -c "asColorSliderIndex 1" -ann "创建控制器" asColorSetting_A;
	}
}

global proc asMenuToolVis (int $vis){
	
	global int $asMenuToolVis;
	$asMenuToolVis=$vis;
	if($vis==1){
		formLayout -e -vis 1 asMenuTool;
		iconTextButton -e -c "asMenuToolVis 0" asColorSetting_B;
	}
	if($vis==0){
		formLayout -e -vis 0 asMenuTool;
		iconTextButton -e -c "asMenuToolVis 1" asColorSetting_B;
	}

}

global proc asIconButtonRevise (string $name){

string $Ico=`iconTextButton -q -i $name`;
if($Ico==`Icons "asSetUp"`)
	iconTextButton -e -i `Icons "asSetDn"` $name;
if($Ico==`Icons "asSetDn"`)
	iconTextButton -e -i `Icons "asSetUp"` $name;
}

global proc string Icons (string $ico){
	global string $asScriptRoute;
	string $Icos=$asScriptRoute+"Icons/"+$ico+".png";
	return $Icos;
}

global proc asRunProgram (string $Program){
	global string $asScriptRoute;
	string $ToolFiles=$asScriptRoute+"Tools";
	string $form = ($ToolFiles+"/"+$Program+".mel");
	//source "$form";
}

global proc float [] asColor (int $index)
{
	float $colorComponentArray[] = `colorIndex -query $index`;
	return $colorComponentArray;
}

global proc cvRemoveAsWorkspaceControl (){
if (!`exists workspaceControl`)
	return;
if (`workspaceControl -ex RiggingHelperWorkspace`)
	workspaceControl -e -close RiggingHelperWorkspace;
if (`workspaceControlState -exists RiggingHelperWorkspace`)
	workspaceControlState -remove RiggingHelperWorkspace;
}

global proc gtCloseWindow (){
if (`workspaceControl -q -ex RiggingHelperWorkspace`)
	cvRemoveAsWorkspaceControl;
if (`dockControl -q -ex RiggingHelperDock`)
	deleteUI -control RiggingHelperDock;
if(`window -ex RiggingHelperWin`)
	deleteUI  -window RiggingHelperWin;
}

global proc gtFLT (){
string $framLayouts[]=`lsUI -type frameLayout`;
for ($i=0;$i<size($framLayouts);$i++)
	if (`gmatch $framLayouts[$i] "asFly_*"`)
		optionVar -iv $framLayouts[$i] `frameLayout -q -cl $framLayouts[$i]`;
}

global proc gtFLTALL (string $type,int $switch){
string $framLayouts[]=`lsUI -type frameLayout`;
for ($i=0;$i<size($framLayouts);$i++)
	if (`gmatch $framLayouts[$i] ($type+"*")`)
		frameLayout -e -cl $switch $framLayouts[$i];
gtFLT;
}

global proc asWindowHideToggle (int $but){

if($but==1){
	formLayout -e -vis 1 asFrame_a ;
	formLayout -e -vis 0 asFrame_b ;
	iconTextButton -e -c "asWindowHideToggle 2" asHelpImage;
	menuItem -e -rb on asMenuItem_up;
	optionVar -iv asWindowVis 1;
}
if($but==2){
	formLayout -e -vis 0 asFrame_a ;
	formLayout -e -vis 1 asFrame_b ;
	iconTextButton -e -c "asWindowHideToggle 3" asHelpImage;
	menuItem -e -rb on asMenuItem_dn;
	optionVar -iv asWindowVis 2;
}
if($but==3){
	formLayout -e -vis 1 asFrame_a ;
	formLayout -e -vis 1 asFrame_b ;
	iconTextButton -e -c "asWindowHideToggle 1" asHelpImage;
	menuItem -e -rb on asMenuItem_all;
	optionVar -iv asWindowVis 3;
}
}

global proc gtIconSize (int $cwh){
	int $asCwh=`optionVar -q asCwh`;
	optionVar -iv asCwh $cwh;
}

global proc float [] gtGetColors (){
float $apColorR=`optionVar -q apColorR`;
	if (!`optionVar -ex apColorR`)
		$apColorR=0.388;

float $apColorG=`optionVar -q apColorG`;
	if (!`optionVar -ex apColorG`)
		$apColorR=0.863;

float $apColorB=`optionVar -q apColorB`;
	if (!`optionVar -ex apColorB`)
		$apColorR=1;

float $apColorRGB[]={$apColorR,$apColorG,$apColorB};
return $apColorRGB;
}

global proc gtLowToolBar (){

int $vis=`formLayout -q -vis asLowTool`;

if($vis==0){
	formLayout -e -vis 1 asLowTool;
	optionVar -iv asLowToolVis 1;
}
if($vis==1){
	formLayout -e -vis 0 asLowTool;
	optionVar -iv asLowToolVis 0;
}
}

global proc ColumnLayoutVis (string $name){
int $vis=`columnLayout -q -vis $name`;
if($vis==0)columnLayout -e -vis 1 $name;
if($vis==1)columnLayout -e -vis 0 $name;
}

global proc string sg_IconTextButton (string $baseName,string $image){
	string  $Button="";
			$Button+="iconTextButton -e -iol "+$baseName+" -i \""+$image+"\" -c \"sg_SelectObj "+$baseName+"\" -dcc \"sg_CreateController_Position "+$baseName+"\" asIcoImege_but;";
			$Button+="optionVar -sv asPreIcon "+$baseName+";";
	return  $Button;
}

RiggingHelper_UI;

