	-attachNone asMenuTool_6 "top" 
	-attachPosition asMenuTool_6 "left" 0 80
	-attachForm asMenuTool_6 "right" 0 
	-attachNone asMenuTool_6 "bottom" 

	asMenuTool;
//==========控制器图标区域===========//

int $asCwh=`optionVar -q asCwh`;
	if (!`optionVar -ex asCwh`)
		$asCwh=48;

if($asCwh==34)menuItem -e -rb on asMimIco_1;
if($asCwh==48)menuItem -e -rb on asMimIco_2;
if($asCwh==64)menuItem -e -rb on asMimIco_3;

shelfLayout -cwh $asCwh $asCwh asIco_but;

	for($tmp in $ListShape){
		string $baseName = basenameEx($tmp);
		string $image = $files+"/"+$baseName+".bmp";
		string $cc ="sg_SelectObj "+$baseName+";";
		string $dc ="sg_CreateController_Position "+$baseName ;
		string $con_name=`sg_IconTextButton $baseName $image`;
		string $ico_butt=`iconTextButton -c $cc -dcc $dc -mw 1 -mh 1 -iol $baseName `;
			popupMenu;
				menuItem -i "addClip.png" -l "添加为预设" -c $con_name ;
		if(`file -q -ex $image`)
			iconTextButton -e -i $image $ico_butt;
	}

setParent..;
setParent..;
setParent..;

int $asLowToolVis=`optionVar -q asLowToolVis `;
	if (!`optionVar -ex asLowToolVis`)
		$asLowToolVis=0;
if($asLowToolVis==1)
	menuItem -e -checkBox on asLowToolBar;
if($asLowToolVis==0)
	menuItem -e -checkBox off asLowToolBar;

//==========底端工具栏===========//

formLayout -vis $asLowToolVis asLowTool;

button -h 30 -l "恢复控制器初始位置" -c "sg_ControllerInitialPosition 1" asRecoveryCon;
button -h 30 -l "定义控制器" -c "sg_ControllerInitialPosition 0" asDefinitionCon;

setParent..;

//==========UI布局===========//

 formLayout -e

 -attachForm asHeader "top" 0
 -attachForm asHeader "left" 0
 -attachNone asHeader "bottom" 
 -attachForm asHeader "right" 0

 -attachControl asPaneLayout "top" 0 asHeader
 -attachForm asPaneLayout "left" 0
 -attachControl asPaneLayout "bottom" 0 asLowTool
 -attachForm asPaneLayout "right" 0

 -attachNone asLowTool "top" 
 -attachForm asLowTool "left" 0
 -attachForm asLowTool "bottom" 0
 -attachForm asLowTool "right" 0

 asFrame;

 formLayout -e

 -attachForm asMenu "top" 0 
 -attachForm asMenu "left" 0
 -attachNone asMenu "bottom" 
 -attachForm asMenu "right" 0

 -attachControl asFunction "top" 0 asMenu
 -attachForm asFunction "left" 0
 -attachForm asFunction "bottom" 0 
 -attachForm asFunction "right" 0

