 formLayout -e

 -attachForm asRecoveryCon "top" 0
 -attachForm asRecoveryCon "left" 0
 -attachForm asRecoveryCon "bottom" 0 
 -attachPosition asRecoveryCon "right" 1 50

 -attachForm asDefinitionCon "top" 0
 -attachControl asDefinitionCon "left" 1 asRecoveryCon
 -attachForm asDefinitionCon "bottom" 0 
 -attachForm asDefinitionCon "right" 0

 asLowTool;
/////////////////////////////////////////////////////////////////

 formLayout -e

 -attachForm asOption "top" 0
 -attachForm asOption "left" 0
 -attachForm asOption "bottom" 0
 -attachForm asOption "right" 0

 asFrame_a;

 formLayout -e

	-attachNone asReferimege "top" 
	-attachForm asReferimege "left" 0
	-attachNone asReferimege "bottom"
	-attachNone asReferimege "right" 

	-attachNone asRefer "top" 
	-attachControl asRefer "left" 0 asReferimege
	-attachNone asRefer "bottom"
	-attachForm asRefer "right" 0

	-attachForm asColorSetting "top" 45
	-attachControl asColorSetting "left" 0 asReferimege
	-attachNone asColorSetting "bottom"
	-attachNone asColorSetting "right" 

	-attachForm asColorSetting_A "top" 47
	-attachControl asColorSetting_A "left" 0 asColorSetting
	-attachNone asColorSetting_A "bottom"
	-attachNone asColorSetting_A "right" 

	-attachForm asColorSetting_B "top" 47
	-attachControl asColorSetting_B "left" 5 asColorSetting_A
	-attachNone asColorSetting_B "bottom"
	-attachNone asColorSetting_B "right" 

	-attachControl asColor_Port "top" 0 asReferimege
	-attachForm asColor_Port "left" 3
	-attachNone asColor_Port "bottom"
	-attachForm asColor_Port "right" 3

	-attachControl asMenuTool "top" 1 asColor_Port
	-attachForm asMenuTool "left" 3
	-attachNone asMenuTool "bottom"
	-attachForm asMenuTool "right" 3

	-attachControl asIco_but "top" 0 asMenuTool
	-attachForm asIco_but "left" 0
	-attachForm asIco_but "bottom" 0
	-attachForm asIco_but "right" 0

	asFrame_b;
/*
if (!$conWorkspace){
	if($asControllerDocking){
		dockControl -l "绑定师助手" -a "right" -con RiggingHelperWin -aa "left" -aa "right" RiggingHelperDock ;
	}
	else{
		showWindow "RiggingHelperWin" ;
	}
}*/
showWindow "RiggingHelperWin" ;

int $asWindowVis=`optionVar -q asWindowVis`;
	if (!`optionVar -ex asWindowVis`)
		$asWindowVis=3;
asWindowHideToggle $asWindowVis;

int $asMenuVis=`optionVar -q asMenuVis`;
	if (!`optionVar -ex asMenuVis`)
		$asMenuVis=1;
asMenuUI $asMenuVis;

asMenuToolVis $asMenuToolVis;

string $framLayouts[]=`lsUI -type frameLayout`;
for ($i=0;$i<size($framLayouts);$i++){
	if (`gmatch $framLayouts[$i] "asFly_*"`)
		if (`optionVar -ex $framLayouts[$i]`)
			frameLayout -e -cl `optionVar -q $framLayouts[$i]` $framLayouts[$i];
}

scriptJob -p asFrame -e SelectionChanged sg_InitializationSelection ;

print "||=========>>欢迎使用绑定师助手<<=========||\n";
}
