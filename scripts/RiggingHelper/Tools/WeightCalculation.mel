 -attachControl asTextRootJoints "left" 5 asTextModelName
 -attachNone asTextRootJoints "bottom"
 -attachForm asTextRootJoints "right" 5

 -attachControl asBut_d "top" 5 asBut_f
 -attachPosition asBut_d "left" 2 57
 -attachPosition asBut_d "bottom" 0 35
