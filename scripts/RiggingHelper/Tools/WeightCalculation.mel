global proc gt_Weight_Calculation_Tool_Win (){

if(`window -ex gt_Weight_Calculation_Tool_Win`)  
	deleteUI -window gt_Weight_Calculation_Tool_Win ;

window -title "单关节权重计算工具" -cc "gt_Close_Command" gt_Weight_Calculation_Tool_Win;
menuBarLayout;
menu -l "编辑";
	menuItem -i "rebuild.png" -l "重置" -c gt_Refresh ;
	menuItem -i "smallTrash.png" -l "删除临时文件" -c gt_Delete_temp ;
	menuItem -d 1;
	menuItem -i "enabled.png" -l "退出" -c "gt_Close_Command;window -e -vis 0 gt_Weight_Calculation_Tool_Win ;";
	setParent..;
menu -l "关于";
	menuItem -i "help.png" -l "帮助" -c "showHelp -a \"https://www.bilibili.com/video/BV1qt4y1a7N2\"";
	menuItem -l "版本V2.1" -c "";
	menuItem -l "联系方式" -c "confirmDialog -t \"联系方式\" -message \"制作：久违的时光     更新请加QQ群：121273755    \" -cancelButton \"确定\" ;";
	setParent..;

frameLayout -cll 0 -cl 0 -l "单关节权重计算";

string $apModel=`optionVar -q asModel`;
	if (!`objExists $apModel`)
        $apModel="";
string $apRTJot=`optionVar -q asRTJot`;
	if (!`objExists $apRTJot`)
		$apRTJot="";
int $asBut_vis=`optionVar -q asBut_vis`;
	if (!`optionVar -ex asBut_vis`)
		$asBut_vis=0;	

string $but_c,$but_l;

if($asBut_vis==0){
	$but_c="gt_Transfer_Weight 0";
	$but_l="分配权重";
}
if($asBut_vis==1){
	$but_c="gt_Transfer_Weight 1";
	$but_l="回传权重";
}

formLayout asForm ;
textField -h 35 -tx $apModel asTextModelName ;
button -h 35 -c gt_Loading_Model -l "加载模型"  asBut_e;

textField -h 35 -tx $apRTJot asTextRootJoints ;
button -h 35 -c gt_Loading_Root_Joints -l "加载根关节"  asBut_f;

textScrollList -ams 0 -sc "gt_Prominent"  asTextJoints;
		popupMenu ;
			menuItem -i "selectNonOverlappingUV.png" -l "全选" -en 0 -c "gt_Select_All;gt_Prominent;" asSelectAll;
    		menuItem -i "smallTrash.png" -l "移除选项" -c "gt_Delete_ScrollList 0";
    		menuItem -i "hotkeyFieldClear.png" -l "移除全部" -c "gt_Delete_ScrollList 1";
button -h 35 -c gt_Loading_Joints -l "加载子关节"  asBut_c;

button  -c "gt_Expanding_Options" -l "选择线\n延循环边扩展"  asBut_d;

intFieldGrp -adj 2 -cw2 28 1 -l "内：" -v1 15 asAlw_n ;
intFieldGrp -adj 2 -cw2 28 1 -l "外：" -v1 15 asAlw_w ;

button -h 45 -c "gt_Create_Link" -l "手动关联点" asRelation ;

intSliderGrp -cw3 65 45 140 -l "扩展次数：" -f 1 -min 0 -max 100 -v 25 asSeconds;

floatSliderGrp -cw3 65 45 140 -l "关节大小：" -field 1 -min 0.01 -max 10.0 -pre 2 -v `jointDisplayScale -q` -dc "jointDisplayScale #1" -cc "jointDisplayScale #1" asJotSize;

radioButtonGrp  -cw4 65 45 45 45 -numberOfRadioButtons 3  -label "编辑方向：" -labelArray3 "右侧" "左侧" "两侧" -sl 3 asDirection ;

checkBox -l "查看模式" -onc "gt_View_Switch 1" -ofc "gt_View_Switch 0" -v 0 asViewMode ;
checkBox -l "重置模式" -onc "gt_Clear_Mode 1" -ofc "gt_Clear_Mode 0" -v 0 asResetMode ;
checkBox -l "自动关联" -onc "gt_Automatic_but 1" -ofc "gt_Automatic_but 0" -v 0 asAutomatic ;

button -h 35 -c "gt_Edit_Weight" -l "编辑权重"  asBut_g;
button -h 35 -c $but_c -l $but_l asBut_a;

progressBar -h 15 -maxValue 100 -m 0 asProgress_a;
progressBar -h 15 -maxValue 100 -m 0 asProgress_b;

setParent..;
setParent..;

 formLayout -edit

 -attachForm asTextModelName "top" 5
 -attachForm asTextModelName "left" 5
 -attachNone asTextModelName "bottom"
 -attachPosition asTextModelName "right" 0 50

 -attachControl asTextJoints "top" 5 asBut_e
 -attachForm asTextJoints "left" 5
