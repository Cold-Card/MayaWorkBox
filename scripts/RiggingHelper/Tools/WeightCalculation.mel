 -attachControl asRelation "top" 0 asAlw_n
 -attachPosition asRelation "left" 2 57
 -attachControl asRelation "bottom" 5 asBut_c
 -attachForm asRelation "right" 5
 
 -attachControl asBut_e "top" 2 asTextModelName
 -attachForm asBut_e "left" 5
 -attachNone asBut_e "bottom"
 -attachControl asBut_e "right" 5 asTextRootJoints

 -attachControl asBut_f "top" 2 asTextModelName
