////////////////点选按钮
global proc gt_View_Switch (int $onf){
	if($onf==1){
		checkBox -e -v 0 asResetMode;
		menuItem -e -en 1 asSelectAll;
		textScrollList -e -ams 1 asTextJoints;
	}
	if($onf==0){
		gt_Close_Command;
		menuItem -e -en 0 asSelectAll;
		textScrollList -e -ams 0 asTextJoints;
	}
}

////////////////点选按钮
global proc gt_Clear_Mode (int $onf){
	if($onf==1){
		checkBox -e -v 0 asViewMode ; 
		menuItem -e -en 1 asSelectAll;
		textScrollList -e -ams 1 asTextJoints ; 
	}
	if($onf==0){
		gt_Close_Command;
		menuItem -e -en 0 asSelectAll;
		textScrollList -e -ams 0 asTextJoints;
	}
}

global proc gt_Default_Setting (){
		checkBox -e -v 0 asResetMode;
		checkBox -e -v 0 asViewMode ;
		menuItem -e -en 0 asSelectAll;
		textScrollList -e -ams 0 asTextJoints;
}

////////////////按钮
global proc gt_Automatic_but (int $onf){
	if($onf==1){
        button -e -c "gt_Automatic_solution" -l "自动关联点" asRelation ;
	}
	if($onf==0){
        button -e -c "gt_Create_Link" -l "手动关联点" asRelation ;
	}
}

////////////////按钮
global proc gt_Assign_Weight_but (int $onf){
	if($onf==0){
        button -e -c "gt_Transfer_Weight 0" -l "分配权重"  asBut_a;
        optionVar -iv asBut_vis 0;
	}

	if($onf==1){
        button -e -c "gt_Transfer_Weight 1" -l "回传权重"  asBut_a;
        optionVar -iv asBut_vis 1;
	}

}

////////////////全选
global proc gt_Select_All (){

int $E=`checkBox -q -v asResetMode`;

	string $jot[]=`textScrollList -q -ai asTextJoints`;
	for($i=1;$i<size($jot)+1;$i++){
		int $ni=`textScrollList -e -sii $i asTextJoints`;
	}
	if($E==1){
		gt_Reset_vtx $jot;
		select -cl;
	}
}

////////////////重置
global proc gt_Refresh (){
	gt_Close_Command;
	textField -e -tx "" asTextModelName; 
	textField -e -tx "" asTextRootJoints ;
	textScrollList -e -ra asTextJoints ; 
	optionVar -rm asModel;
	optionVar -rm asRTJot;
	optionVar -rm apADJot;
	gt_Assign_Weight_but 0 ;
	gt_Default_Setting ;
}

////////////////删除列表
global proc gt_Delete_ScrollList (int $all){
	string $sa;
	if($all==0)$sa="-si";
	if($all==1)$sa="-ai";
	string $apADJot[]=`textScrollList -q $sa asTextJoints`;	
	for($j=0;$j<size($apADJot);$j++){
	    catchQuiet (`setAttr ($apADJot[$j]+".radius") 1`);
	    catchQuiet (`setAttr ($apADJot[$j]+".overrideColor") 0`);
	    catchQuiet (`setAttr ($apADJot[$j]+".overrideEnabled") 0`);
	    catchQuiet (`textScrollList -e -ri $apADJot[$j] asTextJoints`);
    }
    optionVar -rm apADJot;
}

////////////////删除缓存
global proc gt_Delete_temp (){

if(`optionVar -ex apTemp_Grp`){
	string $tmep_grp=`optionVar -q apTemp_Grp`;
	if(`objExists $tmep_grp`)
		delete $tmep_grp;
	else error "临时文件已清除！！！";
}
else error "未生成临时文件！！！";

}

/////////////////加载模型

global proc gt_Loading_Model (){
    string $sel[]=`ls -sl`;

    int $size=size($sel);
    if($size==0)error "没有选择任何模型！！！";

    textField -e -tx ($sel[0]) asTextModelName;
    optionVar -sv asModel $sel[0];
}

//////////加载根关节

global proc gt_Loading_Root_Joints (){

	string $apModel=`optionVar -q asModel`;

string $tempString[]=`listHistory $apModel`;
string $skinCluster;
for ($y=0;$y<size($tempString);$y++)
	if (`objectType $tempString[$y]`=="skinCluster"){
		$skinCluster=$tempString[$y];
		optionVar -sv asSkinCluster $skinCluster;
	}

	string $sel[]=`ls -sl -typ "joint"`;
	int $size=size($sel);
	if($size==0)
		error "没有选择任何关节！！！";

	if (!`objExists $skinCluster`)
		error "选定模型未添加蒙皮！！！";

	textField -e -tx $sel[0] asTextRootJoints;
	optionVar -sv asRTJot $sel[0];

if(!`objExists ($sel[0]+"_temp_jot")`){

string $grp=$apModel+"_temp_grp";

if(!`objExists $grp`){
	group -em -n $grp;
	optionVar -sv apTemp_Grp $grp;
}	
	select -cl;
	float $pos[]=`xform -q -ws -t $sel[0]`;
	string $temp_jot=`joint -p $pos[0] $pos[1] $pos[2] -n ($sel[0]+"_temp_jot")`;
	parent $temp_jot $grp;
	//string $temp_grp=`group -n $grp`;
	optionVar -sv asTemp_Joint $temp_jot;
	catchQuiet (`skinCluster -e -ug -lw 0 -wt 0 -ai $temp_jot $skinCluster`);
}
}

////////////////加载关节
global proc gt_Loading_Joints (){
    string $sel[]=`ls -sl -typ "joint"`;
    int $size=size($sel);
    if($size==0)error "没有选择任何关节！！！";
    textScrollList -e -ra asTextJoints;
    for($i=0;$i<size($sel);$i++){
    	textScrollList -e -a $sel[$i] asTextJoints;
    }
	optionVar -rm apADJot;
	for($j=0;$j<size($sel);$j++){
		optionVar -sva apADJot $sel[$j];
    }
} 

///////////////////扩展选择按钮
global proc gt_Expanding_Options (){
	int $s=`intSliderGrp -q -v asSeconds`;
	for($j=0;$j<$s;$j++){
	    PolySelectTraverse 5;
	}
}

////////////////选择栏关节
global proc gt_Prominent (){

	string $apADJot[]=`textScrollList -q -ai asTextJoints`;

	string $joint[]=`textScrollList -q -si asTextJoints`;

	int $V=`checkBox -q -v asViewMode`;
	int $E=`checkBox -q -v asResetMode`;

	for($j=0;$j<size($apADJot);$j++){
	    catchQuiet (`setAttr ($apADJot[$j]+".radius") 1`);
	    catchQuiet (`setAttr ($apADJot[$j]+".overrideColor") 0`);
	    catchQuiet (`setAttr ($apADJot[$j]+".overrideEnabled") 0`);
    }
	for($i=0;$i<size($joint);$i++){
	    catchQuiet (`setAttr ($joint[$i]+".radius") 1.5`);
	    catchQuiet (`setAttr ($joint[$i]+".overrideEnabled") 1`);
	    catchQuiet (`setAttr ($joint[$i]+".overrideColor") 14`);
	if($V==0){
		select -r $joint[$i];
	}
	}
	SelectEdgeMask;
	SelectTool;
if($V==1){
	select -cl;
	for($e=0;$e<size($joint);$e++){
	gt_Select_Association_vtx $joint[$e];
	}
}
if($E==1){
	gt_Reset_vtx $joint;
}
}

///////////////关闭窗口
global proc gt_Close_Command (){

string $apADJot[]=`textScrollList -q -ai asTextJoints`;	
	for($j=0;$j<size($apADJot);$j++){
	    catchQuiet (`setAttr ($apADJot[$j]+".radius") 1`);
	    catchQuiet (`setAttr ($apADJot[$j]+".overrideColor") 0`);
	    catchQuiet (`setAttr ($apADJot[$j]+".overrideEnabled") 0`);
    }
}

///////////////关联点
global proc gt_Create_Link (){
	ConvertSelectionToVertices;
	string $sel_all[]=`ls -sl -fl`;

	string $sel[]=`gt_Select_vtx $sel_all`;
	string $jot_n[]=`textScrollList -q -si asTextJoints`;
	string $jot_name=$jot_n[0]+"_selvtx";
	optionVar -sv $jot_name "";
	for($i=0;$i<size($sel);$i++){
		optionVar -sva $jot_name $sel[$i];
	}
}

///////////////重置模式
global proc gt_Reset_vtx (string $jot_n[]){
	for($i=0;$i<size($jot_n);$i++){
		string $jot_name=$jot_n[$i]+"_selvtx";
		optionVar -sv $jot_name "";
	}
}

///////////选择关联点
global proc gt_Select_Association_vtx (string $jot_sel){
string $jot_name=$jot_sel+"_selvtx";
int $V=`checkBox -q -v asViewMode`;
int $E=`checkBox -q -v asResetMode`;
if($V==0&&$E==0)select -cl;
	if(`optionVar -ex $jot_name`){
		string $jot_vtx_all[]=`optionVar -q $jot_name`;
		int $max=(size($jot_vtx_all))-1;
		progressBar -e -bp -ii true -max $max asProgress_b;
		for($j=1;$j<size($jot_vtx_all);$j++){
			progressBar -e -s 1 asProgress_b;
			select -add $jot_vtx_all[$j];
		}
		progressBar -e -ep asProgress_b;
	}
	else error "关节没有任何关联点！！！";
}

//////编辑权重
global proc gt_Edit_Weight (){
string $apModel=`optionVar -q asModel`;
select -r $apModel;
ArtPaintSkinWeightsToolOptions ;
}

////////////////左右点筛选
global proc string [] gt_Select_vtx (string $vtx[]){
	string $apModel=`optionVar -q asModel`;
	float $posM[]=`xform -q -ws -t $apModel`;
	int $Direction=`radioButtonGrp -q -sl asDirection`;
	if($Direction!=3){
		select -cl;
		for($i=0;$i<size($vtx);$i++){
			float $pos[]=`xform -q -ws -t ($vtx[$i])`;
				if($Direction==1){
					if($pos[0] <= $posM[0]+0.0001){
						select -add $vtx[$i];
					}
			}
				if($Direction==2){
					if($pos[0] >= $posM[0]-0.0001){
						select -add $vtx[$i];
					}
			}
		}
	}
	string $vtx_new[]=`ls -sl -fl`;
	return $vtx_new;
}

//skinPercent
//skinCluster -swi
//polySelect
//SmoothBindSkin;
/////////////////传递权重
global proc gt_Transfer_Weight (int $Tee){

SelectTool;
gt_Default_Setting;
string $apModel=`optionVar -q asModel`;
string $apRTJot=`optionVar -q asRTJot`;
string $tmep_jot=`optionVar -q asTemp_Joint`;
string $apADJot[]=`textScrollList -q -ai asTextJoints`;
string $apModel_sp[]=`listRelatives -s $apModel`;
string $skinCluster=`optionVar -q asSkinCluster `;

setAttr ($apRTJot+".liw") 1;

int $speed=size($apADJot);

		for($k in $apADJot){
			setAttr ($k+".liw") 1;
		}

if($Tee==0){
	progressBar -e -m 1 -bp -ii true -max $speed asProgress_a;
	progressBar -e -m 1 asProgress_b;
	
		for($i=0;$i<$speed;$i++){
			progressBar -e -s 1 asProgress_a;
			setAttr ($apADJot[$i]+".liw") 0;
			gt_Select_Association_vtx $apADJot[$i];
			skinPercent -tmw $tmep_jot -tmw $apADJot[$i] $skinCluster;
			setAttr ($apADJot[$i]+".liw") 1;
		}
		for($k in $apADJot){
			setAttr ($k+".liw") 0;
		}
	setAttr ($apRTJot+".liw") 0;
	progressBar -e -ep asProgress_a;
	progressBar -e -m 0 asProgress_a;
	progressBar -e -m 0 asProgress_b;		
	gt_Assign_Weight_but 1;	
 	print "||=========>>已完成分配<<=========||\n";
}

if($Tee==1){
	for($k in $apADJot){
		setAttr ($k+".liw") 0;
	}
    select -cl;
    select -r $apModel;
    ArtPaintSkinWeightsTool; 
    artAttrSkinPaintCtx -e -sao absolute -influence $tmep_jot artAttrSkinContext;
    artSkinInflListChanging $tmep_jot 1;
    artSkinInflListChanged artAttrSkinPaintCtx;
    artFloodSurfaces;
    SelectTool ;
    gt_Assign_Weight_but 0;
    print "||=========>>已完成回传<<=========||\n";
}	

}

//////////////////////////////////////////////////////全自动解算
//////////////////////////////////////////////////////////

global proc int gt_int_split (string $vtx_all){
	string $vtx_f[];
	int $s=`tokenize $vtx_all "[ ]" $vtx_f`;
	int $int=$vtx_f[1];
	return $int;
}

global proc string gt_vtx_compose (string $obj,int $vtx){
string $obj_vtx=$obj+".vtx["+$vtx+"]";
return $obj_vtx;
}

global proc string gt_e_compose (string $obj,int $e){
string $obj_e=$obj+".e["+$e+"]";
return $obj_e;
}

global proc string [] gt_Extend_Selection (){

    string $ee[]=`ls -sl -fl`;
    int $vtx=`gt_int_split $ee[0]`;
    string $apModel=`optionVar -q asModel`;

    int $n = `intFieldGrp -q -v1 asAlw_n `;
    int $w = `intFieldGrp -q -v1 asAlw_w `;

    int $vts_s[]=`polySelect -elb $vtx $apModel`;
    int $ss;
    for($i=0;$i<size($vts_s);$i++){
        if($vts_s[$i]==$vtx)
            $ss=$i;
    }
    select -cl;
    for($j=0;$j<$n;$j++){
        int $a=$ss+$j+1;
        if($a>0&&$a<size($vts_s))
            select -add `gt_e_compose $apModel $vts_s[$a]`;
    }
    for($u=0;$u<$w;$u++){
        int $e=$ss-$u-1;
        if($e>0&&$e<size($vts_s))
            select -add `gt_e_compose $apModel $vts_s[$e]`;
    }
    select -add `gt_e_compose $apModel $vts_s[$ss]`;
    string $obj_e[]=`ls -sl -fl`;
    return $obj_e;
}

global proc gt_Automatic_solution (){

string $apModel=`optionVar -q asModel`;
string $apModel_sp[]=`listRelatives -s $apModel`;
string $apADJot[]=`textScrollList -q -ai asTextJoints`;
int $extend=`intSliderGrp -q -v asSeconds`;

float $pos_a[]=`xform -q -ws -t $apADJot[0]`;
float $pos_b[]=`xform -q -ws -t $apADJot[1]`;
string $node=`createNode closestPointOnMesh`;
connectAttr -f ($apModel_sp[0]+".outMesh") ($node+".inMesh") ;

setAttr -typ float3 ($node+".inPosition") $pos_a[0] $pos_a[1] $pos_a[2];
int $st_vtx=`getAttr ($node+".closestVertexIndex")`;

setAttr -typ float3 ($node+".inPosition") $pos_b[0] $pos_b[1] $pos_b[2];
int $en_vtx=`getAttr ($node+".closestVertexIndex")`;

int $hol[]=`polySelect -sep $st_vtx $en_vtx $apModel`;
int $cir[]=`polySelect -el $hol[0] $apModel`;
string $cir_c[]=`ls -sl -fl`;

progressBar -e -m 1 -bp -ii true -max (size($apADJot)) asProgress_a;
progressBar -e -m 1 asProgress_b;
for($i=0;$i<size($apADJot);$i++){
    progressBar -e -s 1 asProgress_a;
    float $pos_s[]=`xform -q -ws -t $apADJot[$i]`;
    setAttr -typ float3 ($node+".inPosition") $pos_s[0] $pos_s[1] $pos_s[2];
    int $st_vtx=`getAttr ($node+".closestVertexIndex")`;
    string $sel=`gt_vtx_compose $apModel $st_vtx`;
    select -r $sel;
    ConvertSelectionToEdges;
    select -d $cir_c ;

    gt_Extend_Selection ;

    ConvertSelectionToVertices;

    string $vtx_all[]=`ls -sl -fl`;
    string $vtx[]=`gt_Select_vtx $vtx_all`;
    string $jot_name=$apADJot[$i]+"_selvtx";
    optionVar -sv $jot_name "";

    progressBar -e -bp -ii true -min -1 -max (size($vtx)) asProgress_b;
    for($j=0;$j<size($vtx);$j++){
	    progressBar -e -s 1 asProgress_b;
		optionVar -sva $jot_name $vtx[$j];
	}
	progressBar -e -ep asProgress_b;
}
progressBar -e -ep asProgress_a;
progressBar -e -m 0 asProgress_a;
progressBar -e -m 0 asProgress_b;
delete $node;
}












