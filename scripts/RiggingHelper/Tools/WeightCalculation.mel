 -attachForm asProgress_a "right" 5

 -attachNone asProgress_b "top" 
 -attachForm asProgress_b "left" 5
 -attachForm asProgress_b "bottom" 2
 -attachForm asProgress_b "right" 5

  asForm;

if (`objExists $apRTJot`){
    if(`optionVar -ex apADJot`){
	    string $apADJot[]=`optionVar -q apADJot`;
	    for($i=1;$i<size($apADJot);$i++){
		    textScrollList -e -a $apADJot[$i] asTextJoints;
	    }
	}
}

showWindow gt_Weight_Calculation_Tool_Win;

print "||=========>>欢迎使用绑定师助手<<=========||\n";

}

gt_Weight_Calculation_Tool_Win;
window -e -wh 400 500 -s 1 gt_Weight_Calculation_Tool_Win;
