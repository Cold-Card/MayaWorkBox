 -attachNone asViewMode "right" 

 -attachNone asBut_g "top" 
 -attachForm asBut_g "left" 5
 -attachControl asBut_g "bottom" 5 asProgress_a
 -attachPosition asBut_g "right" 0 50
 
 -attachNone asBut_a "top" 
 -attachControl asBut_a "left" 5 asBut_g
 -attachControl asBut_a "bottom" 5 asProgress_a
