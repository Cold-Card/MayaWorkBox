//==========添加属性===========//
global proc sg_AddAttribute (){

string $sel[]=`ls -sl`;

	string $names=`textFieldGrp -q -tx asAttrname`;
	int $make=`radioButtonGrp -q -sl asMakeAttribute`;
	int $type=`radioButtonGrp -q -sl asAttributetype` + sign(float(`radioButtonGrp -q -sl asAttributetype2`))*3.0 + `radioButtonGrp -q -sl asAttributetype2`;
	string $Minimum=`textFieldGrp -q -tx asMinimum`;
	string $Maximum=`textFieldGrp -q -tx asMaximum`;
	string $Default=`textFieldGrp -q -tx asDefault`;
	string $Enumname=`textFieldGrp -q -tx asEnumname`;

float $min,$max,$dv;
if($Minimum=="")
	$min=0;
else $min=$Minimum;
if($Maximum=="")
	$max=0;
else $max=$Maximum;
if($Default=="")
	$dv=0;
else $dv=$Default;

string $name_a[];
int $name_s=`tokenize $names " " $name_a`;

int $k;
if($make==1||$make==3)$k=1;
if($make==2)$k=0;

string $typ;
if($type==1)$typ="long";
if($type==2)$typ="double";
if($type==3)$typ="enum";
if($type==4)$typ="bool";
if($type==5)$typ="double";
if($type==6)$typ="string";

for($j=0;$j<size($sel);$j++){
	for($i=0;$i<$name_s;$i++){
		select -r ($sel[$j]);
		if($type==1&&$Minimum!=""&&$Maximum!=""||$type==2&&$Minimum!=""&&$Maximum!=""){
			addAttr -ln $name_a[$i] -at $typ -min $min -max $max -dv $dv -k $k;
		}
		if($type==1&&$Minimum==""&&$Maximum!=""||$type==2&&$Minimum==""&&$Maximum!=""){
			addAttr -ln $name_a[$i] -at $typ -max $max -dv $dv -k $k;
		}
		if($type==1&&$Minimum!=""&&$Maximum==""||$type==2&&$Minimum!=""&&$Maximum==""){
			addAttr -ln $name_a[$i] -at $typ -min $min -dv $dv -k $k;
		}
		if($type==1&&$Minimum==""&&$Maximum==""||$type==2&&$Minimum==""&&$Maximum==""){
			addAttr -ln $name_a[$i] -at $typ -dv $dv -k $k;
		}
		if($type==3){
			addAttr -ln $name_a[$i] -at $typ -en $Enumname -k $k;
		}
		if($type==4){
			addAttr -ln $name_a[$i] -at $typ -k $k;	
		}
		if($type==5){
			addAttr -ln $name_a[$i] -at ($typ+"3") -k $k ;
			addAttr -ln ($name_a[$i]+"X") -at $typ -p $name_a[$i] -k $k ;
			addAttr -ln ($name_a[$i]+"Y") -at $typ -p $name_a[$i] -k $k ;
			addAttr -ln ($name_a[$i]+"Z") -at $typ -p $name_a[$i] -k $k ;	
		}
		if($type==6){
			addAttr -ln $name_a[$i] -dt $typ -k $k ;
		}   
		if($make==3){
			setAttr -cb true ($sel[$j]+"."+$name_a[$i]);
		}
	}
}
select -r $sel;
}

//==========属性移动===========//
global proc sg_MoveUpDnAttrsProc(int $updn){
string $objs[]=`ls -sl`;
string $attrs[]=`channelBox -q -sma mainChannelBox`;
int $ex;
for($j=0;$j<size($objs);$j++){
string $obj=$objs[$j];
	for($i=0;$i<size($attrs);$i++){
		string $attr=$attrs[$i];
		$ex=`objExists ($obj+"."+$attr)`;
		if($ex==0)continue;
		string $udAttrs[]=`listAttr -ud -u $obj`;

		int $index=-1;
		for($a=0;$a<size($udAttrs);$a++)
			if($attr==$udAttrs[$a])$index=$a;
		if($index==-1)continue;
		int $indexUp=$index-1;
		if($indexUp<0)$indexUp=$index;
		string $upAttr=$udAttrs[$indexUp];

		if($updn==1){		
		if($index==0)continue;
		deleteAttr ($obj+"."+$upAttr);
		undo;
		for($aa=($index+1);$aa<size($udAttrs);$aa++){
			deleteAttr ($obj+"."+$udAttrs[$aa]);
			undo;
			}
		}
		if($updn==0){ 
		deleteAttr ($obj+"."+$attr);
		undo;
		int $dnSize=size($attrs);
		for($aa=($index+$dnSize+1);$aa<size($udAttrs);$aa++){
			deleteAttr ($obj+"."+$udAttrs[$aa]);
			undo;
				}
			}
		}  
	}
}

