	string $sel[]=`textScrollList -q -si asTextInputObj`;
		for($i=0;$i<size($sel);$i++){
			textScrollList -e -ri $sel[$i] asTextInputObj;
		}
}

global proc sg_ZoomBox (int $s){
int $h=`textScrollList -q -h asTextOutputAttr`;
int $newh;
if($s==1)$newh=$h+17;
if($s==0)$newh=$h-17;
textScrollList -e -h $newh asTextOutputAttr;
textScrollList -e -h $newh asTextInputAttr;
}

global proc sg_SearchAttr_In (){
int $size[]=`textScrollList -q -sii asTextInputAttr`;
sg_LoadInput_Attr;
string $obj[]=`textScrollList -q -ai asTextInputAttr`;
string $name=`textField -q -tx asSearch_In`;
textScrollList -e -ra asTextInputAttr;
	for($i=0;$i<size($obj);$i++){
		if (`gmatch $obj[$i] ("*"+$name+"*")`)
			textScrollList -e -a $obj[$i] asTextInputAttr;
	}
	for($j=0;$j<size($size);$j++){
		catchQuiet (`textScrollList -e -sii $size[$j] asTextInputAttr`);
	}
}

global proc sg_SearchAttr_Ou (){
int $size[]=`textScrollList -q -sii asTextOutputAttr`;
sg_LoadOutput_Attr;
string $obj[]=`textScrollList -q -ai asTextOutputAttr`;
string $name=`textField -q -tx asSearch_Ou`;
textScrollList -e -ra asTextOutputAttr;
	for($i=0;$i<size($obj);$i++){
		if (`gmatch $obj[$i] ("*"+$name+"*")`)
			textScrollList -e -a $obj[$i] asTextOutputAttr;
	}
	for($j=0;$j<size($size);$j++){
		catchQuiet (`textScrollList -e -sii $size[$j] asTextOutputAttr`);
	}
}

global proc sg_CreateAttributeConnection (){

string $OutputObj[]=`textScrollList -q -si asTextOutputObj`;
string $InputObj[]=`textScrollList -q -si asTextInputObj`;

string $OutputAttr[]=`textScrollList -q -si asTextOutputAttr`;
string $InputAttr[]=`textScrollList -q -si asTextInputAttr`;

int $ou=size($OutputObj);
int $In=size($InputObj);

if($ou==$In){
	for($i=0;$i<size($OutputObj);$i++){
		for($j=0;$j<size($InputAttr);$j++){
			connectAttr -f ($OutputObj[$i]+"."+$OutputAttr[0]) ($InputObj[$i]+"."+$InputAttr[$j]);
		}
	}
}
if($ou!=$In){
	for($i=0;$i<size($OutputObj);$i++){
		for($j=0;$j<size($InputObj);$j++){
			for($e=0;$e<size($InputAttr);$e++){
				connectAttr -f ($OutputObj[$i]+"."+$OutputAttr[0]) ($InputObj[$j]+"."+$InputAttr[$e]);
			}
		}
	}
}
}

