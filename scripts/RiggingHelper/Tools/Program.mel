//==========创建关节===========//

global proc sg_EstablishJoint (){
string $vertexs[]=`ls -sl -fl`;
if($vertexs[0]!=""){
string $ObjTyp=`objectType $vertexs[0]`;
if($ObjTyp=="transform"||$ObjTyp=="joint"){

for($i=0;$i<size($vertexs);$i++){
	select -cl;
	string $jot=`joint `;
	delete `parentConstraint $vertexs[$i] $jot`;

}
}

else if($ObjTyp=="mesh"||$ObjTyp=="nurbsCurve"){
ConvertSelectionToVertices;
string $mesh[]=`ls -sl -fl`;

for($i=0;$i<size($mesh);$i++){
	select -cl;
	float $pos[]=`xform -q -ws -t $mesh[$i]`;
	string $jot=`joint -p $pos[0] $pos[1] $pos[2] `;

}}}
else joint;
}

//==========创建定位器===========//
global proc sg_EstablishLocator (){
string $vertexs[]=`ls -sl -fl`;
if($vertexs[0]!=""){
string $ObjTyp=`objectType $vertexs[0]`;
if($ObjTyp=="transform"||$ObjTyp=="joint"){

for($i=0;$i<size($vertexs);$i++){
	select -cl;
	string $loc[]=`spaceLocator -p 0 0 0 `;
	delete `parentConstraint $vertexs[$i] $loc[0]`;
}
}
else if($ObjTyp=="mesh"||$ObjTyp=="nurbsCurve"){
ConvertSelectionToVertices;
string $mesh[]=`ls -sl -fl`;

for($i=0;$i<size($mesh);$i++){
	select -cl;
	float $pos[]=`xform -q -ws -t $mesh[$i]`;
	string $loc[]=`spaceLocator -p 0 0 0 `;
	move -ws $pos[0] $pos[1] $pos[2] $loc[0];

}}}
else CreateLocator;
}

//==========清除控制器节点信心===========//
global proc asControllerNodeClear (string $Grp){
select -r $Grp;
select -hi;
string $f = `itemFilter -byType "nurbsCurve"`;
select -r `lsThroughFilter -sl $f`;
pickWalk -d up;
sg_ControllerNodeClear;
select -cl;
}

//==========创建父子级===========//
global proc sg_Parent (){

string $sel[]=`ls -sl`;

for($i=0;$i<size($sel);$i++){
	if($i>0)
		parent $sel[$i] $sel[($i-1)];
}
}

//==========显示隐藏关节===========//
global proc sg_JointsVisibility (int $onOff){

string $joints[]=`ls -type joint`;
int $drawStyle=0;
string $but_c="sg_JointsVisibility 0";
if (!$onOff){
	$drawStyle=2;
	$but_c="sg_JointsVisibility 1";
}
for ($i=0;$i<size($joints);$i++)
	setAttr ($joints[$i]+".drawStyle") $drawStyle;

iconTextButton -e -c $but_c asVisJoint;
}

//==========显示隐藏轴心===========//
global proc sg_FitDisplayJointAxis  (int $onOff){

string $objs[]=`ls -sl`;

if(size($objs)!=0){
	for ($i=0;$i<size($objs);$i++){
		string $tempString[]=`listRelatives -c $objs[$i]`;
		string $child=$tempString[0];
		setAttr ($objs[$i]+".displayLocalAxis") $onOff;
	}

}

if(size($objs)==0){
	string $objs[]=`ls -typ joint`;
	if(size($objs)==0)
		error "场景没有找到关节！！！";
	for ($i=0;$i<size($objs);$i++){
		string $tempString[]=`listRelatives -c $objs[$i]`;
		string $child=$tempString[0];
		setAttr ($objs[$i]+".displayLocalAxis") $onOff;
	}

}
}


