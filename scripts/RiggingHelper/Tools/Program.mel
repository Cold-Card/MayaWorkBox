global proc sg_RunTransferProperties (){

string $Original[]=`textScrollList -q -ai asOriginalObj`;
string $Replace[]=`textScrollList -q -ai asReplaceObj`;
string $AttrName=`textFieldButtonGrp -q -tx asReplaceAttrName`;
int $Optio=`radioButtonGrp -q -sl asReplaceOption`;
if(size($Original)==size($Replace)){
if($Optio==1||$Optio==2||$Optio==3){
	for($i=0;$i<size($Original);$i++){
		string $attrs[]=`listAttr -m $Original[$i]`;
		for($a=0;$a<size($attrs);$a++){
			if(!`objExists ($Replace[$i]+"."+$attrs[$a])`){
				string $warning="转移对象未找到 “"+$Replace[$i]+"."+$attrs[$a]+"” 属性，此属性转移失败，请添加属性后再次转移连接。";
				warning -n $warning;
			}
			string $attr_ou[]=`listConnections -c off -p on ($Original[$i]+"."+$attrs[$a])`;
			string $attr_in[]=`listConnections -d off -p on ($Original[$i]+"."+$attrs[$a])`;
			if(size($attr_ou)>0&&$Optio!=3){
				for($j=0;$j<size($attr_ou);$j++){
					int $ex=stringArrayContains($attr_ou[$j],$attr_in);
					if($ex==0)
						catchQuiet (`connectAttr -f ($Replace[$i]+"."+$attrs[$a]) $attr_ou[$j]`);
				}
			}
			if(size($attr_in)>0&&$Optio!=2){
				for($o=0;$o<size($attr_in);$o++){
					catchQuiet (`disconnectAttr $attr_in[$o] ($Original[$i]+"."+$attrs[$a])`);
					catchQuiet (`connectAttr -f $attr_in[$o] ($Replace[$i]+"."+$attrs[$a])`);
					int $ex=stringArrayContains($attr_in[$o],$attr_ou);
					if($ex==0){
						catchQuiet (`disconnectAttr ($Original[$i]+"."+$attrs[$a]) $attr_in[$o]`);
						catchQuiet (`connectAttr -f ($Replace[$i]+"."+$attrs[$a]) $attr_in[$o]`);
					}
				}
			}
		}
	}
}
else if($Optio==4){
	for($i=0;$i<size($Original);$i++){
		string $attr_ou[]=`listConnections -c off -p on ($Original[$i]+"."+$AttrName)`;
		string $attr_in[]=`listConnections -d off -p on ($Original[$i]+"."+$AttrName)`;
		if(!`objExists ($Replace[$i]+"."+$AttrName)`){
			string $warning="转移对象未找到 “"+$Replace[$i]+"."+$AttrName+"” 属性，此属性转移失败，请添加属性后再次转移连接。";
			warning -n $warning;
		}
		if(size($attr_ou)>0){
			for($j=0;$j<size($attr_ou);$j++){
				int $ex=stringArrayContains($attr_ou[$j],$attr_in);
				if($ex==0) 
					catchQuiet (`connectAttr -f ($Replace[$i]+"."+$AttrName) $attr_ou[$j]`);
			}
		}
		if(size($attr_in)>0){
			for($o=0;$o<size($attr_in);$o++){
				catchQuiet (`disconnectAttr $attr_in[$o] ($Original[$i]+"."+$AttrName)`);
				catchQuiet (`connectAttr -f $attr_in[$o] ($Replace[$i]+"."+$AttrName)`);
				int $ex=stringArrayContains($attr_in[$o],$attr_ou);
				if($ex==0){
					catchQuiet (`disconnectAttr ($Original[$i]+"."+$AttrName) $attr_in[$o]`);
					catchQuiet (`connectAttr -f ($Replace[$i]+"."+$AttrName) $attr_in[$o]`);
				}
			}
		}
	}
}
}
else error "原始对象与转移对象加载数量不等！！！";
}

