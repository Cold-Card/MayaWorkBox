//==========控制器添加移动曲轴===========//
global proc sg_AddMovePivot (){
string $sel[]=`ls -sl`;
for($i in $sel){
	if(!`objExists ($i+".MovePivotVis")`){
		addAttr -ln "MovePivotVis" -at bool -k on $i;
		setAttr ($i+".MovePivotVis") 1;
	}
	string $loc[]=`spaceLocator -p 0 0 0 -n ($i+"_pivot")`;
	string $loc_sp[]=`listRelatives -s $loc[0]`;
	delete `parentConstraint $i $loc[0]`;
	parent $loc[0] $i;
	connectAttr -f ($loc[0]+".translate") ($i+".rotatePivot");
	connectAttr -f ($loc[0]+".translate") ($i+".scalePivot");
	connectAttr -f ($i+".MovePivotVis") ($loc_sp[0]+".visibility");
}
}

//==========世界坐标次级绑定===========//
global proc sg_CreateSecondaryControlBinding_world (){

string $sel[]=`ls -sl`;

string $shape=`sg_PreShape`;

for($i=0;$i<size($sel);$i++){
string $Loc_a[]=`spaceLocator -p 0 0 0 -n ($sel[$i]+"_loc")`;
string $Loc_a_sp[]=`listRelatives -s $Loc_a[0]`;
//setAttr ($Loc_a_sp[0]+".visibility") 0;
sg_ShapeVis $Loc_a[0] 0;
string $Loc_b[]=`spaceLocator -p 0 0 0 -n ($sel[$i]+"_loc_con")`;
string $con_a[]=`circle -ch 0 -n ($sel[$i]+"_con")`;
asSetPreColors $con_a[0];
asNurbsCircleShpape $con_a[0] $shape;
asPresuppositionScale $con_a[0];
string $Grp_a=`group -em -n ($sel[$i]+"_loc_grp")`;
string $Grp_b=`group -em -n ($sel[$i]+"_grp")`;
string $Grp_c=`group -em -n ($sel[$i]+"_loc_con_grp")`;

parent $Loc_a[0] $Grp_a;
parent $con_a[0] $Grp_b;
parent $Loc_b[0] $Grp_c;
parent $Grp_a $Grp_b;

string $node_mm=`createNode multMatrix`;
string $node_dm=`createNode decomposeMatrix`;

connectAttr -f ($con_a[0]+".worldMatrix[0]") ($node_mm+".matrixIn[0]");
connectAttr -f ($Grp_a+".worldInverseMatrix[0]") ($node_mm+".matrixIn[1]");

connectAttr -f ($node_mm+".matrixSum") ($node_dm+".inputMatrix");
connectAttr -f ($node_dm+".ot") ($Loc_a[0]+".t");
connectAttr -f ($node_dm+".or") ($Loc_a[0]+".r");
connectAttr -f ($node_dm+".os") ($Loc_a[0]+".s");
connectAttr -f ($node_dm+".osh") ($Loc_a[0]+".sh");

delete `parentConstraint $sel[$i] $Grp_c`;
delete `parentConstraint $sel[$i] $Grp_b`;

connectAttr -f ($Loc_a[0]+".t") ($Loc_b[0]+".t");
connectAttr -f ($Loc_a[0]+".r") ($Loc_b[0]+".r");
connectAttr -f ($Loc_a[0]+".s") ($Loc_b[0]+".s");
connectAttr -f ($Loc_a[0]+".sh") ($Loc_b[0]+".sh");

parentConstraint -mo $Loc_b[0] $sel[$i];
asControllerNodeClear $con_a[0];
}
}

//==========添加毛囊控制器===========//

global proc sg_AddFollicleCon (){

string $sel[]=`ls -sl`;
string $mesh=$sel[(size($sel)-1)];
string $mesh_sp[]=`listRelatives -s $mesh`;
string $shape=`sg_PreShape`;
string $node_clo=`shadingNode -asShader closestPointOnMesh`;
connectAttr -force ($mesh_sp[0]+".outMesh") ($node_clo+".inMesh") ;

for ($i=0;$i<(size($sel)-1);$i++){
	string $con=$sel[$i]+"_con";
	//string $grp=$sel[$i]+"_grp";
	string $con_grp=$sel[$i]+"_con_grp";
	string $follicle_sp=`shadingNode -asShader follicle -n ($sel[$i]+"_follicleShape")`;
	string $follicle[]=`listRelatives -p $follicle_sp`;
	connectAttr -force ($mesh_sp[0]+".worldMatrix[0]") ($follicle_sp+".inputWorldMatrix") ;
	connectAttr -force ($mesh_sp[0]+".outMesh") ($follicle_sp+".inputMesh");

	connectAttr -f ($follicle_sp+".outTranslate") ($follicle[0]+".translate") ;
	connectAttr -f ($follicle_sp+".outRotate") ($follicle[0]+".rotate") ;

	float $pos[]=`xform -q -ws -t $sel[$i]`;
	setAttr -typ float3 ($node_clo+".inPosition") $pos[0] $pos[1] $pos[2];

	float $U=`getAttr ($node_clo+".parameterU")`;
	float $V=`getAttr ($node_clo+".parameterV")`;

	setAttr ($follicle_sp+".parameterU") $U;
	setAttr ($follicle_sp+".parameterV") $V;

	sg_ShapeVis $follicle[0] 0;

	circle -ch 0 -n $con;
	asSetPreColors $con;
	asNurbsCircleShpape $con $shape;
	asPresuppositionScale $con ;
	select -r $con;
	group -n $con_grp;
	parent $con_grp $follicle[0];
	setAttr -typ float3 ($con_grp+".translate") 0 0 0;
	setAttr -typ float3 ($con_grp+".rotate") 0 0 0;
}
delete $node_clo;
}

//==========曲线CV点添加控制器===========//

global proc sg_CurveControllerTool (){
string $sel[]=`ls -sl`;
for ($i in $sel)
	sg_CurveController $i $i;

}

//==========曲面添加毛囊===========//
global proc string sg_SurfaceAddFollicle (string $Surface,string $name,float $u,float $v){

string $follicle_sp=`createNode follicle -n ($name+"_follicleShape")`;
string $follicle[]=`listRelatives -p $follicle_sp`;

string $Surface_sp[]=`listRelatives -s $Surface`;

connectAttr -f ($follicle_sp+".outTranslate") ($follicle[0]+".translate");
connectAttr -f ($follicle_sp+".outRotate") ($follicle[0]+".rotate");

connectAttr -f ($Surface_sp[0]+".worldMatrix[0]") ($follicle_sp+".inputWorldMatrix");
connectAttr -f ($Surface_sp[0]+".worldSpace[0]") ($follicle_sp+".inputSurface");

setAttr ($follicle_sp+".parameterU") $u;
setAttr ($follicle_sp+".parameterV") $v;
setAttr ($follicle_sp+".visibility") 0;

return $follicle[0];
}

