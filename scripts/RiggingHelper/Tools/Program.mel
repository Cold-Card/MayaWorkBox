global proc sg_Select (){

int $typ=`radioButtonGrp -q -sl asSelectToolA` + sign(float(`radioButtonGrp -q -sl asSelectToolB`))*3.0 + `radioButtonGrp -q -sl asSelectToolB`;
string $typs;
if($typ==1)
	$typs="transform";
if($typ==2)
	$typs="joint";
if($typ==3)
	$typs="mesh";
if($typ==4)
	$typs="nurbsCurve";
if($typ==5)
	$typs="locator";

string $sel[]=`ls -sl`;
if(size($sel)!=0){
	select -hi;
	string $f = `itemFilter -byType $typs`;
	select -r `lsThroughFilter -sl $f`;
	if($typ==3||$typ==4||$typ==5)
		pickWalk -d up;
}
else {
	string $seltyp[]=`ls -typ $typs`;
	select -r $seltyp;
	if($typ==3||$typ==4||$typ==5&&size($seltyp)!=0)
		pickWalk -d up;
}
}

global proc sg_RenameObjs_Rename (int $mode){

	string $p = `textFieldButtonGrp -q -tx sg_RenameObjs_Fld_Txt_1`;
	string $n = `textFieldButtonGrp -q -tx sg_RenameObjs_Fld_Txt_2`;
	string $s = `textFieldButtonGrp -q -tx sg_RenameObjs_Fld_Txt_3`;

	string $r = `textFieldGrp -q -tx sg_RenameObjs_Fld_Txt_4`;
	string $w = `textFieldGrp -q -tx sg_RenameObjs_Fld_Txt_5`;	

	string $objs[] = `ls -l -sl`;
	string $sorted[] = `sg_SortHierarchy $objs`;
	string $reversed[] = `sg_ReverseArray $sorted`;

	for ($obj in $reversed){
		switch ($mode){
			case 1:
			string $snA = `match "[^|]*$" $obj`;
			$renameCommand = ("rename " + $obj + " " + ($p + $snA));
			break;

			case 2:
			$renameCommand = ("rename " + $obj + " " + $n);
			break;

			case 3:
			string $snB = `match "[^|]*$" $obj`;
			$snB = `match ".*[^_0-9]" $snB`;
			$renameCommand = ("rename " + $obj + " " + ($snB + $s));
			break;

			case 4:
			string $snC = `match "[^|]*$" $obj`;	

			if ($r == "") error "";
	
			$snC = `substitute $r $snC $w`;
			$renameCommand = ("rename " + $obj + " " + $snC);
			break;
			case 5:
			string $sn = `match "[^|]*$" $obj`;
			$sn = `match ".*[^_0-9]" $sn`;
			string $numbers[] = `sg_RenameObjs_Number $objs`;

			for ($o = 0; $o < `size $objs`; $o++){
				if ($objs[$o] == $obj){
					$renameCommand = ("rename " + $obj + " " + ($sn + "_" + $numbers[$o]));
					break;			
				}
			}
			break;
		}
		if (catch (`eval $renameCommand`)) print "";
	}
}

global proc string[] sg_RenameObjs_Number (string $objs[]){
	string $numbers[];
	string $numString;
	string $zeros = "";

	int $numZeros;

	int $start = `intFieldGrp -q -v1 sg_RenameObjs_IntFld_1`;
	int $inc = `intFieldGrp -q -v1 sg_RenameObjs_IntFld_2`;
	int $pad = `intFieldGrp -q -v1 sg_RenameObjs_IntFld_3`;

	int $current = $start;

	if ($pad == 1){
		for ($obj in $objs){
			$numbers[`size $numbers`] = $current;
			$current = $current + $inc;
		}
	}
	if ($pad > 1){
		for ($obj in $objs){
			$numString = $current;

			if (`size $numString` < $pad){	
				$numZeros = $pad - (`size $numString`);
				for ($n = $numZeros; $n > 0; $n--){
					$zeros = $zeros + "0";
				}
				$numString = $zeros + $numString;
				$numbers[`size $numbers`] = $numString;
			}
			else $numbers[`size $numbers`] = $current;
			$current = $current + $inc;	
			$zeros = "";
		}
	}
	return $numbers;
}

global proc string[] sg_SortHierarchy (string $objs[]){
	string $levels[];
	string $sorted[];

	int $n;
	int $lowest = 0;
	int $current = 0;

	for ($obj in $objs){
		$n = (`sg_NumberParents $obj`);

		if ($n != ""){
			$levels[`size $levels`] = $n;
		}
		else $levels[`size $levels`] = 0;

		if ($n > $lowest){
			$lowest = $n;
		}
	}

	while ($current <= $lowest){
		for ($o = 0; $o < `size $objs`; $o++) {
			if ($levels[$o] == $current) {
				$sorted[`size $sorted`] = $objs[$o];
			}
		}
		$current++;
	}
	return $sorted;
}

global proc int sg_NumberParents (string $obj) {
	string $parentObjs[];
	int $p = `tokenize $obj "|" $parentObjs`;
	$p--;
	return $p;
}

global proc string[] sg_ReverseArray (string $array[]) {
	string $returnArray[];
	int $arraySize = `size $array`;

	for ($e = 0; $e < `size $array`; $e++) {
		$returnArray[$arraySize - 1 - $e] = $array[$e];
	}
	return $returnArray;
}

global proc asRenameSuffix (string $name){
	string $sel[]=`ls -sl`;
	for ($obj in $sel){
		string $snB = `match "[^|]*$" $obj`;
		$snB = `match ".*[^_0-9]" $snB`;
		rename $obj ($snB + $name);
	}
}

global proc sg_RenameSuffixNumber (){
	string $sel[]=`ls -sl`;
	for ($obj in $sel)
		asRenameSuffixNumber $obj;

}

global proc string asRenameSuffixNumber (string $obj){

	string $temps[],$name,$newname;
	int $sn;
	string $num = `match "[0-9]+" $obj`;
	if($num!=""){
		$sn = `tokenize $obj $num $temps`;
		for ($e = 0; $e < $sn; $e++) {
			if(!`gmatch $temps[$e] "*_"`)
				$name+=$temps[$e]+"_";
			else $name+=$temps[$e];
		}

		$newname=$name + $num;
		$newname=substituteAllString($newname, "__", "_");
		rename $obj $newname;
		return $newname;
	}
	else return $obj;
}

//==========检查重名===========//

global proc string sg_lastName(string $name1){
	if(`gmatch $name1 "*|*"`)
	{
		$name1 = `match "|.*" $name1`;
		$name1 = `substring $name1 2 (size($name1))`;
		$name1 = `sg_lastName $name1`;
	}
	return $name1;
}

global proc string[] sg_endCharName(string $str1[]){
	string $lastChar = endString($str1[0], 1);
	if(`gmatch $lastChar "[0-9]"`)
	{
		$str1[0] = `substring $str1[0] 1 (size($str1[0])-1)`;
		$str1[1] = $lastChar + $str1[1];
		$str1 = `sg_endCharName $str1`;
	}
	return $str1;
}

global proc string sg_findMax(string $array[],string $str,int $min,int $max){
	int $middle = ($max-$min)/2+$min;
	$array[$middle] = sg_lastName($array[$middle]);
	string $tempStrs[] = sg_endCharName({$array[$middle]});
	if($middle!=$min)
	{
		if($str==$tempStrs[0])
			$min = $middle;
		else
			$max = $middle;
		$tempStrs[0] = sg_findMax($array,$str,$min,$max);
	}
	else
	{
		$array[$max] = sg_lastName($array[$max]);
		$tempStrs = sg_endCharName({$array[$max]});
		if($str==$tempStrs[0])
			$tempStrs[0] = $array[$max];
		else
			$tempStrs[0] = $array[$middle];
	}
	return $tempStrs[0];
}

global proc string sg_getObjMaxVersion(string $objName){
	$objName = sg_lastName($objName);
	string $tempStrs[] = sg_endCharName({$objName});
	string $array[] = `ls ($tempStrs[0] + "*")`;
	if(size($array))
	{
		$objName = sg_findMax($array,$tempStrs[0],0,(size($array)-1));
		$tempStrs = sg_endCharName({$objName});
	}
	$objName = $tempStrs[0] + (int($tempStrs[1])+1);
	return $objName;
}

global proc string[] sg_sortName(string $allName[]){
	int $i,$j,$temp_num,$numTokens1,$numTokens2;
	string $temp_name,$buffer[];
	for($i=0;$i<size($allName);$i++)
	{
		$numTokens1 = `tokenize $allName[$i] "|" $buffer`;
		for($j=0;$j<size($allName);$j++)
		{
			$numTokens2 = `tokenize $allName[$j] "|" $buffer`;
			if($numTokens1>$numTokens2)
			{
				$temp_num = $numTokens1; $numTokens1 = $numTokens2; $numTokens2 = $temp_num;
				$temp_name = $allName[$i]; $allName[$i] = $allName[$j]; $allName[$j] = $temp_name;
			}
		}
	}
	return $allName;
}

global proc string sg_rejiggerName(string $allName[],string $nameType,int $amount){
	string $againName[];
	int $j=0;
	for($i=0;$i<size($allName);$i++)
	{
		if(`gmatch $allName[$i] "*|*"`)
		{
			$againName[$j] = $allName[$i];
			$j++;
		}
		$amount += 3.0*$i/size($allName);
		progressWindow -edit
			-progress $amount
			-status ("====正在检测并且重新命名场景内所有的重名物体和节点: "+$amount+"%====");
	}
	if(!$j)
	{
		$amount += 30;
		progressWindow -edit
				-progress $amount
				-status ("====正在检测并且重新命名场景内所有的重名物体和节点: "+$amount+"%====");
		return "";
	}

	$againName = `sg_sortName $againName`;

	string $temp_name;
	string $failNames[],$loseName[],$str1[];
	int $k=0,$l=0;
	for($i=0;$i<size($againName);$i++)
	{
		if ( `progressWindow -query -isCancelled` )
		{
			break;
			return "";
		}
		if(`gmatch $againName[$i] "*|*"`)
		{
			$againName[$i] = longNameOf($againName[$i]);
			if($nameType=="Shape节点")
			{
				$temp_name = firstParentOf($againName[$i]);
				$temp_name = `sg_lastName $temp_name`;
				$str1 = `sg_endCharName {$temp_name}`;
				$temp_name = $str1[0] + "Shape\#";
			}
			else
			{
				$temp_name = `sg_lastName $againName[$i]`;
				$str1 = `sg_endCharName {$temp_name}`;
				$temp_name = $str1[0] + "\#";
			}

			if(catchQuiet($temp_name=`rename $againName[$i] $temp_name`))
			{
				$failNames[$k] = $againName[$i];
				$k++;
			}
			else
			{
				if(`gmatch $temp_name "*|*"`)
				{
					$loseName[$l] = longNameOf($temp_name);
					$l++;
				}
			}
			$amount += 10.0*$i/size($againName);
			progressWindow -edit
				-progress $amount
				-status ("====正在检测并且重新命名场景内所有的重名物体和节点: "+$amount+"%====");
		}
	}

	if($l)
	{
		$l = 0;
		for($i=0;$i<size($loseName);$i++)
		{
			$temp_name = sg_getObjMaxVersion($loseName[$i]);
			catchQuiet($loseName[$i]=`rename $loseName[$i] $temp_name`);
			if(`gmatch $loseName[$i] "*|*"`)
			{
				$str1[$l] = $loseName[$i];
				$l++;
			}
			$amount += 20.0*$i/size($loseName);
			progressWindow -edit
				-progress $amount
				-status ("====正在检测并且重新命名场景内所有的重名物体和节点: "+$amount+"%====");
		}
	}

	$temp_name = "场景内共找到" + $j + "个重名的" + $nameType + "!\n";
	$j = $j - $k;
	if($j)
	{
		$temp_name = $temp_name + "场景内" + $j + "个重名的" + $nameType + "已经全部重新更改名称!\n";
	}
	if($k)
	{
		$temp_name = $temp_name + "场景内" + $k + "个重名的" + $nameType + "重新更改名称失败,请检查是否有reference物体或者被lockNode锁定的物体!\n";
		print ("场景内" + $k + "个重名的" + $nameType + ",重新更改名称失败的物体为:\n");
		print $failNames;
	}
	if($l)
	{
		$temp_name = $temp_name + "场景内" + $l + "个重名的" + $nameType + ",二次重新命名失败,请检查是否有关联物体或者共用相同shape节点的物体!\n";
		print ("场景内" + $l + "个重名的" + $nameType + ",二次重新命名失败,请检查是否有关联或者共用相同shape节点的物体:\n");
		print $str1;
	}
	return $temp_name;
}

global proc sg_detectionOfTheSameNameMain(){
	timer -s;
	string $scripName = "检测全部重名节点";
	int $amount = 0;
	progressWindow
		-title $scripName
		-progress $amount
		-status "====正在检测并且重新命名场景内所有的重名物体和节点: 0%===="
		-isInterruptable true;

	string $allName[] = `ls -tr`;
	string $nameType = "模型或者组";
	string $temp_name = `sg_rejiggerName $allName $nameType $amount`;

	if ( !`progressWindow -query -isCancelled` )
	{
		$amount = 33;
		$allName = `ls -s`;
		$nameType = "Shape节点";
		$temp_name = $temp_name + "\n" + `sg_rejiggerName $allName $nameType $amount`;
	}

	if ( !`progressWindow -query -isCancelled` )
	{
		$amount = 67;
		$allName = `ls`;
		//string $items[] = `ls -tr`;
		//$allName = stringArrayRemove($items, $allName);
		//$items = `ls -s`;
		//$allName = stringArrayRemove($items, $allName);
		$nameType = "其它节点";
		$temp_name = $temp_name + "\n" + `sg_rejiggerName $allName $nameType $amount`;
	}
	else
		$temp_name = "程序已经被终止运行";

	if($temp_name=="\n\n")
		$temp_name = "场景内没有找到任何重名的物体和节点	";

	progressWindow -endProgress;
	print("此次运行时间为:"+`timer -e`+"秒.\n");

	confirmDialog -title $scripName -message $temp_name
		-button "确认" -defaultButton "确认"
		-cancelButton "确认" -dismissString "确认";
}

global proc sg_deleteUknownNodes(){
	string $unknownNodes[]=`ls -et "unknown"`;
	for($nodes in $unknownNodes){
		//lockNode -l 0 $nodes;
		delete $nodes;
		print ($nodes+" 未知节点已删除！！！\n");
	}
	print ("删除 "+size($unknownNodes)+" 个未知节点.\n");
} 

