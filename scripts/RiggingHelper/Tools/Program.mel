global proc sg_LoadOutput (){
	string $sel[]=`ls -sl`;
	textScrollList -e -ra asTextOutputObj;
	for($i=0;$i<size($sel);$i++){
		textScrollList -e -a $sel[$i] asTextOutputObj;
	}
} 

