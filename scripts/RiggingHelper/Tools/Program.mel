		textScrollList -e -a $sel[$i]  asTextInputObj;
	}
} 

global proc sg_LoadOutput_Attr (){
	int $s=`optionMenuGrp -q -sl asBoxOutput_on`;
	string $box;
	if($s==1)$box="-r";
	if($s==2)$box="-k";
	if($s==3)$box="-ud";
	if($s==4)$box="-m";
	string $sel[]=`textScrollList -q -si asTextOutputObj`;
	if(size($sel)>0){
		string $attr[]=`listAttr $box $sel[0]`;
		textScrollList -e -ra asTextOutputAttr;
		for($i=0;$i<size($attr);$i++){
			textScrollList -e -a $attr[$i] asTextOutputAttr;
		}
	}
}

global proc sg_LoadInput_Attr (){
	int $s=`optionMenuGrp -q -sl asBoxInput_on`;
	string $box;
	if($s==1)$box="-r";
	if($s==2)$box="-k";
	if($s==3)$box="-ud";
	if($s==4)$box="-m";
	string $sel[]=`textScrollList -q -si asTextInputObj`;
	if(size($sel)>0){
		string $attr[]=`listAttr $box $sel[0]`;
		textScrollList -e -ra asTextInputAttr;
		for($i=0;$i<size($attr);$i++){
			textScrollList -e -a $attr[$i] asTextInputAttr;
		}
	}
} 

