// ============================================================
// 原始数据数组
// ============================================================
float $all_point_u_num[] = {press_fallof_loc_01_nearestPointOnCurve.parameter,press_fallof_loc_02_nearestPointOnCurve.parameter,press_fallof_loc_03_nearestPointOnCurve.parameter,press_fallof_loc_04_nearestPointOnCurve.parameter,press_fallof_loc_05_nearestPointOnCurve.parameter};
float $all_ground_press_num[] = {press_fallof_loc_01.ground,press_fallof_loc_02.ground,press_fallof_loc_03.ground,press_fallof_loc_04.ground,press_fallof_loc_05.ground};
float $all_up_press_num[] = {press_fallof_loc_01.up,press_fallof_loc_02.up,press_fallof_loc_03.up,press_fallof_loc_04.up,press_fallof_loc_05.up};
float $all_smooth_num[] = {press_fallof_loc_01.fallofA,press_fallof_loc_01.fallofB,press_fallof_loc_02.fallofA,press_fallof_loc_02.fallofB,press_fallof_loc_03.fallofA,press_fallof_loc_03.fallofB,press_fallof_loc_04.fallofA,press_fallof_loc_04.fallofB,press_fallof_loc_05.fallofA,press_fallof_loc_05.fallofB};

// ============================================================
// 构建控制点位置、缩放值、左右半径数组
// ============================================================
int $numPoints = size($all_point_u_num);  // 11

float $ctrlPositions[] = $all_point_u_num;
float $groundPress[] = $all_ground_press_num;
float $upPress[] = $all_up_press_num;

// 左半径和右半径分别存储
float $ctrlLeftRadii[];
float $ctrlRightRadii[];

for ($i = 0; $i < $numPoints; $i++) {
    float $leftR = 0.0;
    float $rightR = 0.0;

        // 内部控制点：左侧半径 = 左区间（i-1）的第二个smooth，右侧半径 = 右区间（i）的第一个smooth
    $leftR = $all_smooth_num[$i*2] / 10;
    $rightR = $all_smooth_num[$i*2 + 1] / 10;
    
    $ctrlLeftRadii[$i] = $leftR;
    $ctrlRightRadii[$i] = $rightR;
}

// ============================================================
// 计算叠加
// ============================================================
global proc float pressWeight(float $u, float $positions[], float $Press[], float $leftRadii[], float $rightRadii[]) {
    float $total = 0.0;
    int $count = size($positions);
    for ($i = 0; $i < $count; $i++) {
        float $dist = $u - $positions[$i];
        float $weight = 0.0;
        
        if ($dist == 0.0) {
            $weight = 1.0;
        } else if ($dist < 0) {
            // 左侧衰减（使用左半径）
            float $r = $leftRadii[$i];
            if ($r > 0 && -$dist < $r) {
                float $t = (-$dist) / $r;   // 归一化距离 (0~1)
                // 三次平滑步进（从1衰减到0）
                float $k = 1.0 - $t;
                $weight = $k * $k * (3.0 - 2.0 * $k);
            }
        } else {
            // 右侧衰减（使用右半径）
            float $r = $rightRadii[$i];
            if ($r > 0 && $dist < $r) {
                float $t = $dist / $r;      // 归一化距离 (0~1)
                // 三次平滑步进（从1衰减到0）
                float $k = 1.0 - $t;
                $weight = $k * $k * (3.0 - 2.0 * $k);
            }
        }
        // 贡献累加
        $total += $Press[$i] * $weight;
    }
    return $total;
}

