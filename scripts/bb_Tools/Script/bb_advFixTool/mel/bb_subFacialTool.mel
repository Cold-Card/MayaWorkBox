//Author  :   LiuBen
//Date    :   03/14/2019
//Fix     :   03/26/2019   增加嘴部总控制器功能
//Fix     :   12/25/2019   增加嘴角眼角骨骼。
//Fix     :   01/10/2020   整体功能提升。
global proc bb_subFacialTool()
{
    if (`window -q -exists bb_subFacialToolWindow`) deleteUI bb_subFacialToolWindow;
    window -title "面部次级控制" -toolbox 1 bb_subFacialToolWindow;    
        columnLayout -adjustableColumn true -columnAttach "both" 3 -columnAlign "left";
            frameLayout -label "主要步骤";
                rowColumnLayout -numberOfColumns 3 -columnWidth 1 60 -columnWidth 2 60 -columnWidth 3 60;
                    checkBox -label "嘴唇" -value 1 bb_subFacial_createJointLip;
                    checkBox -label "眼睑" -value 1 bb_subFacial_createJointEyelid;
                    checkBox -label "眉毛" -value 1 bb_subFacial_createJointBrow;
                    checkBox -label "鼻子" -value 1 bb_subFacial_createJointNose;
                    checkBox -label "脸颊" -value 1 bb_subFacial_createJointCheek;
                    checkBox -label "下巴" -value 1 bb_subFacial_createJointChin;
                    checkBox -label "耳朵" -value 1 bb_subFacial_createJointEar;
                setParent ..;
                button -l "生成骨骼" -h 30 -bgc 0.1 0.1 0.1 -c bb_subFacial_createJoint;
                button -l "选择Base模型，生成毛囊" -h 30 -bgc 0.5 0.5 0.5 -c bb_subFacial_createFollice;
                button -l "创建控制器" -h 30 -bgc 0.1 0.1 0.1  -c bb_subFacial_createCtrl;
                button -l "整理层级" -h 40 -bgc 0.9 0.9 0.9 -c bb_subFacial_cleanUp;
                separator -height 2 -style "in"; 
                button -l "(选骨骼)重新加约束"  -bgc 0.5 0.5 0.5 -c bb_subFacial_reCon;
            frameLayout -label "镜像数值";
                text -label "左>>>右镜像数值";
                rowLayout -numberOfColumns 3 -columnWidth3 60 60 60;
                    button -l "骨骼" -w 60 -h 30 -bgc 0.9 0.9 0.5 -c bb_subFacial_mirrorJoint;
                    button -l "毛囊" -w 60 -h 30 -bgc 0.5 0.1 0.1 -c bb_subFacial_mirrorFollice;
                    button -l "控制器" -w 60 -h 30 -bgc 0 0.3 0.45 -c bb_subFacial_mirrorCtrl;
                setParent ..;
    showWindow bb_subFacialToolWindow;
}

global string $bb_subFacial_joint[],
              $bb_subFacial_ctrl[];

global proc bb_subFacial_createJoint()
{
    select -cl;
    global string $bb_subFacial_joint[];
    clear $bb_subFacial_joint;
    int $createJointLip = `checkBox -q -value bb_subFacial_createJointLip`;
    int $createJointEyelid = `checkBox -q -value bb_subFacial_createJointEyelid`;
    int $createJointBrow = `checkBox -q -value bb_subFacial_createJointBrow`;
    int $createJointNose = `checkBox -q -value bb_subFacial_createJointNose`;
    int $createJointCheek = `checkBox -q -value bb_subFacial_createJointCheek`;
    int $createJointChin = `checkBox -q -value bb_subFacial_createJointChin`;
    int $createJointEar = `checkBox -q -value bb_subFacial_createJointEar`;
    if($createJointLip == 1){
        joint -radius 0.2 -p 0 134.6 9 -n LipUpperMid_Joint; select -cl;
        joint -radius 0.2 -p 1 134.5 8.9 -n LipUpperLeft1_Joint; select -cl;
        joint -radius 0.2 -p 2 134.3 8.6 -n LipUpperLeft2_Joint; select -cl;
        joint -radius 0.2 -p 2 134 8.6 -n LipLowerLeft2_Joint; select -cl;
        joint -radius 0.2 -p 1 133.8 8.9 -n LipLowerLeft1_Joint; select -cl;
        joint -radius 0.2 -p 0 133.6 9 -n LipLowerMid_Joint; select -cl;
        joint -radius 0.2 -p -1 133.8 8.9 -n LipLowerRight1_Joint; select -cl;
        joint -radius 0.2 -p -2 134 8.6 -n LipLowerRight2_Joint; select -cl;
        joint -radius 0.2 -p -2 134.3 8.6 -n LipUpperRight2_Joint; select -cl;
        joint -radius 0.2 -p -1 134.5 8.9 -n LipUpperRight1_Joint; select -cl;
        joint -radius 0.2 -p 2.3 134.1 8.5 -n LipLeft_Joint; select -cl;
        joint -radius 0.2 -p -2.3 134.1 8.5 -n LipRight_Joint; select -cl;
        string $JointLip[] = {"LipUpperMid_Joint","LipUpperLeft1_Joint","LipUpperLeft2_Joint","LipLowerLeft2_Joint","LipLowerLeft1_Joint","LipLeft_Joint",
                              "LipLowerMid_Joint","LipLowerRight1_Joint","LipLowerRight2_Joint","LipUpperRight2_Joint","LipUpperRight1_Joint","LipRight_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointLip);
    }
    if($createJointEyelid == 1){
        joint -radius 0.2 -p 2 140.8 8.1 -n EyelidUpperLeft1_Joint; select -cl;
        joint -radius 0.2 -p 3 141 8.1 -n EyelidUpperLeft2_Joint; select -cl;
        joint -radius 0.2 -p 4 140.8 8.1 -n EyelidUpperLeft3_Joint; select -cl;
        joint -radius 0.2 -p 2 140.2 8.1 -n EyelidLowerLeft1_Joint; select -cl;
        joint -radius 0.2 -p 3 140 8.1  -n EyelidLowerLeft2_Joint; select -cl;
        joint -radius 0.2 -p 4 140.2 8.1 -n EyelidLowerLeft3_Joint; select -cl;
        joint -radius 0.2 -p -2 140.8 8.1 -n EyelidUpperRight1_Joint; select -cl;
        joint -radius 0.2 -p -3 141 8.1 -n EyelidUpperRight2_Joint; select -cl;
        joint -radius 0.2 -p -4 140.8 8.1 -n EyelidUpperRight3_Joint; select -cl;
        joint -radius 0.2 -p -2 140.2 8.1 -n EyelidLowerRight1_Joint; select -cl;
        joint -radius 0.2 -p -3 140 8.1  -n EyelidLowerRight2_Joint; select -cl;
        joint -radius 0.2 -p -4 140.2 8.1 -n EyelidLowerRight3_Joint; select -cl;
        joint -radius 0.2 -p 4.4 140.5 8 -n EyelidOutLeft_Joint; select -cl;
        joint -radius 0.2 -p 1.5 140.5 8 -n EyelidInLeft_Joint; select -cl;
        joint -radius 0.2 -p -4.4 140.5 8 -n EyelidOutRight_Joint; select -cl;
        joint -radius 0.2 -p -1.5 140.5 8 -n EyelidInRight_Joint; select -cl;
        string $JointEyelid[] = {"EyelidUpperLeft1_Joint","EyelidUpperLeft2_Joint","EyelidUpperLeft3_Joint","EyelidOutLeft_Joint",
                                 "EyelidLowerLeft1_Joint","EyelidLowerLeft2_Joint","EyelidLowerLeft3_Joint","EyelidInLeft_Joint",
                                 "EyelidUpperRight1_Joint","EyelidUpperRight2_Joint","EyelidUpperRight3_Joint","EyelidOutRight_Joint",
                                 "EyelidLowerRight1_Joint","EyelidLowerRight2_Joint","EyelidLowerRight3_Joint","EyelidInRight_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointEyelid);
    }
    if($createJointBrow == 1){
        joint -radius 0.2 -p 1.2 142.3 9.2 -n BrowLeft1_Joint; select -cl;
        joint -radius 0.2 -p 3 142.6 9 -n BrowLeft2_Joint; select -cl;
        joint -radius 0.2 -p 4.7 142.5 8.8 -n BrowLeft3_Joint; select -cl;
        joint -radius 0.2 -p -1.2 142.3 9.2 -n BrowRight1_Joint; select -cl;
        joint -radius 0.2 -p -3 142.6 9 -n BrowRight2_Joint; select -cl;
        joint -radius 0.2 -p -4.7 142.5 8.8 -n BrowRight3_Joint; select -cl;
        joint -radius 0.2 -p 0 142.3 9.2 -n BrowM_Joint; select -cl;
        string $JointBrow[] = {"BrowLeft1_Joint","BrowLeft2_Joint","BrowLeft3_Joint",
                              "BrowRight1_Joint","BrowRight2_Joint","BrowRight3_Joint","BrowM_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointBrow);
    }
    if($createJointNose == 1){
        joint -radius 0.2 -p 0 138.9 9.7 -n NoseMid_Joint; select -cl;
        joint -radius 0.2 -p 1.3 137.3 9.5 -n NoseLeft_Joint; select -cl;
        joint -radius 0.2 -p -1.3 137.3 9.5 -n NoseRight_Joint; select -cl;
        joint -radius 0.2 -p 0 136.8 9.7 -n NoseLower_Joint; select -cl;
        joint -radius 0.2 -p 0 137.7 10.6 -n NoseUpper_Joint; select -cl;
        string $JointNose[] = {"NoseMid_Joint","NoseLeft_Joint","NoseRight_Joint","NoseUpper_Joint","NoseLower_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointNose);
    }
    if($createJointChin == 1){
        joint -radius 0.2 -p 0 132.6 8.1 -n ChinMid_Joint; select -cl;
        joint -radius 0.2 -p 2.4 132.9 7.2 -n ChinLeft_Joint; select -cl;
        joint -radius 0.2 -p -2.4 132.9 7.2 -n ChinRight_Joint; select -cl;
        string $JointChin[] = {"ChinMid_Joint","ChinLeft_Joint","ChinRight_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointChin);
    }
    if($createJointCheek == 1){
        joint -radius 0.2 -p 1.5 139 8.4 -n CheekInnerLeft_Joint; select -cl;
        joint -radius 0.2 -p 3 138.7 8.1 -n CheekMidLeft_Joint; select -cl;
        joint -radius 0.2 -p 4.4 139.3 7.5 -n CheekOutterLeft_Joint; select -cl;
        joint -radius 0.2 -p 5 137.8 7.3 -n CheekUpperLeft_Joint; select -cl;
        joint -radius 0.2 -p 5.2 135.5 6 -n CheekLeft_Joint; select -cl;
        joint -radius 0.2 -p 2.4 136.5 8.4 -n NasalLabialFoldUpperLeft_Joint; select -cl;
        joint -radius 0.2 -p 3.5 134.5 7.4 -n NasalLabialFoldLowerLeft_Joint; select -cl;
        joint -radius 0.2 -p -1.5 139 8.4 -n CheekInnerRight_Joint; select -cl;
        joint -radius 0.2 -p -3 138.7 8.1 -n CheekMidRight_Joint; select -cl;
        joint -radius 0.2 -p -4.4 139.3 7.5 -n CheekOutterRight_Joint; select -cl;
        joint -radius 0.2 -p -5 137.8 7.3 -n CheekUpperRight_Joint; select -cl;
        joint -radius 0.2 -p -5.2 135.5 6 -n CheekRight_Joint; select -cl;
        joint -radius 0.2 -p -2.4 136.5 8.4 -n NasalLabialFoldUpperRight_Joint; select -cl;
        joint -radius 0.2 -p -3.5 134.5 7.4 -n NasalLabialFoldLowerRight_Joint; select -cl;
        string $JointCheek[] = {"CheekInnerLeft_Joint","CheekMidLeft_Joint","CheekOutterLeft_Joint","CheekUpperLeft_Joint",
                                "CheekLeft_Joint","NasalLabialFoldUpperLeft_Joint","NasalLabialFoldLowerLeft_Joint",
                               "CheekInnerRight_Joint","CheekMidRight_Joint","CheekOutterRight_Joint","CheekUpperRight_Joint",
                                "CheekRight_Joint","NasalLabialFoldUpperRight_Joint","NasalLabialFoldLowerRight_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointCheek);
    }
    if($createJointEar == 1){
        joint -radius 0.2 -p 6.3 139 0.7 -n EarLeft_Joint; select -cl;
        joint -radius 0.2 -p -6.3 139 0.7 -n EarRight_Joint; select -cl;
        string $JointEar[] = {"EarLeft_Joint","EarRight_Joint"};
        $bb_subFacial_joint = stringArrayCatenate($bb_subFacial_joint, $JointEar);
    }
    createNode "transform" -n "facial_jointGrp";
    parent $bb_subFacial_joint "facial_jointGrp";
}

global proc bb_subFacial_createFollice()
{
    global string $bb_subFacial_joint[];
    string $Ear[]  = {"EarLeft_Joint","EarRight_Joint"};
    string $bb_subFacial_joint[] = stringArrayRemove($Ear, $bb_subFacial_joint);
    
    string $baseMod[] = `ls -sl`;
    if(!`objExists "facial_folliceGrp"`){
        createNode "transform" -n "facial_folliceGrp";
    }
    for($i=0;$i<size($bb_subFacial_joint);$i++){
        string $cpomNode = `createNode "closestPointOnMesh" -n ("closestPointOnMesh_"+$bb_subFacial_joint[$i])`;
        string $shape[] = `listRelatives -shapes -fullPath $baseMod[0]`;
        
        connectAttr -f ($shape[0] + ".worldMesh") ($cpomNode + ".inMesh");
        connectAttr -f ($shape[0] + ".worldMatrix") ($cpomNode + ".inputMatrix");
        connectAttr -f ($bb_subFacial_joint[$i] + ".translate") ($cpomNode + ".inPosition");
        
        float $cpomNodeU = getAttr ($cpomNode + ".result.parameterU");
        float $cpomNodeV = getAttr ($cpomNode + ".result.parameterV");
        
        string $folliceNode = `createNode "follicle" -n ($bb_subFacial_joint[$i] + "_follicleShape")`;
        string $folliceTran[] = `listRelatives -p $folliceNode`;
         
        connectAttr -f ($shape[0] + ".outMesh") ($folliceNode + ".inputMesh");
        connectAttr -f ($shape[0] + ".worldMatrix") ($folliceNode + ".inputWorldMatrix");
        connectAttr -f ($folliceNode + ".outTranslate") ($folliceTran[0] + ".translate");
        connectAttr -f ($folliceNode + ".outRotate") ($folliceTran[0] + ".rotate");
        
        setAttr ($folliceNode + ".parameterU") $cpomNodeU;
        setAttr ($folliceNode + ".parameterV") $cpomNodeV;
        
        string $newName = substituteAllString($bb_subFacial_joint[$i], "Joint", "Follicle");
        rename $folliceTran[0] $newName;
        parent $newName "facial_folliceGrp" ;
    }
}

global proc bb_subFacial_createCtrl()
{
    global string $bb_subFacial_joint[],
                  $bb_subFacial_ctrl[];
    string $Ear[]  = {"EarLeft_Joint","EarRight_Joint"};
    string $bb_subFacial_joint[] = stringArrayRemove($Ear, $bb_subFacial_joint);
    if(!`objExists "facial_subCtrl_hold"`){
        createNode "transform" -n "facial_subCtrl_hold";
    }
    if(!`objExists "facial_subCtrlGrp"`){
        createNode "transform" -n "facial_subCtrlGrp";
    }
    if(!`objExists "facial_subBaseGrp"`){
        createNode "transform" -n "facial_subBaseGrp";
    }
    if(!`objExists "facial_subCtrlData"`){
        createNode "transform" -n "facial_subCtrlData";
    }
    
    for($i=0;$i<size($bb_subFacial_joint);$i++){
        //建立控制器
        string $ctrl = substituteAllString($bb_subFacial_joint[$i], "Joint", "ctrl");
        string $Follicle = substituteAllString($bb_subFacial_joint[$i], "Joint", "Follicle");
        string $midJoint[] = {"LipUpperMid_Joint","LipLowerMid_Joint","BrowM_Joint","NoseMid_Joint","ChinMid_Joint","NoseUpper_Joint","NoseLower_Joint"};
        int $Color;
        int $Shape = 2;
        if(`gmatch $bb_subFacial_joint[$i] "*Left*"`){
            $Color = 13;
        }
        if(`gmatch $bb_subFacial_joint[$i] "*Right*"`){
            $Color = 19;
        }
        if(stringArrayContains($bb_subFacial_joint[$i], $midJoint)){
            $Color = 23;
        }
        
        if(`gmatch $bb_subFacial_joint[$i] "Lip*"` || `gmatch $bb_subFacial_joint[$i] "Nose*"`){
            $Shape = 1;
        }
        if($bb_subFacial_joint[$i] == "NoseMid_Joint"){
            $Shape = 3;
        }        
        bb_subFacial_createShape($Shape,$Color,$ctrl);
        
        createNode "transform" -n ($ctrl+"Env");
        createNode "transform" -n ($ctrl+"P");
        createNode "transform" -n ($ctrl+"Drv");
        parent ($ctrl+"Env") "facial_subCtrlGrp" ;
        parent ($ctrl+"Drv") ($ctrl+"Env") ;
        parent ($ctrl+"P") ($ctrl+"Drv") ;
        parent $ctrl ($ctrl+"P") ;
        if(`gmatch $bb_subFacial_joint[$i] "*Right*"`){
            setAttr ($ctrl+"Env.sx") -1;
        }
        clear $bb_subFacial_ctrl;
        $bb_subFacial_ctrl[$i] = ($ctrl+"Env");
        string $Constraint[] = `pointConstraint -weight 1 $Follicle ($ctrl+"Env")`;
        delete $Constraint;
    
        //建立数据组
        createNode "transform" -n ($bb_subFacial_joint[$i] + "Env");
        createNode "transform" -n ($bb_subFacial_joint[$i] + "Reverse");
        createNode "transform" -n ($bb_subFacial_joint[$i] + "Value");
        parent ($bb_subFacial_joint[$i] + "Env") "facial_subCtrlData" ;
        parent ($bb_subFacial_joint[$i] + "Reverse") ($bb_subFacial_joint[$i] + "Env") ;
        parent ($bb_subFacial_joint[$i] + "Value") ($bb_subFacial_joint[$i] + "Reverse") ;
        if(`gmatch $bb_subFacial_joint[$i] "*Right*"`){
            setAttr ($bb_subFacial_joint[$i]+"Env.sx") -1;
        }
        
        $Constraint = `pointConstraint -weight 1 $Follicle ($bb_subFacial_joint[$i] + "Env")`;
        delete $Constraint;
        connectAttr -f ($ctrl + "Env.translate") ($bb_subFacial_joint[$i] + "Env.translate");
        connectAttr -f ($ctrl + "Env.rotate") ($bb_subFacial_joint[$i] + "Env.rotate");
    }
    if(`objExists "LipUpperMid_ctrlEnv"` && !`objExists "LipMain_ctrl"`){
        bb_subFacial_createShape(4,2,"LipMain_ctrl");
        bb_subFacial_createGroup("LipMain_ctrl");
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "LipUpperMid_ctrlEnv" "LipLowerMid_ctrlEnv" "LipMain_ctrlEnv"`;
        delete $pointConstraint;
        bb_subFacial_createShape(7,23,"LipCornerLeft_ctrl");
        bb_subFacial_createGroup("LipCornerLeft_ctrl");
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "LipLeft_ctrl" "LipCornerLeft_ctrlEnv"`;
        delete $pointConstraint;
        bb_subFacial_createShape(7,23,"LipCornerRight_ctrl");
        bb_subFacial_createGroup("LipCornerRight_ctrl");
        setAttr "LipCornerRight_ctrlEnv.sx" -1;
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "LipRight_ctrl" "LipCornerRight_ctrlEnv"`;
        delete $pointConstraint;
    }
    if(`objExists "BrowM_ctrlEnv"` && !`objExists "BrowLeft_ctrl"`){
        bb_subFacial_createShape(4,2,"BrowLeft_ctrl");
        bb_subFacial_createGroup("BrowLeft_ctrl");
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "BrowLeft2_Joint" "BrowLeft_ctrlEnv"`;
        delete $pointConstraint;
        bb_subFacial_createShape(4,2,"BrowRight_ctrl");
        bb_subFacial_createGroup("BrowRight_ctrl");
        setAttr "BrowRight_ctrlEnv.sx" -1;
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "BrowRight2_Joint" "BrowRight_ctrlEnv"`;
        delete $pointConstraint;
    }
    if(`objExists "CheekLeft_Joint"` && !`objExists "CheekTopLeft_ctrl"`){
        bb_subFacial_createShape(4,2,"CheekTopLeft_ctrl");
        bb_subFacial_createGroup("CheekTopLeft_ctrl");
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "CheekMidLeft_Joint" "CheekUpperLeft_Joint" "CheekTopLeft_ctrlEnv"`;
        delete $pointConstraint;
        bb_subFacial_createShape(4,2,"CheekTopRight_ctrl");
        bb_subFacial_createGroup("CheekTopRight_ctrl");
        setAttr "CheekTopRight_ctrlEnv.sx" -1;
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "CheekMidRight_Joint" "CheekUpperRight_Joint" "CheekTopRight_ctrlEnv"`;
        delete $pointConstraint;
    }
    if(`objExists "NasalLabialFoldUpperLeft_Joint"` && !`objExists "NasalLabialFoldLeft_ctrl"`){
        bb_subFacial_createShape(3,2,"NasalLabialFoldLeft_ctrl");
        bb_subFacial_createGroup("NasalLabialFoldLeft_ctrl");
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "NasalLabialFoldUpperLeft_Joint" "NasalLabialFoldLowerLeft_Joint" "NasalLabialFoldLeft_ctrlEnv"`;
        delete $pointConstraint;
        bb_subFacial_createShape(3,2,"NasalLabialFoldRight_ctrl");
        bb_subFacial_createGroup("NasalLabialFoldRight_ctrl");
        setAttr "NasalLabialFoldRight_ctrlEnv.sx" -1;
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "NasalLabialFoldUpperRight_Joint" "NasalLabialFoldLowerRight_Joint" "NasalLabialFoldRight_ctrlEnv"`;
        delete $pointConstraint;
    }
    if(`objExists "EarLeft_Joint"` && !`objExists "EarLeft_ctrl"`){
        bb_subFacial_createShape(5,13,"EarLeft_ctrl");
        bb_subFacial_createGroup("EarLeft_ctrl");
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "EarLeft_Joint" "EarLeft_ctrlEnv"`;
        delete $pointConstraint;
        bb_subFacial_createShape(5,19,"EarRight_ctrl");
        bb_subFacial_createGroup("EarRight_ctrl");
        setAttr "EarRight_ctrlEnv.sx" -1;
        string $pointConstraint[] = `pointConstraint -offset 0 0 0 -weight 1 "EarRight_Joint" "EarRight_ctrlEnv"`;
        delete $pointConstraint;
    }
}
global proc bb_subFacial_createGroup(string $ctrlName)
{
    group -n ($ctrlName + "P") $ctrlName;
    group -n ($ctrlName + "Drv")($ctrlName + "P");
    group -n ($ctrlName + "Env")($ctrlName + "Drv");
    parent ($ctrlName + "Env") "facial_subCtrlGrp" ;
}

global proc bb_subFacial_createShape(int $shapeStyle,int $shapeColor,string $ctrlName)
{
    switch($shapeStyle){
        case 1://球
            curve -d 1 -p 0 1 0 -p 0.5 0.866025 0 -p 0.866025 0.5 0 -p 1 0 0 -p 0.866025 -0.5 0 -p 0.5 -0.866025 0 -p 0 -1 0 -p -0.5 -0.866025 0 -p -0.866025 -0.5 0 
            -p -1 0 0 -p -0.866025 0.5 0 -p -0.5 0.866025 0 -p 0 1 0 -p 0 0.866025 -0.5 -p 0 0.5 -0.866025 -p 0 0 -1 -p 0 -0.5 -0.866025 -p 0 -0.866025 -0.5 
            -p 0 -1 0 -p 0 -0.866025 0.5 -p 0 -0.5 0.866025 -p 0 0 1 -p 0 0.5 0.866025 -p 0 0.866025 0.5 -p 0 1 0 -p 0 0.866025 -0.5 -p 0 0.5 -0.866025 -p 0 0 -1 
            -p 0.5 0 -0.866025 -p 0.866025 0 -0.5 -p 1 0 0 -p 0.866025 0 0.5 -p 0.5 0 0.866025 -p 0 0 1 -p -0.5 0 0.866025 -p -0.866025 0 0.5 -p -1 0 0 -p -0.866025 0 -0.5 
            -p -0.5 0 -0.866025 -p 0 0 -1 -k 0 -k 1 -k 2 -k 3 -k 4 -k 5 -k 6 -k 7 -k 8 -k 9 -k 10 -k 11 -k 12 -k 13 -k 14 -k 15 -k 16 -k 17 -k 18 -k 19 -k 20 -k 21 -k 22 
            -k 23 -k 24 -k 25 -k 26 -k 27 -k 28 -k 29 -k 30 -k 31 -k 32 -k 33 -k 34 -k 35 -k 36 -k 37 -k 38 -k 39 -n $ctrlName;
            break;
        case 2://圆环
            circle -nr 0 0 1 -c 0 0 0 -constructionHistory 0 -n $ctrlName;
            break;
        case 3://鼻子
            curve -d 3 -p -1 2 0 -p -1 1 0 -p -1 0 0 -p -1 -1 0 -p -1 -2 0 -p 0 -2 0 -p 1 -2 0 -p 1 -1 0 -p 1 0 0 -p 1 1 0 -p 1 2 0 -p 0 2 0 -k 0 
            -k 0 -k 0 -k 1 -k 2 -k 3 -k 4 -k 5 -k 6 -k 7 -k 8 -k 9 -k 9 -k 9 -n $ctrlName;
            closeCurve -ch 1 -ps 0 -rpo 1 -bb 1 -bki 1 -p 0.1 $ctrlName;
            break;
        case 4://嘴,眉毛
            curve -d 3 -p -2 -1 0 -p -1 -1 0 -p 0 -1 0 -p 1 -1 0 -p 2 -1 0 -p 2 0 0 -p 2 1 0 -p 1 1 0 -p 0 1 0 -p -1 1 0 -p -2 1 0 -p -2 0 0 -k 0 
            -k 0 -k 0 -k 1 -k 2 -k 3 -k 4 -k 5 -k 6 -k 7 -k 8 -k 9 -k 9 -k 9 -n $ctrlName;
            closeCurve -ch 1 -ps 0 -rpo 1 -bb 1 -bki 1 -p 0.1 $ctrlName;
            break;
        case 5://耳朵
            curve -d 3 -p 0 2 0 -p 0 1.414213 -1.06066 -p 0 0 -1.5 -p 0 -1.414213 -1.06066 -p 0 -2 0 -p 0 -1.414214 1.06066 -p 0 0 1.5 -p 0 1.414213 1.06066 
            -k 0 -k 0 -k 0 -k 1.391147 -k 2.782293 -k 4.083702 -k 5.38511 -k 6.776257 -k 6.776257 -k 6.776257 -n $ctrlName;
            closeCurve -ch 1 -ps 0 -rpo 1 -bb 1 -bki 1 -p 0.1 $ctrlName;
            break;
        case 7://嘴角
            curve -d 1 -p -1 1 0 -p -1 -1 0 -p 1 0 0 -p -1 1 0 -k 0 -k 1 -k 2 -k 3 -n $ctrlName;
            break;    
    }
    string $shape[] = `listRelatives -shapes $ctrlName`;
    if(size($shape)>0){
        for($i=0;$i<size($shape);$i++){
            setAttr ($shape[$i]+".overrideEnabled") 1;
            setAttr ($shape[$i]+".overrideColor") ($shapeColor-1);
        }   
    }
}

//整理层级
global proc bb_subFacial_cleanUp()
{
    global string $bb_subFacial_joint[];
    for($i=0;$i<size($bb_subFacial_joint);$i++){
        string $ctrl = substituteAllString($bb_subFacial_joint[$i], "Joint", "ctrl");
        string $Follicle = substituteAllString($bb_subFacial_joint[$i], "Joint", "Follicle");
        bb_subFacial_data2Env($ctrl);
        disconnectAttr ($ctrl + "Env.translate") ($bb_subFacial_joint[$i] + "Env.translate");
        disconnectAttr ($ctrl + "Env.rotate") ($bb_subFacial_joint[$i] + "Env.rotate");

        setAttr -lock true -keyable false -channelBox false ($ctrl+".sx");
        setAttr -lock true -keyable false -channelBox false ($ctrl+".sy");
        setAttr -lock true -keyable false -channelBox false ($ctrl+".sz");

        createNode "transform" -n ($ctrl+"Base");
        parent ($ctrl+"Base") "facial_subBaseGrp" ;
        string $Constraint[] = `parentConstraint -weight 1 ($ctrl+"Env") ($ctrl+"Base")`;
        delete $Constraint; 
        parentConstraint -mo -weight 1 $Follicle ($ctrl+"Base");
        connectAttr -f ($ctrl + "Base.translate") ($ctrl + "Env.translate");
        connectAttr -f ($ctrl + "Base.rotate") ($ctrl + "Env.rotate");
        
        parentConstraint -mo -weight 1 $Follicle ($bb_subFacial_joint[$i] + "Env");
        parentConstraint -mo -weight 1 "facial_subCtrl_hold" ($bb_subFacial_joint[$i] + "Reverse");
        string $valueCon[] = `parentConstraint -mo -weight 1 $ctrl ($bb_subFacial_joint[$i] + "Value")`;    
        connectAttr -f ($bb_subFacial_joint[$i] + "Reverse.translate") ($valueCon[0]+".target[0].targetOffsetTranslate");
        connectAttr -f ($bb_subFacial_joint[$i] + "Reverse.rotate") ($valueCon[0]+".target[0].targetOffsetRotate");
        parentConstraint -mo -weight 1 ($bb_subFacial_joint[$i] + "Value") $bb_subFacial_joint[$i]; 
    }
    if(`objExists "NoseMid_ctrl"`){
        parent "NoseLeft_ctrlEnv" "NoseMid_ctrl" ;
        parent "NoseRight_ctrlEnv" "NoseMid_ctrl" ;
        parent "NoseUpper_ctrlEnv" "NoseMid_ctrl" ;
        parent "NoseLower_ctrlEnv" "NoseMid_ctrl" ;
        parent "NoseLeft_ctrlBase" "NoseMid_ctrlBase" ;
        parent "NoseRight_ctrlBase" "NoseMid_ctrlBase" ;
        parent "NoseUpper_ctrlBase" "NoseMid_ctrlBase" ;
        parent "NoseLower_ctrlBase" "NoseMid_ctrlBase" ;
        setAttr "NoseRight_ctrlEnv.s" -1 1 1;
    }
    if(`objExists "LipUpperMid_ctrlEnv"`){
        bb_subFacial_data2Env("LipMain_ctrl");
        bb_subFacial_data2Env("LipCornerLeft_ctrl");
        bb_subFacial_data2Env("LipCornerRight_ctrl");
        group -n "LipSub_Env" "LipUpperMid_ctrlEnv" "LipUpperLeft1_ctrlEnv" "LipUpperLeft2_ctrlEnv" "LipLowerLeft2_ctrlEnv" "LipLowerLeft1_ctrlEnv" 
        "LipLowerMid_ctrlEnv" "LipLowerRight1_ctrlEnv" "LipLowerRight2_ctrlEnv" "LipUpperRight2_ctrlEnv" "LipUpperRight1_ctrlEnv" "LipLeft_ctrlEnv" "LipRight_ctrlEnv";
        parent "LipSub_Env" "LipMain_ctrl" ;
        bb_subFacial_LipCorner;
    }
    if(`objExists "BrowLeft_ctrl"`){
        bb_subFacial_data2Env("BrowLeft_ctrl");
        group -n "BrowLeftSub_Env" "BrowLeft1_ctrlEnv" "BrowLeft2_ctrlEnv" "BrowLeft3_ctrlEnv";
        parent "BrowLeftSub_Env" "BrowLeft_ctrl" ;
        bb_subFacial_data2Env("BrowRight_ctrl");
        group -n "BrowRightSub_Env" "BrowRight1_ctrlEnv" "BrowRight2_ctrlEnv" "BrowRight3_ctrlEnv";
        parent "BrowRightSub_Env" "BrowRight_ctrl" ;
    }
    if(`objExists "CheekTopLeft_ctrl"`){
        bb_subFacial_data2Env("CheekTopLeft_ctrl");
        group -n "CheekTopLeftSub_Env" "CheekInnerLeft_ctrlEnv" "CheekMidLeft_ctrlEnv" "CheekOutterLeft_ctrlEnv" "CheekUpperLeft_ctrlEnv";
        parent "CheekTopLeftSub_Env" "CheekTopLeft_ctrl" ;
        bb_subFacial_data2Env("CheekTopRight_ctrl");
        group -n "CheekTopRightSub_Env" "CheekInnerRight_ctrlEnv" "CheekMidRight_ctrlEnv" "CheekOutterRight_ctrlEnv" "CheekUpperRight_ctrlEnv";
        parent "CheekTopRightSub_Env" "CheekTopRight_ctrl" ;
        bb_subFacial_data2Env("NasalLabialFoldLeft_ctrl");
        group -n "NasalLabialFoldLeftSub_Env" "NasalLabialFoldUpperLeft_ctrlEnv" "NasalLabialFoldLowerLeft_ctrlEnv";
        parent "NasalLabialFoldLeftSub_Env" "NasalLabialFoldLeft_ctrl" ;
        bb_subFacial_data2Env("NasalLabialFoldRight_ctrl");
        group -n "NasalLabialFoldRightSub_Env" "NasalLabialFoldUpperRight_ctrlEnv" "NasalLabialFoldLowerRight_ctrlEnv";
        parent "NasalLabialFoldRightSub_Env" "NasalLabialFoldRight_ctrl" ;
    }
    if(`objExists "EarLeft_Joint"`){
        parentConstraint -mo -weight 1 EarLeft_ctrl EarLeft_Joint;
        parentConstraint -mo -weight 1 EarRight_ctrl EarRight_Joint;
    }
    if(!`objExists "facial_subCtrl_NoTransforms"`){
        createNode "transform" -n "facial_subCtrl_NoTransforms";
    }
    parent "facial_folliceGrp" "facial_subCtrl_NoTransforms" ;
    parent "facial_subCtrl_hold" "facial_subCtrl_NoTransforms" ;
    parent "facial_subBaseGrp" "facial_subCtrl_NoTransforms" ;
    parent "facial_subCtrlData" "facial_subCtrl_NoTransforms" ;
    if(`objExists "facialMain_crv"`){
        connectAttr -f "facialMain_crv.FacialSubCtrl" "facial_subCtrlGrp.visibility";
    }
    setAttr "facial_folliceGrp.v" 0;
}
//嘴角联动
global proc bb_subFacial_LipCorner()
{
    string $JointLip[] = {"LipUpperMid_Joint","LipUpperLeft1_Joint","LipUpperLeft2_Joint","LipLowerLeft2_Joint","LipLowerLeft1_Joint","LipLeft_Joint",
                          "LipLowerMid_Joint","LipLowerRight1_Joint","LipLowerRight2_Joint","LipUpperRight2_Joint","LipUpperRight1_Joint","LipRight_Joint"};
    for($i=0;$i<size($JointLip);$i++){
        string $Env = substituteAllString($JointLip[$i], "Joint", "ctrlEnv");
        string $Con = substituteAllString($JointLip[$i], "Joint", "ctrlCon");
        string $ConAim[] = `duplicate -parentOnly -n $Con $Env`;
        makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1 $ConAim;
        parent $Env $ConAim[0];
        float $Weight0,$Weight1;
        if(`gmatch $JointLip[$i] "*Left1_*"`){
            string $conNode[] = `parentConstraint -mo -weight 1 "LipMain_ctrl" "LipCornerLeft_ctrl" $ConAim[0]`;
            setAttr ($conNode[0] + ".LipMain_ctrlW0") 0.6;
            setAttr ($conNode[0] + ".LipCornerLeft_ctrlW1") 0.4;
        }
        if(`gmatch $JointLip[$i] "*Left2_*"`){
            string $conNode[] = `parentConstraint -mo -weight 1 "LipMain_ctrl" "LipCornerLeft_ctrl" $ConAim[0]`;
            setAttr ($conNode[0] + ".LipMain_ctrlW0") 0.05;
            setAttr ($conNode[0] + ".LipCornerLeft_ctrlW1") 0.95;
        }
        if(`gmatch $JointLip[$i] "*Left_*"`){
            parentConstraint -mo -weight 1 "LipCornerLeft_ctrl" $ConAim[0];
        }
        if(`gmatch $JointLip[$i] "*Right1_*"`){
            string $conNode[] = `parentConstraint -mo -weight 1 "LipMain_ctrl" "LipCornerRight_ctrl" $ConAim[0]`;
            setAttr ($conNode[0] + ".LipMain_ctrlW0") 0.6;
            setAttr ($conNode[0] + ".LipCornerRight_ctrlW1") 0.4;
        }
        if(`gmatch $JointLip[$i] "*Right2_*"`){
            string $conNode[] = `parentConstraint -mo -weight 1 "LipMain_ctrl" "LipCornerRight_ctrl" $ConAim[0]`;
            setAttr ($conNode[0] + ".LipMain_ctrlW0") 0.05;
            setAttr ($conNode[0] + ".LipCornerRight_ctrlW1") 0.95;
        }
        if(`gmatch $JointLip[$i] "*Right_*"`){
            parentConstraint -mo -weight 1 "LipCornerRight_ctrl" $ConAim[0];
        }
        if(`gmatch $JointLip[$i] "*Mid_*"`){
            string $conNode[] = `parentConstraint -mo -weight 1 "LipMain_ctrl" "LipCornerLeft_ctrl" "LipCornerRight_ctrl" $ConAim[0]`;
            setAttr ($conNode[0] + ".LipMain_ctrlW0") 0.95;
            setAttr ($conNode[0] + ".LipCornerLeft_ctrlW1") 0.05;
            setAttr ($conNode[0] + ".LipCornerRight_ctrlW2") 0.05;
        }
    }
}

//控制器数值归ENV层
global proc bb_subFacial_data2Env(string $ctrl)
{
    float $sx = `getAttr ($ctrl + "Env.sx")`;
    
    float $t[] = `xform -q -ws -t $ctrl`;
    float $r[] = `xform -q -ws -ro $ctrl`;
    xform -ws -t $t[0] $t[1] $t[2] ($ctrl + "Env");
    float $RY;
    if($sx < 0){
        $RY = 180 - $r[1];
    }
    else{
        $RY = $r[1];
    }
    xform -ws -ro $r[0] $RY $r[2] ($ctrl + "Env");
    setAttr ($ctrl + ".t") 0 0 0;
    setAttr ($ctrl + ".r") 0 0 0;
    setAttr -lock true -keyable false -channelBox false ($ctrl+".v");
    makeIdentity -apply true -s 1 -n 0 -pn 1 $ctrl;
}
  
//控制器左右方向镜像
global proc bb_subFacial_mirrorCtrl()
{
    string $sel[] = `ls -sl "*Left*"`;
    for($i=0;$i<size($sel);$i++){
        float $r[] = `getAttr ($sel[$i] + ".r")`;
        float $t[] = `getAttr ($sel[$i] + ".t")`;
        float $s[] = `getAttr ($sel[$i] + ".s")`;
        string $rightCtrl = substituteAllString($sel[$i], "Left", "Right");
        setAttr ($rightCtrl + ".r") $r[0] $r[1] $r[2]; 
        setAttr ($rightCtrl + ".t") $t[0] $t[1] $t[2]; 
        setAttr ($rightCtrl + ".s") $s[0] $s[1] $s[2]; 
        blendShape -n ($sel[$i] + "_MirrorBS") $sel[$i] $rightCtrl;
        blendShape -edit -w 0 1 ($sel[$i] + "_MirrorBS");
        select -r $rightCtrl;
        DeleteHistory;  
    }
    select -r $sel;
}


global proc bb_subFacial_mirrorJoint()
{
    string $sel[] = `ls -sl "*Left*" `;
    for($i=0;$i<size($sel);$i++){
        if(`nodeType $sel[$i]` == "joint"){
            float $t[] = `getAttr ($sel[$i] + ".t")`;
            string $rightEnv = substituteAllString($sel[$i], "Left", "Right");
            if(`objExists $rightEnv`){
                setAttr ($rightEnv + ".t") (-1*$t[0]) $t[1] $t[2]; 
            }
        }
    }
}

global proc bb_subFacial_mirrorFollice()
{
    string $sel[] = `ls -sl "*Left*" `;
    for($i=0;$i<size($sel);$i++){
        string $shape[] = `listRelatives -s -f $sel[$i]`;
        if(`nodeType $shape[0]` == "follicle"){
            float $u = `getAttr ($shape[0] + ".parameterU")`;
            float $v = `getAttr ($shape[0] + ".parameterV")`;
            string $rightFollicle = substituteAllString($sel[$i], "Left", "Right");
            if(`objExists $rightFollicle`){
                string $rightShape[] = `listRelatives -s -f $rightFollicle`;
                setAttr ($rightShape[0] + ".parameterU") (1-$u); 
                setAttr ($rightShape[0] + ".parameterV") $v; 
            }
        }
    }
}

global proc bb_subFacial_reCon()
{
    string $sel[] = `ls -sl -type "joint"`;
    global string $bb_subFacial_joint[];
    for($i=0;$i<size($sel);$i++){
        if(stringArrayContains($sel[$i], $bb_subFacial_joint)){
            string $con[] = `listConnections -d off -s on $sel[$i]`;
            if(size($con)>0){
                string $Value[] = `listConnections -d off -s on ($con[0]+".target[0].targetTranslate")`;
                delete $con[0];
                setAttr ($sel[$i] + ".r") 0 0 0;
                parentConstraint -mo -weight 1 $Value[0] $sel[$i];
            }
        }
    }
}
