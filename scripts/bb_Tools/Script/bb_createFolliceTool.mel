global proc bb_createFolliceTool()
{
    if (`window -q -exists bb_createFolliceToolWindow`) deleteUI bb_createFolliceToolWindow;
    window -title "创建毛囊工具" -toolbox 1  bb_createFolliceToolWindow;    
        columnLayout -adjustableColumn true -columnAttach "both" 3;
            rowLayout -numberOfColumns 2 -columnWidth2 150 80 ;
                textField -w 150 -text "" bb_createFolliceTool_meshTF;
                button -w 80 -label "<<<载入模型" -bgc 1 0.95 0.5 -c "bb_createFollice_loadGeo(0)";
            setParent ..;
            rowLayout -numberOfColumns 2 -columnWidth2 150 80 ;
                textField -w 150 -text "" bb_createFolliceTool_locTF;
                button -w 80 -label "<<<Locator" -bgc 1 0.95 0.5 -c "bb_createFollice_loadGeo(1)";
            setParent ..;
            separator -height 10 -style "in"; 
            button -l "执行" -h 40 -w 115 -bgc 0.1 0.1 0.1 -c bb_createFollice;
    showWindow bb_createFolliceToolWindow;
}
bb_createFolliceTool;

global proc bb_createFollice_loadGeo(int $mode)
{
    string $selGeo[] = `ls -sl`;
    if (size($selGeo)>0){
        if($mode == 0){
            textField -e -text $selGeo[0] bb_createFolliceTool_meshTF;
        }
        else if($mode == 1){
            string $text = stringArrayToString($selGeo, ",");
            textField -e -text $text bb_createFolliceTool_locTF;
        }
    }
}

//根据点创建毛囊
global proc bb_createFollice()
{
    string $loc = `textField -q -text bb_createFolliceTool_locTF`;
    string $bb_loc[] = stringToStringArray($loc, ",");//位置
    
    string $baseMod = `textField -q -text bb_createFolliceTool_meshTF`;//模型名称
    if(!`objExists "bb_folliceGrp"`){
        createNode "transform" -n "bb_folliceGrp";
    }
    for($i=0;$i<size($bb_loc);$i++){
        string $cpomNode;
        string $shape[] = `listRelatives -shapes -fullPath $baseMod`;
        string $folliceNode = `createNode "follicle" -n ($bb_loc[$i] + "_follicleShape")`;
        string $folliceTran[] = `listRelatives -p -path $folliceNode`;
        float $maxU = 1;
        float $maxV = 1;
        if(`nodeType $shape[0]`=="mesh"){
            $cpomNode = `createNode "closestPointOnMesh" -n ($bb_loc[$i]+"_CPM")`;
            connectAttr -f ($shape[0] + ".worldMesh") ($cpomNode + ".inMesh");
            connectAttr -f ($shape[0] + ".worldMatrix") ($cpomNode + ".inputMatrix");
            connectAttr -f ($shape[0] + ".outMesh") ($folliceNode + ".inputMesh");
            connectAttr -f ($bb_loc[$i] + ".worldPosition[0]") ($cpomNode + ".inPosition");
        }
        else if(`nodeType $shape[0]`=="nurbsSurface"){
            $cpomNode = `createNode "closestPointOnSurface" -n ($bb_loc[$i]+"_CPS")`;
            connectAttr -f ($shape[0] + ".worldSpace") ($cpomNode + ".inputSurface");
            connectAttr -f ($shape[0] + ".local") ($folliceNode + ".inputSurface");
            connectAttr -f ($bb_loc[$i] + ".worldPosition[0]") ($cpomNode + ".inPosition");
            $maxU = getAttr ($shape[0] + ".minMaxRangeU.maxValueU");
            $maxV = getAttr ($shape[0] + ".minMaxRangeV.maxValueV");
        }
        connectAttr -f ($shape[0] + ".worldMatrix") ($folliceNode + ".inputWorldMatrix");
        connectAttr -f ($folliceNode + ".outTranslate") ($folliceTran[0] + ".translate");
        connectAttr -f ($folliceNode + ".outRotate") ($folliceTran[0] + ".rotate");
        float $cpomNodeU = getAttr ($cpomNode + ".result.parameterU");
        float $cpomNodeV = getAttr ($cpomNode + ".result.parameterV");
        string $exp = $folliceNode + ".parameterU = " + $cpomNode + ".result.parameterU /" + $maxU + ";\n"+
                      $folliceNode + ".parameterV = " + $cpomNode + ".result.parameterV /" + $maxV + ";"; 
        print $exp;
        //setAttr ($folliceNode + ".parameterU") ($cpomNodeU/$maxU);
        //setAttr ($folliceNode + ".parameterV") ($cpomNodeV/$maxV);
        
        expression -s $exp -o $folliceNode -ae 1 -uc all -n ($folliceTran[0] + "_Exp");
        
        string $newName = $folliceTran[0];//后缀改名
        rename $folliceTran[0] $newName;
        parent $newName "bb_folliceGrp" ;
    }
}

