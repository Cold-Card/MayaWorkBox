}
//改shape
global proc bb_CtrlTool_changeShape()
{
    string $sel[] = `ls -sl`;
    string $CtrlShape = `radioCollection -q -select CtrlShapeChoose`;
    for($i=0;$i<size($sel);$i++){
        string $shape[] =  `listRelatives -s -path $sel[$i]`;
        if(size($shape)>0){
            if(`nodeType $shape[0]` == "nurbsCurve"){
                float $boxMin[] = `getAttr ($sel[$i] + ".boundingBoxMin")`;
                float $boxMax[] = `getAttr ($sel[$i] + ".boundingBoxMax")`;
                float $sx = (abs($boxMin[0]) + abs($boxMax[0]))/2;
                float $sy = (abs($boxMin[1]) + abs($boxMax[1]))/2;
                float $sz = (abs($boxMin[2]) + abs($boxMax[2]))/2;
                float $s = max($sx,$sy);
                $s = max($s,$sz);
                int $color = `getAttr ($shape[0]+".overrideColor")`;
                string $shapeOutput[] = `listConnections -d on -s off -plugs on ($shape[0] + ".instObjGroups[0]")`;//
                delete $shape;
                bb_CtrlTool_createShape($CtrlShape,"bb_CtrlTool_changeShape");
                string $changeShape[] =  `listRelatives -s -path "bb_CtrlTool_changeShape"`;
                setAttr ($changeShape[0]+".overrideEnabled") 1;
                setAttr ($changeShape[0]+".overrideColor") $color;
                setAttr "bb_CtrlTool_changeShape.s" $s $s $s;
                makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1 "bb_CtrlTool_changeShape";
                parent -s -add  $changeShape[0] $sel[$i];
                if(size($shapeOutput))//
                    connectAttr -f ($changeShape[0] + ".instObjGroups[0]") $shapeOutput[0];
                rename $changeShape[0] $shape[0];
                delete "bb_CtrlTool_changeShape";
            }
        }
    }
}
//合并shape
global proc bb_CtrlTool_combineShape()
{
    string $sel[] = `ls -sl`;
    string $parent;
    for($i=0;$i<size($sel);$i++){
        string $shape[] =  `listRelatives -s -path $sel[$i]`;
        if(size($shape)>0){
            if(`nodeType $shape[0]` == "nurbsCurve"){
                if($parent == "")
                    $parent = $sel[$i];
                else{
                    parent -s -add $shape $parent;
                    delete $sel[$i];
                }
            }
        }
    }
}

//形状编辑模式
global string $bb_CtrlTool_EditCtrl[],$bb_CtrlTool_FixCtrl[];

global proc bb_CtrlTool_CtrlShapeEdit()
{
    global string $bb_CtrlTool_EditCtrl[],$bb_CtrlTool_FixCtrl[];
    string $sel[] = `ls -sl`;
    if(!`objExists "bb_CtrlEdit_Grp"`) createNode "transform" -n "bb_CtrlEdit_Grp"; 
    for($i=0;$i<size($sel);$i++){
        if(!`gmatch $sel[$i] "*_bbShapeEdit"`){
            string $shape[] =  `listRelatives -s -f $sel[$i]`;
            if(size($shape)>0){
                if(`nodeType $shape[0]` == "nurbsCurve"){
                    string $replace = $sel[$i] + "_bbShapeEdit";
                    string $replaceDel = $sel[$i] + "_bbShapeEditDel";
                    $bb_CtrlTool_EditCtrl[size($bb_CtrlTool_EditCtrl)] = $sel[$i];
                    $bb_CtrlTool_FixCtrl[size($bb_CtrlTool_FixCtrl)] = $replace;
                    
                    duplicate -rr -po -n $replaceDel $sel[$i];
                    setAttr -lock off -k on ($replaceDel + ".tx");
                    setAttr -lock off -k on ($replaceDel + ".ty");
                    setAttr -lock off -k on ($replaceDel + ".tz");
                    setAttr -lock off -k on ($replaceDel + ".rx");
                    setAttr -lock off -k on ($replaceDel + ".ry");
                    setAttr -lock off -k on ($replaceDel + ".rz");
                    setAttr -lock off -k on ($replaceDel + ".sx");
                    setAttr -lock off -k on ($replaceDel + ".sy");
                    setAttr -lock off -k on ($replaceDel + ".sz");
                    transformLimits -etx 0 0 $replaceDel;
                    transformLimits -ety 0 0 $replaceDel;
                    transformLimits -etz 0 0 $replaceDel;
                    transformLimits -erx 0 0 $replaceDel;
                    transformLimits -ery 0 0 $replaceDel;
                    transformLimits -erz 0 0 $replaceDel;
                    transformLimits -esx 0 0 $replaceDel;
                    transformLimits -esy 0 0 $replaceDel;
                    transformLimits -esz 0 0 $replaceDel;
                    duplicate -rr -po -n ($replace + "_Env") $replaceDel;
    
                    for($j=0;$j<size($shape);$j++){
                        int $intermediate = `getAttr ($shape[$j] + ".intermediateObject")`;
                        if($intermediate != 1){
                            setAttr ($shape[$j] + ".dispEP") 1;
                            parent -s -add $shape[$j] $replaceDel;
                        }
                    }
                    duplicate -rr -inputConnections -n $replace $replaceDel;
                    delete $replaceDel;
    
                    for($j=0;$j<size($shape);$j++){
                        string $conVis[] = `listConnections -d off -s on -p on ($shape[$j] + ".v")`;
                        if(size($conVis)>0)
                            disconnectAttr $conVis[0] ($shape[$j] + ".v");
                        int $lock = `getAttr -l ($shape[$j] + ".v")`;
                        if($lock == 1)
                            setAttr -l 0 ($shape[$j] + ".v");
                        setAttr ($shape[$j] + ".v") 0;
                    }
                    parent $replace ($replace + "_Env");
                    parent ($replace + "_Env") "bb_CtrlEdit_Grp";
                    bb_CtrlTool_changeColorApply($replace,14);
                }
            } 
        }
    }
    select -r $bb_CtrlTool_FixCtrl;
}
//完成形状编辑
global proc bb_CtrlTool_CtrlShapeEditOK()
{
    global string $bb_CtrlTool_EditCtrl[],$bb_CtrlTool_FixCtrl[];
    string $EditCtrl[],$FixCtrl[];
    $EditCtrl = $bb_CtrlTool_EditCtrl;
    $FixCtrl = $bb_CtrlTool_FixCtrl;
    clear $bb_CtrlTool_EditCtrl $bb_CtrlTool_FixCtrl;
    for($i=0;$i<size($FixCtrl);$i++){
        string $FixShape[] =  `listRelatives -s -f $FixCtrl[$i]`;
        string $EditShape[] =  `listRelatives -s -f $EditCtrl[$i]`;
        for($j=0;$j<size($FixShape);$j++){
            int $intermediate = `getAttr ($FixShape[$j] + ".intermediateObject")`;
            if($intermediate != 1){
                int $numCVs = `getAttr -size ($FixShape[$j] + ".controlPoints")`;
                for($k=0;$k<$numCVs;$k++){
                    float $t[] = `xform -q -ws -t ($FixShape[$j] + ".cv[" + $k + "]")`;
                    xform -ws -t $t[0] $t[1] $t[2] ($EditShape[$j] + ".cv[" + $k + "]");
                }
                string $conVis[] = `listConnections -d off -s on -p on ($FixShape[$j] + ".v")`;
                setAttr ($EditShape[$j] + ".v") 1;
                setAttr ($EditShape[$j] + ".dispEP") 0;
                if(size($conVis)>0){
                     connectAttr $conVis[0] ($EditShape[$j] + ".v");
                } 
            }
        }
    }
    delete "bb_CtrlEdit_Grp";
}
