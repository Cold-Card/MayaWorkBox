            -p -2.427052 0 1.763356 -p -1.763356 0 2.427051 -p -0.927051 0 2.85317 -p -8.9407e-008 0 3 -p -5.96046e-008 0 2 -p -0.618034 0 1.902113 -p -1.175571 0 1.618034 
