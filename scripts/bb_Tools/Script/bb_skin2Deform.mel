//Fix     :   2021/02/22   修正提取无权重骨骼点信息时，存在“/”，导致不能导入权重信息的错误。
global proc bb_skin2Deform()
{
    if (`window -q -exists bb_skin2DeformWindow`) deleteUI bb_skin2DeformWindow;
    window -title "权重转换" -resizeToFitChildren 1 bb_skin2DeformWindow;
        columnLayout -adjustableColumn true;
            frameLayout -label "Skin权重转Deform权重";
                columnLayout -adjustableColumn true;
                    button -l "加载skin模型" -h 35 -bgc 0.9 0.9 0.9 -c "bb_skin2Deform_loadSkin" bb_skin2Deform_loadSkinButton;
                    rowColumnLayout -numberOfColumns 2 -columnWidth 1 60 -columnWidth 2 160 bb_skin2Deform_rowColumnLayout;
                        text -l "Skin节点：";
                        textField -tx "None" bb_skin2Deform_skinNode;
                        text -l "Shape：";
                        textField -tx "None" bb_skin2Deform_shape;
                    setParent ..;
            frameLayout -label "添加子窗口";
                columnLayout -adjustableColumn true bb_skin2Deform_columnLayout;
                    rowColumnLayout -numberOfColumns 2 -columnWidth 1 110 -columnWidth 2 110;
                        button -l "选骨骼添加" -bgc 0.5 0.5 0.5 -c "bb_skin2Deform_addLayout(0)";
                        button -l "添加所有骨骼" -c "bb_skin2Deform_addLayout(1)";
                    setParent ..;
                    separator -height 10 -style "in";
    showWindow bb_skin2DeformWindow;
    bb_skin2Deform_resetWin;
}
bb_skin2Deform;

global proc bb_skin2Deform_resetWin()
{
    window -e -h 124 -w 228 bb_skin2DeformWindow;
}

global string $bb_skin2Deform_bindJsList[];
global int $bb_skin2Deform_addLayoutNum;
global proc bb_skin2Deform_loadSkin()
{
    string $getSelection[] = `ls -sl -o`;
	if (size($getSelection)>0 && (`nodeType $getSelection[0]` == "transform")){
	    string $shape[] = `listRelatives -shapes -path $getSelection[0]`;
	    string $skinNode = findRelatedSkinCluster($getSelection[0]);
	    global string $bb_skin2Deform_bindJsList[];
	    clear $bb_skin2Deform_bindJsList;
	    $bb_skin2Deform_bindJsList = `skinCluster -q -influence $skinNode`;
	    textField -e -tx $skinNode bb_skin2Deform_skinNode;
	    textField -e -tx $shape[0] bb_skin2Deform_shape;
	    button -e -l $getSelection[0] bb_skin2Deform_loadSkinButton;
	    if (`layout -exists bb_skin2Deform_addColumnLayout`) deleteUI bb_skin2Deform_addColumnLayout;
        columnLayout -p bb_skin2Deform_columnLayout -adjustableColumn true -columnAttach "both" 2 bb_skin2Deform_addColumnLayout;
        global int $bb_skin2Deform_addLayoutNum;
        $bb_skin2Deform_addLayoutNum = size($bb_skin2Deform_bindJsList);
        bb_skin2Deform_resetWin;
	}
}

global proc bb_skin2Deform_addLayout(int $mod)
{
    global string $bb_skin2Deform_bindJsList[];
    global int $bb_skin2Deform_addLayoutNum;
    if($mod == 0){
        string $selJoint[] = `ls -sl -type "joint"`;
        for($i=0;$i<size($selJoint);$i++){
            if(stringArrayContains($selJoint[$i], $bb_skin2Deform_bindJsList)){
                int $listNum = $bb_skin2Deform_addLayoutNum - size($bb_skin2Deform_bindJsList);
                if($listNum >= 0){
                    bb_skin2Deform_addLayoutApply($selJoint[$i],$listNum);
                    string $remove[];
                    $remove[0] = $selJoint[$i];
                    $bb_skin2Deform_bindJsList = stringArrayRemove($remove, $bb_skin2Deform_bindJsList);
                }
            }
        }
    }
    else if($mod == 1){
        string $bindJsList[] = $bb_skin2Deform_bindJsList;
        for($i=0;$i<size($bindJsList);$i++){
            int $listNum = $bb_skin2Deform_addLayoutNum - size($bindJsList) + $i;
            bb_skin2Deform_addLayoutApply($bindJsList[$i],$listNum);
            string $remove[];
            $remove[0] = $bindJsList[$i];
            $bb_skin2Deform_bindJsList = stringArrayRemove($remove, $bb_skin2Deform_bindJsList);
        }
    }
    if (`button -exists bb_skin2Deform_applyButton`) deleteUI bb_skin2Deform_applyButton;
    button -p bb_skin2Deform_addColumnLayout -l "执行" -h 40 -bgc 0.1 0.1 0.1 -c "bb_skin2Deform_apply" bb_skin2Deform_applyButton;
}

global proc bb_skin2Deform_addLayoutApply(string $joint,int $listNum)
{
    rowColumnLayout -p bb_skin2Deform_addColumnLayout -numberOfColumns 3 -columnWidth 1 90 -columnWidth 2 30 -columnWidth 3 100 ("bb_skin2Deform_addRowColumnLayoutA"+$listNum);
        text -l $joint ("bb_skin2Deform_loadJointTx" + $listNum);
        text -l "--->>" -bgc 0.15 0.15 0.15;
        button -l "加载目标模型" -h 25 -c ("bb_skin2Deform_loadDeform("+$listNum+")") ("bb_skin2Deform_loadDeformButton" + $listNum);
    rowColumnLayout -p bb_skin2Deform_addColumnLayout -numberOfColumns 2 -columnWidth 1 50 -columnWidth 2 170 ("bb_skin2Deform_addRowColumnLayoutB"+$listNum);
        text -l "Deform：";
        textField -en 0 -tx "None" ("bb_skin2Deform_Node" + $listNum);
        setParent ..;
    separator -height 10 -style "in";
}

global proc bb_skin2Deform_loadDeform(string $listNum)
{
    string $getSelection[] = `ls -sl -o`;
    string $deformNode[] = {"blendShape","cluster","deltaMush","tension","ffd","wrap","shrinkWrap","wire","softMod","sculpt","jiggle"};
    if (size($getSelection)>0 && (`nodeType $getSelection[0]` == "transform")){
        string $shape[] = `listRelatives -shapes -path $getSelection[0]`;
        string $bindListHs[] = `listHistory -gl 1 -pdo 1 $getSelection[0]`;
        for($i=0;$i<size($bindListHs);$i++){
    	    if(`nodeType $bindListHs[$i]`!="skinCluster"){
    	        textField -e -en 1 -tx $bindListHs[$i] ("bb_skin2Deform_Node" + $listNum);
    	        button -e -l $shape[0] ("bb_skin2Deform_loadDeformButton" + $listNum);
    	        if(`nodeType $bindListHs[$i]`=="blendShape"){
    	            bb_skin2Deform_loadDeformBS($listNum,$bindListHs[$i]);
    	        }
    	        break;
            }
	    }
    }
	else if (size($getSelection)>0 && (`nodeType $getSelection[1]` == "transform")){
	    string $shape[] = `listRelatives -shapes -path $getSelection[1]`;
        string $selNode = `nodeType $getSelection[0]`;
        if(stringArrayContains($selNode, $deformNode)){
            button -e -l $shape[0] ("bb_skin2Deform_loadDeformButton" + $listNum);
            textField -e -en 1 -tx $getSelection[0] ("bb_skin2Deform_Node" + $listNum);
            if($selNode == "blendShape"){
                bb_skin2Deform_loadDeformBS($listNum,$getSelection[0]);
            }
        }
	}
}

global proc bb_skin2Deform_loadDeformBS(string $listNum,string $nodeName)
{
    string $selAttr[] = `channelBox -q -sha mainChannelBox`;
    string $BSList[];
    string $BSAttrs[] = `aliasAttr -q $nodeName`;
    for ($j=0; $j<size($BSAttrs); $j++){
        if ($j%2 == 0){
            int $wordSize = sizeBytes($BSAttrs[$j+1]);    
            string $listStr = `substring $BSAttrs[$j+1] 8 ($wordSize-1)`;
            int $list = $listStr;
            $BSList[$list] = $BSAttrs[$j];
        }
    }
    if(size($selAttr)){
        if($selAttr[0] != "en"){
            textField -e -tx ($nodeName+"."+$selAttr[0]) ("bb_skin2Deform_Node" + $listNum);
        }
        else{
            textField -e -tx ($nodeName+"."+$BSList[0]) ("bb_skin2Deform_Node" + $listNum);
        }
    }
    else{
        textField -e -tx ($nodeName+"."+$BSList[0]) ("bb_skin2Deform_Node" + $listNum);
    }
}

global proc bb_skin2Deform_apply()
{
    //导出
    string $melPath = `whatIs bb_skin2Deform`;
    string $melPathArray[] = stringToStringArray($melPath, "/");
    stringArrayRemoveAtIndex((size($melPathArray)-1), $melPathArray);
    string $start[] = stringToStringArray($melPathArray[0], " ");
    $melPathArray[0] = $start[size($start)-1];
    string $filePath = stringArrayToString($melPathArray, "/") + "/";
    //string $filePath = "D:/";
    string $skinNode = `textField -q -tx bb_skin2Deform_skinNode`;
    string $skinShape = `textField -q -tx bb_skin2Deform_shape`;
    string $skinObj = `button -q -l bb_skin2Deform_loadSkinButton`;
    select -r $skinShape;
    deformerWeights -export -deformer $skinNode -path $filePath "bb_skin2Deform_weight.xml";
    
    global string $bb_skin2Deform_bindJsList[];
    global int $bb_skin2Deform_addLayoutNum;
    
    //读取基本信息
    int $numVtx[] = `polyEvaluate -vertex $skinShape`;
    string $file = $filePath + "bb_skin2Deform_weight.xml";
    int $fileId = `fopen $file "r"`;
    string $nextWord = `fgetword $fileId "\n"`;
    string $write1[],$write2[],$writeArray[];
    string $information,$informationFix;
    int $x = 0;
    bb_skin2Deform_progress(($numVtx[0]+5),("正在提取点信息..."));
    while ( size($nextWord) > 0 ) {
        if(!`gmatch $nextWord "  <weights*"`){
            $write1[$x] = $nextWord;
            $x++;
            progressBar -edit -step 1 bb_skin2Deform_progress_win;
        }
        else if(`gmatch $nextWord "  <weights*"`){
            $information = substituteAllString($nextWord, "/", "");
            break;
        }
        $nextWord = `fgetword $fileId "\n"`; 
    }
    deleteUI bb_skin2Deform_progressWindow;
    //
    int $applyNum = $bb_skin2Deform_addLayoutNum - size($bb_skin2Deform_bindJsList);
    for($i=0;$i<$applyNum;$i++){
        int $none = `textField -q -en ("bb_skin2Deform_Node" + $i)`;
        if($none == 1){
            clear $write2;
            string $Deform = `textField -q -tx ("bb_skin2Deform_Node" + $i)`;
            string $DeformArray[] = stringToStringArray($Deform, ".");
            string $DeformShape = `button -q -l ("bb_skin2Deform_loadDeformButton" + $i)`;
            string $information1Array[] = stringToStringArray($information, "\"");
            if(size($DeformArray) == 1){
                $informationFix = $information1Array[0] + "\"" + $DeformArray[0] + "\"" + $information1Array[2] + "\"baseLayer\"" + $information1Array[4] + "\"" +
                                  $DeformShape + "\"" + $information1Array[6] + "\"" + $information1Array[7] + "\"" + $information1Array[8] + "\"" + $information1Array[9] + "\"" + 
                                  $information1Array[10] + "\"" + $numVtx[0] + "\"" + $information1Array[12] + "\"" + $numVtx[0] + "\"" + $information1Array[14];
            }
            else if(size($DeformArray) == 2){
                $informationFix = $information1Array[0] + "\"" + $DeformArray[0] + "\"" + $information1Array[2] + "\"" + $DeformArray[1] + "\"" + $information1Array[4] + "\"" +
                                  $DeformShape + "\"" + $information1Array[6] + "\"" + $information1Array[7] + "\"" + $information1Array[8] + "\"" + $information1Array[9] + "\"" + 
                                  $information1Array[10] + "\"" + $numVtx[0] + "\"" + $information1Array[12] + "\"" + $numVtx[0] + "\"" + $information1Array[14];
            }
            $write2[0] = $informationFix;
            string $Joint = `text -q -l ("bb_skin2Deform_loadJointTx" + $i)`;
            bb_skin2Deform_progress($numVtx[0],("正在提取" + $Joint + "权重信息..."));
            for ($j=0; $j<$numVtx[0]; $j++){
                string $objVtx = ($skinShape + ".vtx["+ $j +"]");
                float $weight = `skinPercent -transform $Joint -query $skinNode $objVtx`;
                $write2[$j+1] = "    <point index=\"" + $j + "\" value=\"" + $weight + "\"/>";
                progressBar -edit -step 1 bb_skin2Deform_progress_win;
            }
            $write2[size($write2)] = "  </weights>" + "\n</deformerWeight>";
            $writeArray = stringArrayCatenate($write1, $write2);
            
            bb_skin2Deform_progress(size($writeArray),("正在写入" + $Deform + "权重信息..."));
            string $fileNew = $filePath + "bb_skin2Deform_weight" + $i + ".xml";
            int $fileId = `fopen $fileNew "w"`;
            for($j=0; $j<size($writeArray); $j++){
                fprint $fileId ($writeArray[$j] + "\n");
                progressBar -edit -step 1 bb_skin2Deform_progress_win;
            }
            fclose $fileId;
            deleteUI bb_skin2Deform_progressWindow;
            //导入
            select -r $DeformShape;
            deformerWeights -import -method "index" -deformer $DeformArray[0] -path $filePath ("bb_skin2Deform_weight" + $i + ".xml");
            sysFile -delete ($filePath + "bb_skin2Deform_weight" + $i + ".xml");
        }
    }
    sysFile -delete ($filePath + "bb_skin2Deform_weight.xml");
}

global proc bb_skin2Deform_progress(int $maxValue,string $title)
{
    if (`window -q -exists bb_skin2Deform_progressWindow`) deleteUI bb_skin2Deform_progressWindow;
    window -title $title -toolbox 1 bb_skin2Deform_progressWindow;    
        columnLayout -adjustableColumn true -columnAttach "both" 3;
            progressBar -maxValue $maxValue -width 300 bb_skin2Deform_progress_win;
    showWindow bb_skin2Deform_progressWindow;
}

