        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "TAG2CopySkinWeights();\n\nglobal proc TAG2CopySkinWeights()\n{\nif (`window -ex TAG2CopySkinWeights`) {deleteUI TAG2CopySkinWeights;}\nstring $windowName =`window -title \"TAG2CopySkinWeights\" TAG2CopySkinWeights`;\n//string $progress = \"\";\n\ncolumnLayout -adjustableColumn true;\nrowLayout -numberOfColumns 2 -columnWidth2 160 160;\nbutton -label \"from\" -w 160 -c \"TAG2CopySkinWeightsList(0,0)\";\nbutton -label \"to\" -w 160 -c \"TAG2CopySkinWeightsList(1,0)\";\nsetParent ..;\nrowLayout -numberOfColumns 3 -columnWidth3 160 160 160;\ntextScrollList -w 160 -nr 15 -ams 0 copyListA;\ntextScrollList -w 160 -nr 15 -ams 0 copyListB;\nsetParent ..;\nrowLayout -numberOfColumns 1 -columnWidth1 322;\nbutton -label \"1.SmoothBind\" -w 322 -c \"TAG2SmoothBindApp\";\nsetParent ..;\nrowLayout -numberOfColumns 1 -columnWidth1 322;\nbutton -label \"2.AddInfluence\" -w 322 -c \"TAG2AddInfluenceApp\";\nsetParent ..;\nrowLayout -numberOfColumns 1 -columnWidth1 322;\nbutton -label \"3.CopySkinWeights\" -w 322 -c \"TAG2CopySkinWeightsApp\";\nsetParent ..;\n/*\nrowLayout -numberOfColumns 1 -columnWidth1 322;\nbutton -label \"4.RemoveUnusedInfluence\" -w 322 -c \"TAG2RemoveUnusedInfluenceApp\";\nsetParent ..;\n*/\nseparator -st \"in\" -h 8;\nrowLayout -numberOfColumns 1 -columnWidth1 322;\nbutton -label \"Run All\" -w 322 -c \"TAG2CopySkinWeightsAllApp\";\nsetParent ..;\nseparator -st \"in\" -h 8;\nrowLayout -numberOfColumns 1 -columnWidth1 322;\ntext -label \"After Run; skin > Edit Smooth Skin > Remove Unused skin\";\nsetParent ..;\n/*\nrowLayout -numberOfColumns 1 -columnWidth1 322;\ncolumnLayout;\ntext -label $progress progressText;\nsetParent ..;\nsetParent ..;\n*/\nsetParent ..;\nshowWindow;\n}\n\nglobal proc TAG2CopySkinWeightsList(int $num1,int $num2)\n{\nif ($num1 == 0)\n{\nstring $selObjA[] = `ls -sl`;\n/*\nstring $selDagA[];\n$selDagA = `ls -sl`;\n*/\ntextScrollList -e -ra copyListA;\nfor ($i=0; $i<size($selObjA); $i++)\n{\ntextScrollList -e -append $selObjA[$i] copyListA;\n}\n}\nif($num1 == 1)\n{\nstring $selDagB[] = `ls -sl`;\ntextScrollList -e -ra copyListB;\nfor($i=0; $i<size($selDagB); $i++)\n{\ntextScrollList -e -append $selDagB[$i] copyListB;\n}\n}\n}\n\nglobal proc TAG2CopySkinWeightsAllApp()\n{\nTAG2SmoothBindApp();\nTAG2AddInfluenceApp();\nTAG2CopySkinWeightsApp();\nTAG2RemoveUnusedInfluenceApp();\n}\n\nglobal proc TAG2SmoothBindApp()\n{\n//text -e -label \"SmoothBind...\" progressText;\n\nstring $texA[] = `textScrollList -q -ai copyListA`;\nstring $texB[] = `textScrollList -q -ai copyListB`;\nstring $weightedInf[];\nselect -cl;\n\nfor($i=0; $i<size($texA); $i++)\n{\n$weightedInf = `skinCluster -q -weightedInfluence $texA[$i]`;\nselect -add $weightedInf;\n}\nstring $infJoint[] = `ls -sl -type joint`;\nfor($i=0; $i<size($texB); $i++)\n{\nselect -r $infJoint;\nselect -add $texB[$i];\nskinCluster -toSelectedBones -removeUnusedInfluence false /*-skinMethod 0*/;\n}\n//text -e -label \"\" progressText;\n}\n\nglobal proc TAG2AddInfluenceApp ()\n{\n//text -e -label \"AddInfluence...\" progressText;\nstring $texA[] = `textScrollList -q -ai copyListA`;\nstring $texB[] = `textScrollList -q -ai copyListB`;\nstring $weightedInf[];\nselect -cl;\nfor($i=0; $i<size($texA); $i++)\n{\n$weightedInf = `skinCluster -q -weightedInfluence $texA[$i]`;\nselect -add $weightedInf;\n}\nstring $infJoint[] = `ls -sl -type joint`;\n\n//select -r $infJoint;\nselect -deselect $infJoint;\nstring $infTransform[] = `ls -sl`;\nfor($i=0; $i<size($texB); $i++)\n{\nfor ($j=0; $j<size($infTransform); $j++)\n{\nselect -r $texB[$i];\nskinCluster -e -dr 0 -ps 0 -ns 0 -ai $infTransform[$j];\n}\n}\n//text -e -label \"\" progressText;\n}\n\nglobal proc TAG2CopySkinWeightsApp()\n{\n//text -e -label \"CopySkinWeights...\" progressText;\nstring $texA[] = `textScrollList -q -ai copyListA`;\nstring $texB[] = `textScrollList -q -ai copyListB`;\nfor ($i=0; $i<size($texB); $i++)\n{\nselect -r $texA;\nselect -add $texB[$i];\ncopySkinWeights -noMirror -surfaceAssociation closestPoint\n-influenceAssociation closestJoint -influenceAssociation oneToOne;\n}\n//text -e -label \"\" progressText;\n}\n\n\nglobal proc TAG2RemoveUnusedInfluenceApp()\n{\n//text -e -label \"RemoveUnusedInfluence...\" progressText;\nstring $texA[] = `textScrollList -q -ai copyListA`;\nstring $texB[] = `textScrollList -q -ai copyListB`;\nstring $allInf[];\nstring $weightedInf[];\nstring $unusedInf[];\nstring $skinClst;\nselect -cl;\nfor($i=0; $i<size($texB); $i++)\n{\n$allInf = `skinCluster -q -influence $texB[$i]`;\n$weightedInf = `skinCluster -q -weightedInfluence $texB[$i]`;\nselect -r $allInf;\nselect -deselect $weightedInf;\nstring $selUnused[] = `ls -sl`;\nfor($j=0; $j<size($selUnused); $j++)\n{\n$skinClst = `findRelatedSkinCluster $texB[$i]`;\nskinCluster -e -ri $selUnused[$j] $skinClst;\n}\n}\n//text -e -label \"\" progressText;\n}\n\n" 
        -sourceType "mel" 
        -commandRepeatable 1
        -flat 1
