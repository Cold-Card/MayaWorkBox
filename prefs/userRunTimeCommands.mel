runTimeCommand
	-label ""
	-annotation ""
	-longAnnotation ""
	-category "Custom Scripts"
	-image ""
	-tags ""
	-keywords ""
	-plugin ""
	-helpUrl ""
	-hotkeyCtx ""
	-commandLanguage "python"
	-command ("import maya.cmds as cmds\nobjs = cmds.ls(sl=True)\nRestRTS_data = {'globalScale': 1, 'uniformScale': 1}\nfor obj in objs:\n    cmds.xform(obj,t=[0,0,0],ro=[0,0,0],s=[1,1,1])\n    for attr, value in RestRTS_data.items():\n        try:\n            cmds.setAttr(obj+'.'+attr, value)\n        except:\n            continue")
	RestRTS;

runTimeCommand
	-label ""
	-annotation ""
	-longAnnotation ""
	-category "Custom Scripts"
	-image ""
	-tags ""
	-keywords ""
	-plugin ""
	-helpUrl ""
	-hotkeyCtx ""
	-commandLanguage "python"
	-command ("import os\nimport sys\nWRL_SCRIPTS = os.path.normpath(os.environ.get(\"WRL_SCRIPTS\"))\nPATH = os.path.join(WRL_SCRIPTS, 'scripts/oneLiner-main/script/')\nif PATH not in sys.path:\n    sys.path.append(PATH)\nimport MainWindow\nif(sys.version_info.major>=3):\n    def reload(MODULE): \n        import importlib\n        importlib.reload(MODULE)\nreload(MainWindow)\n\nif __name__ == \"__main__\":\n    try:\n        olUI.close()\n        olUI.deleteLater()\n    except:\n        pass\n    olUI = MainWindow.oneLinerUI()\n    olUI.show()")
	oneLiner;
